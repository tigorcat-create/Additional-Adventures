# mod_public_WC_rab_btothel
if $ARGS[0] = 'Toha':
	$location_type = 'indoors'
	
	$metka = 'Toha'
	$loc = 'mod_public_WC_rab_btothel'
	$loc_arg = 'Toha'
	
	$menu_loc = 'mod_public_WC_rab_btothel'
	$menu_arg = 'Toha'
	
	menu_off = 0
	
	$locM = 'mod_public_WC_rab_btothel'
	$locM_arg = 'Toha'
	
	$PHloc = $loc
	$PHloc_arg = $loc_arg
	
	*clr & cla
	$func('wrap', 'header center b', 'Toha')
	'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/work/serving/TOHA.jpg"></center>'
	
	act 'go to other room':
		cla
		act'Go to the hotel': minut += 4 & gt 'mod_public_WC_rab_work_chystota', 'hotel'
		act'Go to the tables': minut += 1 & gt 'mod_public_WC_rab_btothel', 'tables'
		act'Go to billiard': minut += 5 & gt 'mod_public_WC_rab_btothel', 'billiard'
		act'Go to balcony': minut += 3 & gt 'mod_public_WC_rab_btothel', 'balcony'
		act'Go to office': minut += 8 & gt 'mod_public_WC_rab_btothel', 'office'
		act'Go to dancefloor': minut += 8 & gt 'mod_public_WC_rab_btothel', 'dancefloor'
	end
	gs 'mod_public_WC_rab_PHwork_events', 'start'
end



if $ARGS[0] = 'tables':
	$location_type = 'indoors'
	
	$metka = 'tables'
	$loc = 'mod_public_WC_rab_btothel'
	$loc_arg = 'tables'
	
	$menu_loc = 'mod_public_WC_rab_btothel'
	$menu_arg = 'tables'
	
	menu_off = 0
	
	$locM = 'mod_public_WC_rab_btothel'
	$locM_arg = 'tables'
	*clr & cla
	$func('wrap', 'header center b', '"Tables"')
	'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/work/serving/tables.jpg"></center>'
	if phwork = 7:
		gs 'mod_public_WC_rab_work_whore', 'actions'
	end

	act 'go to other room':
		cla	
		act'Go to the Toha': minut += 1 & gt 'mod_public_WC_rab_btothel', 'Toha'
		act'Go to the hotel': minut += 4 & gt 'mod_public_WC_rab_work_chystota', 'hotel'
		act'Go to billiard': minut += 5 & gt 'mod_public_WC_rab_btothel', 'billiard'
		act'Go to balcony': minut += 3 & gt 'mod_public_WC_rab_btothel', 'balcony'
		act'Go to office': minut += 8 & gt 'mod_public_WC_rab_btothel', 'office'
		act'Go to dancefloor': minut += 8 & gt 'mod_public_WC_rab_btothel', 'dancefloor'
	end
	gs 'mod_public_WC_rab_PHwork_events', 'start'
	
	
	
	if hour >= 10 and hour < 21:
		*clr & cla
		$func('wrap', 'header center b', 'Toha')
		'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/work/serving/TOHA.jpg"></center>'
		'Toha approached me'
		'Did you enjoy working so much? Your shift is over, you can go to the room '
		act 'Go to the room': gt 'mod_public_WC_rab_work', 'room'		
	end
end



