if $ARGS[0] = 'bc_setup':
	npctemp = 491
	npc_gender['A<<npctemp>>'] = 0	
	$npc_firstname['A<<npctemp>>'] = 'Boss'
	$npc_nickname['A<<npctemp>>'] = 'Big Black Cat'
	$npc_lastname['A<<npctemp>>'] = ' '
	$npc_usedname['A<<npctemp>>'] = 'Big Black Cat'
	$npc_notes['A<<npctemp>>'] = 'Black Cat gang leader'
	npc_intel['A<<npctemp>>'] = 100	
	npc_dob['A<<npctemp>>'] = 491
	npc_spermpot['A<<npctemp>>'] = 30000	
	npc_sexskill['A<<npctemp>>'] = 3
	gs 'npcstaticdefaults', 'defaults'
	gs 'npcstaticdefaults', 'body', 'actor'
	npc_gender['A<<npctemp>>'] = 0	
	$npc_thdick['A<<npctemp>>'] = 'massive'	
	npc_dick['A<<npctemp>>'] = 25
end


