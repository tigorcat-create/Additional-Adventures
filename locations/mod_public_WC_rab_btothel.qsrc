	end
	
	act 'go to other room':
		cla
		act'Go to the tables': minut += 5 & gt 'mod_public_WC_rab_btothel', 'tables'
		act'Go to balcony': minut += 8 & gt 'mod_public_WC_rab_btothel', 'balcony'
		act'Go to office': minut += 3 & gt 'mod_public_WC_rab_btothel', 'office'
		act'Go to dancefloor': minut += 8 & gt 'mod_public_WC_rab_btothel', 'dancefloor'
	end
	act 'wait': gs 'obj_din', 'wait'
	gs 'mod_public_WC_rab_PHwork_events', 'start'
end


