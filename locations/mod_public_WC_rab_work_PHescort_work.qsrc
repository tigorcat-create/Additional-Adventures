if $ARGS[0] = 'rank':
	PHN += 1

	'My old rank is <<phecrortrank1>>.<<phecrortrank2>>'

	if phshortescortfun/10 >= phecrortrank1:
		!++
		if phshortescortfun >= 100:
			rankupdate = 100 / PHN
		else
			rankupdate = phshortescortfun / PHN
		end

		if phecrortrank2 + rankupdate*10 >= 100:
			phecrortrank2 += rankupdate / 10
			if phecrortrank2 >= 100: phecrortrank2 -= 100
			phecrortrank1 += (phecrortrank2 + rankupdate*10)/100
			if phecrortrank1 >= 10: phecrortrank1 = 10

		else
			phecrortrank2 += rankupdate / 10
			if phecrortrank2 >= 100: phecrortrank2 -= 100 & phecrortrank1 += 1
			if phecrortrank1 >= 10: phecrortrank1 = 10
		end
	else
		!--
		rankupdate = (-1) * (phshortescortfun / PHN)

		phrankrank = phecrortrank1 *1000 + phecrortrank2

		phrankrank -= rankupdate *10

		phecrortrank1 = phrankrank /1000

		phecrortrank2 -= rankupdate / 10
		if phecrortrank2 < 0: phecrortrank2 = 0 & phecrortrank1 -= 1
		if phecrortrank1 < 0: phecrortrank1 = 0
	end

	If phecrortrank1 = 10: phecrortrank2 = 0

	killvar 'rankupdate'
	killvar 'phrankrank'

	'My new rank is <<phecrortrank1>>.<<phecrortrank2>>'
	!! gs 'mod_public_WC_rab_work_PHescort_work', 'rank'
end



