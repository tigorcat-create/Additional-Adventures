	'I am trying to dig up my hand and to dig up me'
	minut += 60
	gs 'stat'
	if phtemp <= 3: 'My hand is free'
	if phtemp <= 1: 'Almost Free'

	act 'keep trying': gt 'mod_public_WC_rab_SHIPOWNED', 'tiedsex3'

	if phtemp <= 0:
		cla
		'I am free!'
		'<center><img <<$set_imgh>> src="mod/public_WC/escort/2 place/2 yacht/yacht3/events/island/live/wait ('+rand(1,2)+').jpg"></center>'
		killvar 'phtemp'

		act 'continue': gt 'mod_public_WC_rab_SHIPOWNED', 'island'
	end
	phtemp -= 1
end



