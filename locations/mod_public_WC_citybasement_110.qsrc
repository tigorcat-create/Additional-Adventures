				killvar 'atemp'
				gt 'mod_public_WC_citybasement_bumsex', 'bomj2drink'
			end
		elseif ubomj2 >= eventtemp:
			gs 'mod_public_WC_citybasement_bumsex', 'bomj2'
		elseif ( eventtemp - urape) <= 15:
			'I hear footsteps…'
		elseif ( eventtemp - ubomj ) <= 15:
			'I hear footsteps…'
		elseif ( eventtemp - bomj2) <= 15:
