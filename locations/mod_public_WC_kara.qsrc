				gs 'willpower', 'pay', 'resist'
				gs 'stat'

				'You pissed me off'
				'They starts to beat me'

				gs 'pain', rand(1,3), 'back', 'hit'
				gs 'pain', rand(1,3), 'hips', 'hit'
				gs 'pain', rand(1,3), 'legL', 'kick'
				gs 'pain', rand(1,3), 'legR', 'kick'
				gs 'pain', rand(1,3), 'armL', 'hit'
				gs 'pain', rand(1,3), 'armR', 'hit'
				gs 'pain', rand(1,3), 'ribs', 'kick'
				gs 'pain', rand(1,3), 'tummy', 'hit'
				minut += rand(15,20)
				gs 'stat'


				act 'It is finally over': gt 'mod_public_WC_rab', 'dvir'
			end
		else
			act 'No!' + $func('willpower', 'get_willcost_string'): $noWillpower
		end
	else
		'I am ready to drink condoms'
		temp = rand(1,2)
		'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/kara/6/gotova<<temp>>.jpg"></center>'
		gandonpiyu = brak
		act 'Drink': gt 'mod_public_WC_kara', 'gandondrink'
	end
end

if $ARGS[0] = 'gandondrink':
	CLOSE ALL
	menu_off = 0
	$location_type = 'secluded'
	*clr & cla
	$loc = 'mod_public_WC_kara'
