		if gandonpiyu > 1:
			'<<gandonpiyu>> condoms left'
		else
			'<<gandonpiyu>> condom left'
		end

		if bimbolevel >= 2:
			pcs_mood += 40
			+$OpenInnerThought+'I like more the warm one, but it''s good enough'+$CloseInnerThought
		end
		pcs_mood -= 10
		spafinloc = 12
		gs 'cum_manage'
		stat['swallow'] += 1
		gs 'stat'
		pcs_health -= rand(0,30)
		pcs_health += rand(0,10)
