		gs 'arousal', 'end'
		gs 'stat'



		temp = rand(1,14)
		'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/kara/6/d<<temp>>.jpg"></center>'
		gs 'cum_call', 'mouth'
		gs 'arousal', 'end'
		gs 'stat'

		if trt_cumeater = 1:
			pcs_mood += 10
		else
			'The smell and taste are horrible, I can barely contain my vomiting'
			pcs_health -= rand(0,10)
			pcs_mood -= rand(1,3)
			if pcs_health <= 50:
				zaraz = 0
				'I can no longer drink'
				act 'Beg to stop it!':
					cla
					willpowermax -= rand(2,10)
					gs 'stat'
					temp = rand(1,2)
					if temp = 1:
						temp = rand(1,10)
						act 'Beg even more to stop it!':
							willpowermax -= rand(0,3)
							gs 'stat'
							zaraz += 1
							if zaraz = temp:
								*clr & cla
								'Tolik laughed, dipped my face into the contents of the condoms, kicked me and said "Free"'
								gs 'cum_call', 'face', 'unknown', 0, 1, -1, 150
								gs 'cum_call', 'hair', 'unknown', 0, 1, -1, 150
								gs 'pain', 2, 'chest', 'kick'
								gs 'stat'
								act 'Crawl out of here': gt 'mod_public_WC_rab', 'dvir'
							end
						end
					else
						'Tolik laughed, dipped my face into the contents of the condoms, kicked me and said "Free"'
						gs 'cum_call', 'face', 'unknown', 0, 1, -1, 150
						gs 'cum_call', 'hair', 'unknown', 0, 1, -1, 150
						gs 'pain', 2, 'chest', 'kick'
						gs 'stat'
						act 'Crawl out of here': gt 'mod_public_WC_rab', 'dvir'
					end

				end
			end
		end
		act 'Continue': gt 'mod_public_WC_kara', 'gandondrink'
	end
