							act 'Go away':
								otemp = 0
								gt $loc, $loc_arg
							end
						end
					end
				end
			end
		end
	elseif phpoolturn = 0:
		*clr & cla
		
		mestrip = rand(1,2)
		phpoolturn = 1
		phmydress = 3
		phrivaldress = 4
		if phttemp = 2: phrivaldress = 3
		
		hisava = rand(1,3)
		
		phpoolhit_rival = 50
		phpoolhit = 50
		
		phMyballs = 7
		phhisballs = 7
		
		phhisarounsed = 0
		if rand(1,3) = 1:
			PHpcs_pool_rival = rand(30,60)
		else
			PHpcs_pool_rival = rand(40,100)
		end
		
		gs 'mod_public_WC_rab_PHwork_events_7', 'phpoolinfo'
		cla
		'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/work/PH events/brothel/pool/play/start/0 ('+rand(1,2)+').jpg"></center>'
		
		if phttemp = 2:
			'"Show me what you got"'
			phmyturn = 1
		else
			'"Please, Ladies first"'
			phmyturn = 1
		end
		
		act 'nice, first hit is mine': gt 'mod_public_WC_rab_PH_pool_playme', 'playme'
	end
end

if npc_loyality >= 70 and npc_loyality < 1000: gt 'mod_public_WC_PH_blackcat_daily_4'


if $ARGS[0] = 'tablesituationdiff':
	if phpoolhit >= 110: $cc = '<font color = red	> ██████████ </font> '
	if phpoolhit >= 100 and phpoolhit < 110: $cc = '<font color = red	> ██████████ </font> '
	if phpoolhit >= 90 and phpoolhit < 100: $cc = '<font color = red	> █████████_ </font> '
	if phpoolhit >= 80 and phpoolhit < 90: $cc = $func('wrap', 'accent', ' ████████__ ') + ' '
	if phpoolhit >= 70 and phpoolhit < 80: $cc = $func('wrap', 'accent', ' ███████___ ') + ' '
	if phpoolhit >= 60 and phpoolhit < 70: $cc = $func('wrap', 'accent', ' ██████____ ') + ' '
	if phpoolhit >= 50 and phpoolhit < 60: $cc = $func('wrap', 'accent', ' █████_____ ') + ' '
	if phpoolhit >= 40 and phpoolhit < 50: $cc = $func('wrap', 'accent', ' ████______ ') + ' '
	if phpoolhit >= 30 and phpoolhit < 40: $cc = '<font color = green	> ███_______ </font> '
	if phpoolhit >= 20 and phpoolhit < 30: $cc = '<font color = green	> ██_________ </font> '
	if phpoolhit >= 10 and phpoolhit < 20: $cc = '<font color = green	> █__________ </font> '
	if phpoolhit < 10: $cc = '<font color = green	> ___________ </font> '
	*nl
	'<center>Curent table situation for me: <<$cc>></center>' 
	*nl	
	+$OpenInnerThought+'The harder situation for me, the harder make a good hit'+$CloseInnerThought
end

if $ARGS[0] = 'tablesituationdiff_rival':
	if phpoolhit_rival >= 110: $cc = '<font color = red	> ██████████ </font> '
	if phpoolhit_rival >= 100 and phpoolhit_rival < 110: $cc = '<font color = red	> ██████████ </font> '
	if phpoolhit_rival >= 90 and phpoolhit_rival < 100: $cc = '<font color = red	> █████████_ </font> '
	if phpoolhit_rival >= 80 and phpoolhit_rival < 90: $cc = $func('wrap', 'accent', ' ████████__ ') + ' '
	if phpoolhit_rival >= 70 and phpoolhit_rival < 80: $cc = $func('wrap', 'accent', ' ███████___ ') + ' '
	if phpoolhit_rival >= 60 and phpoolhit_rival < 70: $cc = $func('wrap', 'accent', ' ██████____ ') + ' '
	if phpoolhit_rival >= 50 and phpoolhit_rival < 60: $cc = $func('wrap', 'accent', ' █████_____ ') + ' '
	if phpoolhit_rival >= 40 and phpoolhit_rival < 50: $cc = $func('wrap', 'accent', ' ████______ ') + ' '
	if phpoolhit_rival >= 30 and phpoolhit_rival < 40: $cc = '<font color = green	> ███_______ </font> '
	if phpoolhit_rival >= 20 and phpoolhit_rival < 30: $cc = '<font color = green	> ██_________ </font> '
	if phpoolhit_rival >= 10 and phpoolhit_rival < 20: $cc = '<font color = green	> █__________ </font> '
	if phpoolhit_rival < 10: $cc = '<font color = green	> ___________ </font> '
	*nl
	'<center>Curent table situation for him: <<$cc>></center>'
	*nl	
	+$OpenInnerThought+'The harder situation for him, the harder make a good hit for him'+$CloseInnerThought
end

if $ARGS[0] = 'phpoolinfo':
	if phstrippool = 1:
		if phmydress = 3:
			minut += 2
			gs 'stat'
			'</center><br><table width="100%" cellspacing="0" cellpadding="5"><td width="200" valign="top"><img Height = 450 src="mod/public_WC/lisrab/work/PH events/brothel/pool/play/striptease/<<mestrip>>/<<phmydress>>.jpg"></td><td valign="top"><br>'
		elseif phmydress = 2:
			gs 'arousal', 'flashlite', 2, 'exhibitionism'
			gs 'stat'
			'</center><br><table width="100%" cellspacing="0" cellpadding="5"><td width="200" valign="top"><img Height = 450 src="mod/public_WC/lisrab/work/PH events/brothel/pool/play/striptease/<<mestrip>>/<<phmydress>>.jpg"></td><td valign="top"><br>'
		elseif phmydress = 1:
			'</center><br><table width="100%" cellspacing="0" cellpadding="5"><td width="200" valign="top"><img Height = 450 src="mod/public_WC/lisrab/work/PH events/brothel/pool/play/striptease/<<mestrip>>/<<phmydress>>.jpg"></td><td valign="top"><br>'
			gs 'arousal', 'flash', 2, 'exhibitionism'
			gs 'stat'
		elseif phmydress = 0:
			'</center><br><table width="100%" cellspacing="0" cellpadding="5"><td width="200" valign="top"><img Height = 450 src="mod/public_WC/lisrab/work/PH events/brothel/pool/play/striptease/<<mestrip>>/<<phmydress>>.jpg"></td><td valign="top"><br>'
			gs 'arousal', 'flash', 2, 'exhibitionism'
			gs 'stat'
		end
		
		if phttemp = 2:
			if phrivaldress = 3:
				'She is wearing: shirt, bra, panties.'
			elseif phrivaldress = 2:
				'She is wearing: bra, panties.'
			elseif phrivaldress = 1:
				'She is wearing: panties.'
				gs 'arousal', 'voyeur', 3, 'exhibitionism'
				minut -= 3
				gs 'stat'
			elseif phrivaldress = 0:
				'She is wearing: nothing.'
				gs 'arousal', 'voyeur', 3, 'exhibitionism'
				minut -= 3
				gs 'stat'
			end
		else
			if phrivaldress = 4:
				'He is wearing: shirt, jeans, socks, underpants.'
			elseif phrivaldress = 3:
				'He is wearing: jeans, socks, underpants.'
			elseif phrivaldress = 2:
				'He is wearing: jeans, underpants.'
			elseif phrivaldress = 1:
				'He is wearing: underpants.'
			elseif phrivaldress = 0:
				'He is wearing: nothing.'
				gs 'arousal', 'voyeur', 3, 'exhibitionism'
				minut -= 3
				gs 'stat'
			end
		end
	end

	if phbet > 0:
		'<b>Game bet is <<phbet>> ₽</b>'
	end
	
	
	*nl
	if phMyballs > 0:
		'There are <<phMyballs>> my balls left on the table'	
		gs 'mod_public_WC_rab_PHwork_events_7', 'tablesituationdiff'
	else
		'I need to pocket the 8 ball only'
		gs 'mod_public_WC_rab_PHwork_events_7', 'tablesituationdiff'
	end
	
	*nl
	if phhisballs > 0:
		'There are <<phhisballs>> his balls left on the table'
		gs 'mod_public_WC_rab_PHwork_events_7', 'tablesituationdiff_rival'
	else
		'Opponent need to pocket the 8 ball only'
		gs 'mod_public_WC_rab_PHwork_events_7', 'tablesituationdiff_rival'
	end
end
