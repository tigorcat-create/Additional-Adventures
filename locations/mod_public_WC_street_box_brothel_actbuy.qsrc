				'<center><img <<$set_imgh>> src="<<$phgirlava[i]>>.jpg"></center>'
				karta -= temp_price[temp]
				
				act 'exit ': gt 'mod_public_WC_street_box', 'start'
				
				'<<$phgirlname[i]>>'
