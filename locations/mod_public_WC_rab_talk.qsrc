			end
		end
	end
	if pcs_humint <= 80 or pcs_intel <= 90:
		act 'ask: You need something?':
			slova -= 3
			if slova < 0:
				gt 'mod_public_WC_kara', '0sliv'
			else
				gt 'mod_public_WC_rab_talk', 'Tolik_task'
			end
		end
	end
	if pcs_humint > 80 or pcs_intel > 90:
		act 'ask: What to do?':
			slova -= 2
			if slova < 0:
				gt 'mod_public_WC_kara', '0sliv'
			else
				gt 'mod_public_WC_rab_talk', 'Tolik_task'
			end
		end
	end
	if pcs_inhib >= 40:
		act 'tease Tolik':
			minut += 3
			gs 'exp_gain', 'inhib', rand(0,1)
			gs 'flash', 'exhibitionism', 1
			gs 'stat'
			'<center><video autoplay loop <<$set_imgh>> src="mod/public_WC/lisrab/alove/tease/tease1.mp4"></video></center>'
			'"Cover up, women! You aren''t whore!", Tolik slaps me.'
			mood -= rand(5,10)
			brak += 1
			gs 'pain', 1, 'cheeks', 'slap'
		end
	end
	if week < 6:
		act 'Can I go home?':
			cla
			slova -= 2
			if slova < 0:
				gt 'mod_public_WC_kara', '0sliv'
			end

			if pregChem > 0:
				Tolik_know_preg = 1
				tkid = kid
				If brak <= 20:
					'I see you are pregnant from some of us, and it''s make me happy. Now you need some rest and see your family…'
					'Vania will give you a collar as a reminder of us and you can go.'
					'But you MUST be here each weekend. And you better listen to me.'

					if knowpreg = 0:
						+$OpenInnerThought+'I am pregnant?! OMG!!! and the father is some of this… this… guys.'+$CloseInnerThought
						thinkpreg = 1
						knowpreg = 1
						unrelated_preg = 1
					end

					act 'I''ll stay':
						cla
						slova -= 1
						if slova < 0:
							gt 'mod_public_WC_kara', '0sliv'
						end
						'Good, Betsi. It''s good for you to be here.'
						vlada += rand(1,2)
						act 'Leave': gt $loc, $loc_arg
					end
					act 'I''ll go but come back on the weekend':
						cla
						slova -= 4
						if slova < 0:
							gt 'mod_public_WC_kara', '0sliv'
						end

						'"Well, ok" - he write some symbols on the paper "алатс юокмам" and give it to me'
						'"Give this to Vania"'
						moju_yty = 1
						act 'Leave': gt $loc, $loc_arg
					end
				else
					'You are doing everything wrong!'
					'We will think about it only if you start to listen!'
					+$OpenInnerThought+'(I need the relationship more then 20 (my current relationship is <<vlada>>))'+$CloseInnerThought
					act 'Leave': gt $loc, $loc_arg
				end
			elseif vlada >= 30 and brak < 10:
				'Tolik: "You are very obitient. I trust you."'
				'Vania will give you a collar as a reminder of us and you can go.'
				'But you MUST be here each weekend. And you better listen to me.'
				act 'I''ll stay':
					cla
					slova -= 1
					if slova < 0:
						gt 'mod_public_WC_kara', '0sliv'
					end
					'Good, Betsi. It''s good for you to be here.'
					vlada += rand(1,2)
					act 'Leave': gt $loc, $loc_arg
				end
				act 'I''ll go but come back on the weekend':
					cla
					slova -= 4
					if slova < 0:
						gt 'mod_public_WC_kara', '0sliv'
					end

					'Tolik: "Well, ok" - he write some symbols on the paper "АКУС АШАН" and give it to me'
					'Tolik: "Give this to Vania"'
					moju_yty = 1
					phobidient = 1
					act 'Leave': gt $loc, $loc_arg
				end
			else
				'Only if Vania agree… hmmm… or if you become pregnant.'
				*nl
				+$OpenInnerThought+'Or I have 50%+ relationship ith them and less than 10% conflict'+$CloseInnerThought
				act 'Leave': gt $loc, $loc_arg
			end
		end
	else
		act 'Can I go home?':
			cla
			slova -= 2
			if slova < 0:
				gt 'mod_public_WC_kara', '0sliv'
			end
			'"Don''t ask me such questions on a weekend!"'
			'"Go away."'
			act 'Leave': gt $loc, $loc_arg
		end
	end
end

