		end
		pr = 103
		urape += 0 & ubomj += 10 & ubomj2 =0 & gt 'mod_public_WC_citybasement', '102'
	end

	act 'wait 15 minutes':
		minut += 15
		gs 'stat'
		urape =0 & ubomj += 0 & ubomj2 = 0 & gt 'mod_public_WC_citybasement', '103'
	end

	act 'rummage in the boxes':
		cla
		observ_exp += 3
		minut += 15
		gs 'sweat', 'add', 10
		gs 'stat'
		temp = rand (1,100) + ( pcs_observ / 2 )
		ztemp = 0
		if temp >= 80 and ztemp ! 1 and maddildo ! 1:
			ztemp = 1
			mood += 3
			maddildo = 1
			'YES! I found a 40cm long dildo'
		end
		if temp >= 110 and gun = 0 and ztemp ! 1:
			ztemp = 1
