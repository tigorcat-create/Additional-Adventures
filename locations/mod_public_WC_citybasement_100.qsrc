					'Good deal, see you next time, in a week or something'
					koliaday = daystart + rand(5,10)
					bum_kolia += 1

					act 'go out': pr = 103 & urape += 0 & ubomj += 10 & ubomj2 =0 & gt 'mod_public_WC_citybasement', '102'
				end
			end

			act 'ask other': gt 'mod_public_WC_citybasement_100', 'kolia'

			act 'go out': pr = 103 & urape += 0 & ubomj += 10 & ubomj2 =0 & gt 'mod_public_WC_citybasement', '102'
		end

		act 'I need a fake driving license':
			cla
			minut += 5
			gs 'stat'
			'"well I can''t do that."'
			'"I am also riding that roads!"'
			'"And I want to live!"'

			act 'go out': pr = 103 & urape += 0 & ubomj += 10 & ubomj2 =0 & gt 'mod_public_WC_citybasement', '102'
			act 'ask other': gt 'mod_public_WC_citybasement_100', 'kolia'
		end


		'Інша підтримка? -=wip=-'
		'знайти компромат'


	else
		'Ow, wait.'
		'No, no, no… I don''t work like that. You are not my only client.'
		temp = koliaday - daystart
		if rand(1,2) = 1:
			temp = temp - rand(1,3)
			if temp <= 0: temp = 1
		else
			temp = temp + rand(1,2)
		end

		'Please come back in <<temp>> days.'
	end

	act 'go out': pr = 103 & urape += 0 & ubomj += 10 & ubomj2 =0 & gt 'mod_public_WC_citybasement', '102'
end



if $ARGS[0] = '104':
	*clr & cla
	CLOSE ALL
	menu_off = 0
	if sound_settings['environment_off'] = 0: PLAY 'mod/public_WC/sound/walk.wav',60
	minut += rand(0,3)
	$loc_arg = '104'
	$loc = 'mod_public_WC_citybasement_100'
	$menu_loc = 'mod_public_WC_citybasement'
	$menu_arg = '104'
	zt = 104
	gs 'stat'
	$func('wrap', 'header center b', 'Undercity tunnels')
	'<center><img <<$set_imgh>> src="mod/public_WC/wc/events/90/101gopotamista/pidval/pidzem/p7.jpg"></center>'
	temp = rand(1,5)
	if temp = 1:
		'It''s dark here'
	elseif temp = 2:
		'I am scared a little'
	elseif temp = 3:
		'I really don''t know this tunnels so long!'
	elseif temp = 4:
		'There must be many exits from the tunnel'
	elseif temp = 5:
		'Have this tunnels been used during the War?'
	end


	if pr = 102:
		if vhid1 >= 1: 'to exit in the center go further'
		if vhid2 >= 1: 'to exit in the industrial go further'
		if vhid3 >= 1: 'to exit in the red light go further'
		if vhid4 >= 1: 'to resident exit go back'
		if vhid5 >= 1: 'to exit in the park go further'
		act 'go further': pr = 104 & urape += 18 & ubomj += 15 & ubomj2 =0 & gt 'mod_public_WC_citybasement', '105'
		act 'go back': pr = 104 & urape += 0 & ubomj += 10 & ubomj2 =0 & gt 'mod_public_WC_citybasement', '102'
	elseif pr = 105:
		if vhid1 >= 1: 'to exit in the center go back'
		if vhid2 >= 1: 'to exit in the industrial go back'
		if vhid3 >= 1: 'to exit in the red light go back'
		if vhid4 >= 1: 'to resident exit go further'
		if vhid5 >= 1: 'to exit in the park go back'
		act 'go further': pr = 104 & urape += 0 & ubomj += 10 & ubomj2 =0 & gt 'mod_public_WC_citybasement', '102'
		act 'go back': pr = 104 & urape += 18 & ubomj += 15 & ubomj2 =0 & gt 'mod_public_WC_citybasement', '105'
	end

	urape += 15
	ubomj += 15
	ubomj2 = 0

	if bumevent = 0:

		eventtemp = rand (1,300)
		if hour >= 5 and hour <= 21:
			urape += 10
		end
		if hour >= 5 and hour <= 21:
			ubomj -= 10
		end
		if hour < 5 or hour > 21:
			ubomj2 += 10
		end
		ubomj2 -= bumfriend


		if eventtemp >= 290:
			gs 'mod_public_WC_citybasement_bumsex', 'body'
		elseif eventtemp >= 270:
			gs 'mod_public_WC_citybasement_bumsex', 'bag'
		elseif urape >= eventtemp:
			gs 'mod_public_WC_citybasement_bumsex', 'rape'
		elseif ubomj >= eventtemp:
			gs 'mod_public_WC_citybasement_bumsex', 'bomj'
		elseif bumfriend >= rand(15,30):
			bumevent = 1
			ubomj2 = rand(1,4)
			tabir = rand(1,4)
			'I see familiar bums here'
			'some of them even say "hi" to me'
			act 'ask to drink with them':
				atemp = 0
				tabir = rand(1,4)
				'<center><img <<$set_imgh>> src="mod/public_WC/wc/events/90/101gopotamista/pidval/bomji/tabir (<<tabir>>).jpg"></center>'
				killvar 'atemp'
				gt 'mod_public_WC_citybasement_bumsex', 'bomj2drink'
			end
		elseif ubomj2 >= eventtemp:
			gs 'mod_public_WC_citybasement_bumsex', 'bomj2'
		elseif ( eventtemp - urape) <= 15:
			'I hear footsteps…'
		elseif ( eventtemp - ubomj ) <= 15:
			'I hear footsteps…'
		elseif ( eventtemp - bomj2) <= 15:
			'I hear footsteps…'
		else
			' '
		end
	elseif bumevent = 2:
		bumevent = 0
		*nl
		'There are bums here.'
		act 'drink with the bums':
			bumevent = 1
			gt 'mod_public_WC_citybasement_bumsex', 'bomj2drink'
		end
	end
	if bumevent >= 10:
		bumevent = 0
		gs 'stat'
	elseif 	bumevent = 1:
		bumevent += 10
		gs 'stat'
	end
end

