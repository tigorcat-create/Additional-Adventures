# mod_public_WC_citybasement_100

if $ARGS[0] = '101':
	gt 'mod_public_WC_citybasement_100_1', '101'
end

if $ARGS[0] = '102':
	*clr & cla
	CLOSE ALL
	menu_off = 0
	if sound_settings['environment_off'] = 0: PLAY 'mod/public_WC/sound/walk.wav',60
	$loc_arg = '102'
	$loc = 'mod_public_WC_citybasement_100'
	zt = 102
	atemp = 0
	$menu_loc = 'mod_public_WC_citybasement'
	$menu_arg = '102'
	minut += rand(0,3)
	gs 'stat'
	$func('wrap', 'header center b', 'fork in the tunnel')
	'<center><img <<$set_imgh>> src="mod/public_WC/wc/events/90/101gopotamista/pidval/pidzem/p23.jpg"></center>'
	act'Go to "КОЛЯ" way':
		pr = 102
		urape = 0 & ubomj += 0 & ubomj2 = 0 & gt 'mod_public_WC_citybasement', '103'
	end
	if pr = 101:
		if vhid1 >= 1: 'to exit in the center go further'
		if vhid2 >= 1: 'to exit in the industrial go further'
		if vhid3 >= 1: 'to exit in the red light go further'
		if vhid4 >= 1: 'to resident exit go back'
		if vhid5 >= 1: 'to exit in the park go further'
		act 'go further': pr = 102 & urape += 15 & ubomj += 15 & ubomj2 =0 & gt 'mod_public_WC_citybasement', '104'
		act 'go back': pr = 102 & urape += -50 & ubomj += 15 & ubomj2 =120 & gt 'mod_public_WC_citybasement', '101'
	elseif pr = 103:
		if vhid1 >= 1: 'to exit in the center go left'
		if vhid2 >= 1: 'to exit in the industrial go left'
		if vhid3 >= 1: 'to exit in the red light go left'
		if vhid4 >= 1: 'to resident exit go right'
		if vhid5 >= 1: 'to exit in the park go left'
		act 'go left': pr = 102 & urape += 15 & ubomj += 15 & ubomj2 =0 & gt 'mod_public_WC_citybasement', '104'
		act 'go right': pr = 102 & urape += -50 & ubomj += 15 & ubomj2 =120 & gt 'mod_public_WC_citybasement', '101'
	elseif pr = 104:
		if vhid1 >= 1: 'to exit in the center go back'
		if vhid2 >= 1: 'to exit in the industrial go back'
		if vhid3 >= 1: 'to exit in the red light go back'
		if vhid4 >= 1: 'to resident exit go further'
		if vhid5 >= 1: 'to exit in the park go back'
		act 'go further': pr = 102 & urape += -50 & ubomj += 15 & ubomj2 =120 & gt 'mod_public_WC_citybasement', '101'
		act 'go back': pr = 102 & urape += 15 & ubomj += 15 & ubomj2 =0 & gt 'mod_public_WC_citybasement', '104'
	end

	urape += 0
	ubomj += 10
	ubomj2 = 0

	if bumevent = 0:
		eventtemp = rand (1,300)
		if hour >= 5 and hour <= 21:
			urape += 10
		end
		if hour >= 5 and hour <= 21:
			ubomj -= 10
		end
		if hour < 5 or hour > 21:
			ubomj2 += 10
		end
		ubomj2 -= bumfriend


		if eventtemp >= 290:
			gs 'mod_public_WC_citybasement_bumsex', 'body'
		elseif eventtemp >= 270:
			gs 'mod_public_WC_citybasement_bumsex', 'bag'
		elseif urape >= eventtemp:
			gs 'mod_public_WC_citybasement_bumsex', 'rape'
		elseif ubomj >= eventtemp:
			gs 'mod_public_WC_citybasement_bumsex', 'bomj'
		elseif bumfriend >= rand(15,30):
			bumevent = 1
			ubomj2 = rand(1,4)
			tabir = rand(1,4)
			'I see familiar bums here'
			'some of them even say "hi" to me'
			act 'ask to drink with them':
				atemp = 0
				tabir = rand(1,4)
				'<center><img <<$set_imgh>> src="mod/public_WC/wc/events/90/101gopotamista/pidval/bomji/tabir (<<tabir>>).jpg"></center>'
				killvar 'atemp'
				gt 'mod_public_WC_citybasement_bumsex', 'bomj2drink'
			end
		elseif ubomj2 >= eventtemp:
			gs 'mod_public_WC_citybasement_bumsex', 'bomj2'
		elseif ( eventtemp - urape) <= 15:
			'I hear footsteps…'
		elseif ( eventtemp - ubomj ) <= 15:
			'I hear footsteps…'
		elseif ( eventtemp - bomj2) <= 15:
			'I hear footsteps…'
		else
			' '
		end
	elseif bumevent = 2:
		bumevent = 0
		*nl
		'There are bums here.'
		act 'drink with the bums':
			bumevent = 1
			gt 'mod_public_WC_citybasement_bumsex', 'bomj2drink'
		end
	end
	if bumevent >= 10:
		bumevent = 0
		gs 'stat'
	elseif 	bumevent = 1:
		bumevent += 10
		gs 'stat'
	end
end

if $ARGS[0] = '103':
	*clr & cla
	CLOSE ALL
