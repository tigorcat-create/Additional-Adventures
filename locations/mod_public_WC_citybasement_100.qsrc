			'<center><video autoplay loop <<$set_imgh>> src="mod/public_WC/lisrab/r_events/11/gun_found.mp4"></video></center>'
			gun = 1
		end
		if temp >= 100 and ztemp ! 1:
			ztemp = 1
			mood += 2
			temp = rand(1,2)
			if temp = 1:
				temp = rand (1,100) + ( pcs_observ / 2 )
				money += temp
				'I found <<temp>> money!'
			else
				ammo += rand(1,3)
				'I found some ammo money!'
			end
		end
		if temp >= 70 and ztemp ! 1:
			minut += rand(10,20)
			ztemp = 1
			'I found some mushrooms,'
			boletus += 2
		end
		if temp >= 80 and ztemp ! 1:
			minut += rand(10,20)
			ztemp = 1
			'I found cigarets,'
			mc_inventory['cigarettes'] += rand(1,5)
		end
		if ztemp ! 1:
			'I have found nothing. Are there anything here?}'
		end
		act 'Continue': atemp = 1 & urape = 0 & ubomj += 0 & ubomj2 = 0 & gt 'mod_public_WC_citybasement', '103'
	end

	if rand (1,4) = 1:
		*clr & cla
		if bum_kolia = 1000: urape = 0 & ubomj += 0 & ubomj2 = 0 & gt 'mod_public_WC_citybasement', '103'
		if bum_kolia = 2000: urape = 0 & ubomj += 0 & ubomj2 = 0 & gt 'mod_public_WC_citybasement', '103'
		if atemp ! 1:
			'<center><video width="<<WCvideoweight>>" autoplay loop src="mod/public_WC/wc/events/90/101gopotamista/pidval/bomji/kolia_drink.mp4"></video></center>'
