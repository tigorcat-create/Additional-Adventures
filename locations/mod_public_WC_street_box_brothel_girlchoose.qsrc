			end
			phwhores_hour[i] = hour + rand(1,2)
			phwhores_day[i] = daystart
			
			if phwhores_hour[i] >= 24: 
				phwhores_day[i] = daystart + 1
				phwhores_hour[i] -= 24
			end
			
			ph_bussygirls += 1
