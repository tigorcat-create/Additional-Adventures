# mod_public_WC_street_box_brothel_girlchoose
if $ARGS[0] = 'moneyfirst2':
	'I recomend him a girl'		
	
	if ph_Iammaownwhore = 0:
		i = 2
	else
		i = 1
	end
	
	ztemp = 0
	
	:loopgirlfindsernw		
	
	if phwhores[i] = 0:		
		if i = 1:
			'<center><img Height = 200 src="<<func(''$face_image'')>>"></center>'
		else
			'<center><img Height = 200 src="<<$phgirlava[i]>>.jpg"></center>'
		end
		'<<$phgirlname[i]>>'				
		*nl
		if phsex = 1 or phsex = 101: 'Hand job stat = <<phgirlstatHJ[i]>>'
		if phsex = 2 or phsex = 102: 'Blow job stat = <<phgirlstatBJ[i]>>'
		!! 'Footjob job stat = <<phgirlstatFJ[i]>>'
		if phsex = 3 or phsex = 103: 'Vaginal stat = <<phgirlstatVAG[i]>>'
		if phsex = 4 or phsex = 104: 'Anal stat = <<phgirlstatASS[i]>>'
		'______________________________________________________________________________'
		*nl
		*nl			
		
		ztemp += 1
		ztempmax = ztemp
		
		
		temp = girlid[i]
		if ztemp = 1:
			ztemp[1] = temp
		elseif ztemp = 2:
			ztemp[2] = temp
		elseif ztemp = 3:
			ztemp[3] = temp
		elseif ztemp = 4:
			ztemp[4] = temp
		elseif ztemp = 5:
			ztemp[5] = temp
		elseif ztemp = 6:
			ztemp[6] = temp
		elseif ztemp = 7:
			ztemp[7] = temp
		elseif ztemp = 8:
			ztemp[8] = temp
		elseif ztemp = 9:
			ztemp[9] = temp
		elseif ztemp = 10:
			ztemp[10] = temp
		elseif ztemp = 11:
			ztemp[11] = temp
		elseif ztemp = 12:
			ztemp[12] = temp
		elseif ztemp = 13:
			ztemp[13] = temp
		elseif ztemp = 14:
			ztemp[14] = temp
		elseif ztemp = 15:
			ztemp[15] = temp
		elseif ztemp = 16:
			ztemp[16] = temp
		elseif ztemp = 17:
			ztemp[17] = temp
		elseif ztemp = 18:
			ztemp[18] = temp
		elseif ztemp = 19:
			ztemp[19] = temp
		elseif ztemp = 20:
			ztemp[20] = temp
		end
	end
	
	i += 1
	
	if i <= phwhores: 
		jump 'loopgirlfindsernw'
	end
	
	act 'continue':
		cla				
		gs 'mod_public_WC_street_box_brothel_girlchoose', 'choosegirlaction'
	end
end



