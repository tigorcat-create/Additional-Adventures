		'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/Vania/trener/velyk/ride ('+rand(1,2)+').jpg"></center>'
	else
		'<center><video autoplay loop <<$set_imgh>> src="mod/public_WC/lisrab/Vania/trener/velyk/ridev ('+rand(1,6)+').mp4"></video></center>'
	end

	act '<b>stick to the road</b> (east)': coord_x += 1 & gt 'mod_public_WC_rab_Mayster7', 'ride'
	act 'go left (north) to the field':  coord_y += 1 & gt 'mod_public_WC_rab_Mayster7', 'ride'
	act 'go right (south) to the forest': coord_y -= 1 & gt 'mod_public_WC_rab_Mayster7', 'ride'
end

