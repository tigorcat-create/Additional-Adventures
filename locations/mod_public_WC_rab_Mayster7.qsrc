if $ARGS[0] = 'start':
	menu_off = 0
	$location_type = 'secluded'
	*clr & cla
	dick = 17
	npc_dick[$npclastgenerated] = dick
	gs 'boyStat', 'A442'
	gs 'stat'
	'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/vania/vania.jpg"></center>'

	'I come with Vania to the Barn where the exercise bike stands…'

	'"Before we will go to the big world, you need to train on this bad boy…"'
	'Vania fixed the dildo to the bike…'
	'"Come on, Betsi, ride it!"'

	act 'No!':
		*clr & cla
		willpowermax += 1
		VaniaMayster -= 3
		gs 'stat'
		'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/vania/vania.jpg"></center>'
		'I tierd of this shit, Betsi.'
		act 'continue': gt 'mod_public_WC_rab_Mayster5', 'kara'
	end

	if VaniaMayster >= 100:
		cla
		'<i>I obey Vania for so long…</i>'
		'<i>I can''t say "no" to Vania anymore</i>'
	end

	act 'ride the bike':
		*clr & cla
		'This ride is amazing!'
		VaniaMayster += 1
		'<center><video autoplay loop <<$set_imgh>> src="mod/public_WC/lisrab/Vania/trener/velyk/trainride ('+rand(1,4)+').mp4"></video></center>'
		gs 'arousal', 'vaginal_dildo_give', rand(40,70), 'humiliation', 'sub'
		gs 'stat'


		run_exp += rand(0,2)
		stren_exp += rand(0,2)
		fat -= 2
		pcs_mood += 10
		pcs_sweat += 2
		gs 'stat'


		vbike -= rand(10,15)
		if vbike < 1: vbike = 1


		'in about a hour Vania stops me'
		'"Ok Betsi, few more trains and we will ride outside"'

		pcs_mood += rand(0,20)
		gs 'stat'
		ztemp = rand (1,4)
		if ztemp = 3: ztemp = 4
		act 'wait': gt 'mod_public_WC_rab_Mayster', 'end'

		act 'Please master, can I ride more!':
			*clr & cla
			VaniaMayster += 1
			willpowermax -= 1
			'"Of course, Betsi, I like the spirit"'
			'<center><video autoplay loop <<$set_imgh>> src="mod/public_WC/lisrab/Vania/trener/velyk/trainride ('+rand(1,4)+').mp4"></video></center>'
			gs 'arousal', 'vaginal_dildo_give', rand(40,70), 'humiliation', 'sub'
			gs 'stat'


			run_exp += rand(0,2)
			stren_exp += rand(0,2)
			fat -= 2
			pcs_mood += 10
			pcs_sweat += 2
			gs 'stat'


			vbike -= rand(10,15)
			if vbike < 1: vbike = 1


			'in about a hour Vania stops me'
			'"Ok Betsi, few more trains and we will ride outside"'

			pcs_mood += rand(0,20)
			gs 'stat'
			ztemp = rand (1,4)
			if ztemp = 3: ztemp = 4
			act 'wait': gt 'mod_public_WC_rab_Mayster', 'end'
		end
	end

	if vbike = 1:
		*clr & cla
		'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/vania/vania.jpg"></center>'

		'I come with Vania to the Barn where the casual bike stands…'

		'"Today you will go to the big world!.."'

		vbike = 200

		if zashmorg = 2:
			'Vania locks the collar with a lock'
			'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/Vania/items/zashmorg.jpg"></center>'
			zashmorg = 3
		elseif zashmorg = 1:
			'Vania locks the collar around me'
			'<center><video autoplay loop <<$set_imgh>> src="mod/public_WC/lisrab/Vania/trener/bdsm/povidok/start (1).mp4"></video></center>'
			zashmorg = 3
		end

		'"Remember Betsi, I trust my pet… don''t disappoint me"'


		'"You can ride anywhere you want… cuz we can find you anywhere))"'
		'"But you need to come back to the meet with Tolik on time."'


		'Vania fixed the dildo to the bike…'
		'"Come on, Betsi, ride it!"'

		if month > 4 and month < 10:
			''
			'You can go swim if you turn left on the second turn left.'
		else
			'You better dress a coat, it''s cold outside'
		end
		'The forest is dangerous place, avoid it.'




		act 'Go ride!':
			onvelyk = 1
			gt 'mod_public_WC_rab_Mayster7', 'ridestart'
		end
	end
end



