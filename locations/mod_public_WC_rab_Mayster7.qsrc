			'<center><img <<$set_imgh>> src="images/locations/gadukino/river/gadriver_winter.jpg"></center>'
		else
			'<center><img <<$set_imgh>> src="images/locations/gadukino/river/gadriver_winter_night.jpg"></center>'
		end
	end


	'You caught <<ryba>> fish.'
	'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/Vania/trener/velyk/event/rybalka/sitka.jpg"></center>'

	act 'Throw the bait':
		*clr & cla
		minut += rand(5,10)
		if hour < 12:
			temp_gr = rand(5,20)
		elseif hour >= 12 and hour < 18:
			temp_gr = rand(0,20)
		else
			temp_gr = rand(10,20)
		end
		gs 'stat'

		if $clothingworntype ! 'nude':
			'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/Vania/trener/velyk/event/rybalka/fishing ('+rand(1,3)+').jpg"></center>'
		else
			'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/Vania/trener/velyk/event/rybalka/fishing_naked ('+rand(1,2)+').jpg"></center>'
		end


		'I throw out the lure and carefully watch the bobber for signs of nibble.'

		if temp_gr > rand(15,19):
			cla
			*clr
			minut += 1
			gs 'stat'

			'<center><img <<$set_imgh>> src="images/locations/gadukino/river/nofishingriver.jpg"></center>'
			'Suddenly the bobber dives under the water dramatically. <b>I got one!</b>'

			act 'Pull':
				cla
				*clr
				minut += 1
				temp_gr = rand(0,120)
				if temp_gr < 50: react_exp += 1
				gs 'stat'

				if pcs_react > temp_gr:
					pcs_mood += rand(5,10)
					minut += 1
					react_exp += 1
					ryba += 1
					gs 'stat'

					'I skillfully strike, pulling the rod up sharply. I feel the rod straining slightly, and after a few moments, <b>I excitedly pull a fish out of the water.</b>'

					if $clothingworntype ! 'nude':
						'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/Vania/trener/velyk/event/rybalka/catch ('+rand(1,3)+').jpg"></center>'
					else
						'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/Vania/trener/velyk/event/rybalka/catch_naked ('+rand(1,5)+').jpg"></center>'
					end
				else
					pcs_mood -= rand(5,10)
					minut += 1
					gs 'stat'
					'<center><img <<$set_imgh>> src="images/locations/gadukino/river/gadriver.jpg"></center>'
					'I strike, but the lack of tension makes the <b>fish escape from the hook</b>.'

				end
				act 'continue': gt 'mod_public_WC_rab_Mayster7', 'rybalka'
			end
		else
			'The bobber remains perfectly still, eventually I decide to try a different lure.'
			act 'Retrieve bait': gt 'mod_public_WC_rab_Mayster7', 'rybalka'
		end
	end
	act 'Finish': gt $loc, $loc_arg
end



if $ARGS[0] = 'end':
	cla
	'I see the house in the forest'
	'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/HATA/dim.jpg"></center>'
	if month > 4 and month < 10:
		if hour >= 6 and hour <= 21:
			'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/Vania/trener/velyk/road_ride/pole/l_road_d.jpg"></center>'
		else
			'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/Vania/trener/velyk/road_ride/pole/l_road_n.jpg"></center>'
		end
	else
		if hour >= 8 and hour <= 17:
			'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/Vania/trener/velyk/road_ride/pole/z_road_d.jpg"></center>'
		else
			'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/Vania/trener/velyk/road_ride/pole/z_road_n.jpg"></center>'
		end
	end
	act 'Ride home': gt 'mod_public_WC_rab_Mayster7', 'home'
	act 'Ride more, <b>stick to the road</b> (east)': coord_x += 1 & gt 'mod_public_WC_rab_Mayster7', 'ride'
	act 'Ride more, go to the field (north)': coord_y += 1 & gt 'mod_public_WC_rab_Mayster7', 'ride'
	act 'Ride more, go to the forest (south)': coord_y -= 1 & gt 'mod_public_WC_rab_Mayster7', 'ride'
end

if $ARGS[0] = 'home':
	Vurok += 1
	if (hour >= 22 and zvit = week and poshuk > 0) or (zvit + 1 = week and poshuk > 0) or (zvit - 6 = week and poshuk > 0):
		*clr & cla
		'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/vania/vania.jpg"></center>'
		'Vania met me.'
		if onvelyk = 0 and coord_x ! coord_v_x and coord_y ! coord_v_y:
			vbike = rand(25,60)
			'"And where is my bike?"'
			'"Ow, bitch, luckily for you I don''t care about bike much."'
			'"But you need to restart your bike trainings to understand how to use a bike!"'
			brak += 5
			vbike = rand(25,60)
		end
		'"WTF BETSI!!! You missed the meet with Tolik!"'
		'"I will think twice about your next bike ride."'
		vbrak += 4

		act 'continue': gt 'mod_public_WC_rab_Task', 'start2'
	else
		if hour >= 21:
			*clr & cla
			'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/vania/vania.jpg"></center>'

			'"Hello, Betsi, you are playing with fire… go to the Tolik and quick!"'
			'Vania take off the colar''s lock'
			zashmorg = 1

			'<i>Hmm, could I  go further next time… maybe he is not my boss?</i>'
			Vaniamayster -= rand(3,5)
			willpowermax += rand(1,3)
			gs 'stat'

			if onvelyk = 0 and coord_x ! coord_v_x and coord_y ! coord_v_y:
				vbike = rand(25,60)
				'"And where is my bike?"'
				'"Ow, bitch, luckily for you I don''t care about bike much."'
				'"But you need to restart your bike trainings to understand how to use a bike!"'
				brak += 5
				vbike = rand(25,60)
			end

			act 'Go to the Tolik': gt 'mod_public_WC_rab', 'vhid'
		else
			*clr & cla
			$func('wrap', 'header center b', 'The yard where I''m being held')
			'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/HATA/dim.jpg"></center>'

			if onvelyk = 1:
				'I come "home" and left the bike on it''s place'
			end

			'I come "home"…'
			ktemp = 3657753
			vbrak -= 2
			if vbrak < 0: vbrak = 0
			act 'continue': gt 'mod_public_WC_rab_DVIR', 'dvir'
		end
	end
end



if $ARGS[0] = 'Vania':
	Vurok += 1
	if (hour >= 22 and zvit = week and poshuk > 0) or (zvit + 1 = week and poshuk > 0) or (zvit - 6 = week and poshuk > 0):
		*clr & cla
		'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/vania/vania.jpg"></center>'
		'Vania rides to me on the bike'

		'"WTF, BETSI!!! You must be home and not here!"'

		if rope <= 0:
			if onvelyk = 1:
				act 'throw a bike as an obstacle to Vania and run away to off-road':
					ktemp = 105
					gt 'mod_public_WC_rab_tryrun', 'run'
				end
			elseif onvelyk = 0:
				act 'Run away to off-road':
					ktemp = 105
					gt 'mod_public_WC_rab_tryrun', 'run'
				end
			end

			if VaniaMayster >= 100:
				cla
				'<i>I obey Vania for so long…</i>'
				'<i>I can''t say "no" to Vania anymore</i>'
			end
		end

		if rope > 0:
			vbike = 200
			'"Ow… Well, I see you in troubles… it explains a lot…"'
			'Vania helps me'
			act 'Go with Vania':
				minut += rand(5,20)
				gs 'stat'
				gt 'mod_public_WC_rab_DVIR', 'dvir'
			end
		elseif onvelyk = 0 and coord_x ! coord_v_x and coord_y ! coord_v_y:
			'"And where is my bike?"'
			'"Ow, bitch, luckily for you I don''t care about bike much."'
			'"But you need to restart your bike trainings to understand how to use a bike!"'
			brak += 5
			vbike = rand(25,60)
		end

		if rope <= 0:
			'"It''s very doubt you will ride a bike again!"'
			vbrak += 9
			brak += 10
			act 'Go with Vania':
				minut += rand(5,20)
				gs 'stat'
				gt 'mod_public_WC_kara', 'vtecha'
			end
		end
	elseif hour = 21:
		*clr & cla
		'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/vania/vania.jpg"></center>'
		'Vania rides to me on a bike…'

		if rope > 0:
			vbike = 200
			'"Well, I see you in troubles… it explains a lot…"'
			'Vania helps me'
		elseif onvelyk = 0 and coord_x ! coord_v_x and coord_y ! coord_v_y:
			'"Hello Betsi"'
			'"And where is my bike?"'
			'"Ow, bitch, luckily for you I don''t care about bike much."'
			'"But you need to restart your bike trainings to understand how to use a bike!"'
			'"Ok, doesn''t matter for now, it''s time to go home!"'
			brak += 5
			vbike = rand(25,60)
		else
			'"Hello Betsi, it''s time to go home!"'
		end

		if rope <= 0:
			if onvelyk = 1:
				act 'throw a bike as an obstacle to Vania and run away to off-road':
					ktemp = 105
					gt 'mod_public_WC_rab_tryrun', 'run'
				end
			elseif onvelyk = 0:
				act 'Run away to off-road':
					ktemp = 105
					gt 'mod_public_WC_rab_tryrun', 'run'
				end
			end

			if VaniaMayster >= 100:
				cla
				'<i>I obey Vania for so long…</i>'
				'<i>I can''t say "no" to Vania anymore</i>'
			end
		end

		act 'Go with Vania':
			minut += rand(5,20)
			gs 'stat'
			gt 'mod_public_WC_rab_DVIR', 'dvir'
		end
	end
end



if $ARGS[0] = 'run':
	onvelyk = 0
	poshuk = 0
	killvar 'vogon_x'
	killvar 'vogon_y'
	killvar 'vogond'
	killvar 'vogon'
	killvar 'phour'
	killvar 'pday'
	poletan = 0
	killvar 'coord_v_x'
	killvar 'coord_v_y'
	vtecha = 1
	Artem = 0 & Tolik = 0 & Vania = 0
	brak += 10
	vbike = 0

	if b_big = 1:
		killvar 'b_big'
		gt 'swamp_yard', 'start'
	elseif b_big = 2:
		killvar 'b_big'
		gt 'gadroad'
	elseif b_big = 3:
		killvar 'b_big'
		Y = 0
		X = 0

		if hour < 16:
			endhour = hour + 6
		else
			endhour = rand(5,6)
			if week = 7:
				endday = 1
			else
				endday = week + 1
			end
		end

		ztemp = 0
		vtecha = 1
		Artem = 0
		Tolik = 0
		Vania = 0
		gt 'mod_public_WC_kara71', 'runrun'
	elseif b_big = 4:
		killvar 'b_big'
		minut += rand(30,60)
		gs 'stat'
		gt 'mod_public_WC_rab_DVIR', 'dvir'
	elseif b_big = 5:
		killvar 'b_big'
		gt 'mod_public_WC_kara7', 'maniak'
	elseif b_big = 6:
		killvar 'b_big'
		gt 'mod_public_WC_kara7', 'maniakd'
	elseif b_big = 7:
		killvar 'b_big'
		gt'gadukino'
	end
end
