		end

		if onvelyk = 0:
			act 'rest a little in the grass (1:00)':
				cla
				if sunWeather = 1: pcs_tan += 1
				minut += 60
				if sunWeather = 1 and pcs_sweat < 35 : gs 'sweat', 'add', 5

				gs 'stat'
				pcs_sleep += 7
				pcs_health += 4
				pcs_mood += 7
				gs 'stat'
				act 'stand up': gt $loc, $loc_arg
			end
		end
	elseif pole = 2:
		if sunWeather = 1: poletan += 1
		if poletan >= 8:
			pcs_tan += 1
			poletan = 0
			gs 'stat'
		end

		if onvelyk = 0:
