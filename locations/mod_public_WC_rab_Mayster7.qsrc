				minut += 60
				if sunWeather = 1 and pcs_sweat < 35 : gs 'sweat', 'add', 5

				gs 'stat'
				pcs_sleep += 7
				pcs_health += 4
				pcs_mood += 7
				gs 'stat'
				act 'stand up': gt $loc, $loc_arg
			end
		end
	elseif lis >= 1:
		if onvelyk = 0:
			if hmyz < 15:
				'<i>I can pick up some firewood around here for a fire.</i>'
				act 'Collect firewood (0:15)':
					cla & *clr
					'<center><img <<$set_imgh>> src="images/locations/gadukino/hunters/'+iif($clothingworntype ! 'nude','firewood_normal.jpg','firewood_nude.jpg')+'"></center>'
					'I pick up some dry branches and twigs.'
					hmyz += rand(2,6)
					if hmyz < 15:
						'I have <<firewood>> pieces of firewood.'
					else
						'I have <<firewood>> pieces of firewood and I can''t carry more.'
					end
					minut += 15
					gs 'stat'
					act 'Further': gt 'mod_public_WC_rab_Mayster7', 'ride'
				end
			end

			if boletus + boletus_cooked + bilberry + ryba_cooked + ryba < 10:
				act 'Try to find mushrooms (00:30)':
					if rand(1,100) + pcs_observ >= rand(50,100):
						*clr & cla
						'<center><img <<$set_imgh>> src="images/locations/gadukino/forest/mushroom0.'+rand(1,3)+'.jpg"></center>'
						*nl
						'Searching in the forest, I stumble upon a clearing full of mushrooms. How lucky!.'

						observ_exp += 1
						minut += 30
						boletus += rand(1,3)
						gs 'stat'

						gs 'gad_forest', 'picking_clothes', 'forest_center', 'mushroom'
						*nl
						'I begin collecting mushrooms trying to make everything fit in my basket.'

						act 'Continue': gt 'mod_public_WC_rab_Mayster7','ride'
					else
						cla
						observ_exp += rand(0,1)
						minut += 30
						gs 'stat'
						'I have found no mushrooms'
						act 'Continue': gt 'mod_public_WC_rab_Mayster7','ride'
					end
				end
			else
				'My basket is totally full! I cannot carry any more.'
			end

			if boletus + boletus_cooked + bilberry + ryba_cooked + ryba < 10:
				act 'Try to find mushrooms (00:30)':
					if rand(1,100) + pcs_observ >= rand(50,100):
						*clr & cla
						'<center><img <<$set_imgh>> src="images/locations/gadukino/forest/bilberry'+rand(3,5)+'.jpg"></center>'
						*nl
						'Wandering in the forest, I stumble upon a clearing full of berries. How lucky!.'

						observ_exp += 1
						minut += 30
						bilberry += rand(2,4)
						gs 'stat'

						gs 'gad_forest', 'picking_clothes', 'forest_center', 'berry'
						*nl
						'I begin collecting berries trying to make everything fit in my basket.'

						act 'Continue': gt 'mod_public_WC_rab_Mayster7','ride'
					else
						cla
						observ_exp += rand(0,1)
						minut += 30
						gs 'stat'
						'I have found no berries'
						act 'Continue': gt 'mod_public_WC_rab_Mayster7','ride'
					end
				end
			else
				'My basket is totally full! I cannot carry any more.'
			end
		end
	elseif rika = 1:
		if onvelyk = 0:
			if $clothingworntype ! 'nude':
				'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/Vania/trener/velyk/rest/odiag/0.jpg"></center>'
				act 'Strip naked':
					*clr & cla
					minut += 5
					$lastwornclothingtype['swim'] = $clothingworntype
					lastwornclothingnumber['swim'] = clothingwornnumber
					$lastwornpantytype['swim'] = $pantyworntype
					lastwornpantynumber['swim'] = pantywornnumber
					$lastwornbratype['swim'] = $braworntype
					lastwornbranumber['swim'] = brawornnumber
					gs 'clothing', 'strip_all', 'VillageRiver'
					'Without hesitation, I take off all my clothes and neatly fold them before putting them down on a pile.'

					'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/Vania/trener/velyk/rest/odiag/1 ('+rand(1,2)+').jpg"></center>'

					act 'Continue': gt $loc, $loc_arg
				end
			elseif $clothingworntype = 'nude':
				'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/Vania/trener/velyk/rest/odiag/2.jpg"></center>'
				act 'Get dressed':
					clothesAtLocation = FUNC('lost_clothes_here','VillageRiver')
					*clr & cla
					minut += 5
					gs 'panties', 'wear', $lastwornpantytype['swim'], lastwornpantynumber['swim']
					gs 'bras', 'wear', $lastwornbratype['swim'], lastwornbranumber['swim']
					if clothesAtLocation = 1: gs 'clothing', 'recover_lost_clothes', 'VillageRiver', 1
					act 'Continue': gt $loc, $loc_arg
				end


				act 'swim to other side (without the bike)':
					*clr & cla
					if coord_v_x = coord_v_y = 0:
						coord_v_x = coord_x
						coord_v_y = coord_y
						onvelyk = 0
					end
					if coord_x = 4 and coord_y > 1:
						coord_x += 1
					elseif coord_x = 4 and coord_y = 1:
						coord_x += 1
						coord_y += 1
					elseif coord_x >= 5 and coord_x <= 7 and coord_y = 1:
						coord_y += 1
					elseif coord_x = 5 and coord_y > 1:
						coord_x -= 1
					elseif coord_x >= 6 and coord_x <= 7 and coord_y = 2:
						coord_y -= 1
					elseif coord_x = 10 and coord_y <= 0:
						coord_x += 1
					elseif coord_x = 11 and coord_y <= 0:
						coord_x -= 1
					end

					cumspclnt = 4
					gs 'cum_cleanup'
					minut += 30
					gs 'exercise', 'tier1', 1, 'stren_exp'
					gs 'stat'

					pcs_sweat = 0
					if deodorant_on = 1: gs 'sweat', 'remove_deo' & '<br>Your deodorant gets washed away in the water.</br>'

					if month > 4 and month < 10:
						if hour >= 6 and hour <= 21:
							'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/Vania/trener/velyk/rest/gowater ('+rand(1,10)+').jpg"></center>'
						else
							'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/Vania/trener/velyk/rest/gowater n ('+rand(1,4)+').jpg"></center>'
						end
					else
						if hour >= 8 and hour <= 17:
							'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/Vania/trener/velyk/rest/gowater zyma.jpg"></center>'
						else
							'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/Vania/trener/velyk/rest/gowater zyma n.jpg"></center>'
						end
					end
					act 'continue': gt 'mod_public_WC_rab_Mayster7', 'ride'
				end

				act 'Go in water to swim and relax (00:30)':
					gt 'mod_public_WC_rab_Mayster7', 'swim'
				end

				act 'make an exercise': gt 'mod_public_WC_rab_Mayster7', 'sport'
			end
		end
	end
end

if $ARGS[0] = 'swim':
	*clr & cla
	cumspclnt = 4
	gs 'cum_cleanup'
	minut += 30
	gs 'exercise', 'tier1', 1, 'stren_exp'

	pcs_sweat = 0
	if deodorant_on = 1: gs 'sweat', 'remove_deo' & '<br>Your deodorant gets washed away in the water.</br>'

	if month > 4 and month < 10:
		if hour >= 6 and hour <= 21:
			'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/Vania/trener/velyk/rest/gowater ('+rand(1,10)+').jpg"></center>'
		else
			'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/Vania/trener/velyk/rest/gowater n ('+rand(1,4)+').jpg"></center>'
		end
	else
		if hour >= 8 and hour <= 17:
			'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/Vania/trener/velyk/rest/gowater zyma.jpg"></center>'
		else
			'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/Vania/trener/velyk/rest/gowater zyma n.jpg"></center>'
		end
	end

	act 'Swim and relax (00:30)':
		gt 'mod_public_WC_rab_Mayster7', 'swim'
	end

	act 'Go skinny dipping (00:15)':
		*clr & cla
		temp_gr = rand(0,15)
		cumspclnt = 4
		gs 'cum_cleanup'
		minut += 15
		pcs_sweat = 0
		pcs_mood += 5

		if pcs_stren < 30: stren_exp += 1

		if deodorant_on = 1: gs 'sweat', 'remove_deo' and '<br>Your deodorant gets washed away in the water.</br>'

		'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/Vania/trener/velyk/rest/plav/nyrayu ('+rand(1,2)+').jpg"></center>'

		act 'Ascend':
			temp_gr = rand(0,15)
			minut -= 29
			gs 'stat'
			gt 'mod_public_WC_rab_Mayster7', 'swim'
		end

		act 'Search something on the bottom (0:03)':
			*clr & cla
			'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/Vania/trener/velyk/rest/plav/pidvodoyu (2).jpg"></center>'
			temp_gr = rand(0,15)
			cumspclnt = 4
			gs 'cum_cleanup'
			minut += 3
			pcs_sweat = 0
			pcs_mood += rand(0,1)

			temp = rand(1,100)
			if temp <= 5:
				'I have found a gold coin!'
				'It costs a lot!'
				money += rand(1,10) * 500
			elseif temp <= 10:
				'I have found a silver coin!'
				'It costs a lot!'
				money += rand(1,10) * 100
			else
				'I have found nothing'
			end
			gs 'stat'

			act 'Ascend':
				temp_gr = rand(0,15)
				minut -= 29
				gs 'stat'
				gt 'mod_public_WC_rab_Mayster7', 'swim'
			end
		end
	end
	act 'Get out from water':
		gt $loc, $loc_arg
	end
end

