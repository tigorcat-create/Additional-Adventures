		'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/Vania/trener/velyk/rest/sport/skak.jpg"></center>'
		act 'continue': gt $loc, $loc_arg
	end
end

if $ARGS[0] = 'boloto':
	*clr & cla

	if month > 4 and month < 10:
		if hour >= 6 and hour <= 21:
			'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/Vania/trener/velyk/road_ride/boloto/ld ('+rand(1,2)+').jpg"></center>'
		else
			'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/Vania/trener/velyk/road_ride/boloto/ln ('+rand(1,2)+').jpg"></center>'
		end
	else
		if hour >= 8 and hour <= 17:
			'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/Vania/trener/velyk/road_ride/boloto/zd ('+rand(1,2)+').jpg"></center>'
		else
			'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/Vania/trener/velyk/road_ride/boloto/zn ('+rand(1,2)+').jpg"></center>'
		end
	end

	if onvelyk = 1:
		if coord_y = 1:
			act 'ride back from the swamp (south)':
				coord_y -= 1
				onvelyk = 1
				killvar 'coord_v_x'
				killvar 'coord_v_y'
				gt 'mod_public_WC_rab_Mayster7', 'ride'
			end
		elseif coord_y >= 2:
			act 'ride back from the swamp (west)':
				coord_x -= 1
				onvelyk = 1
				killvar 'coord_v_x'
				killvar 'coord_v_y'
				gt 'mod_public_WC_rab_Mayster7', 'ride'
			end
		end
	end

	if onvelyk = 0:
		act 'go west':
			coord_x -= 1
			pole = 0
			lis = 0
			rika = 0
			boloto = 0
			onvelyk = 1
			gt 'mod_public_WC_rab_Mayster7', 'ride'
		end
		act 'go east':
			coord_x += 1
			pole = 0
			lis = 0
			rika = 0
			boloto = 0
			onvelyk = 1
			gt 'mod_public_WC_rab_Mayster7', 'ride'
		end
		act 'go north':
			coord_y += 1
			pole = 0
			lis = 0
			rika = 0
			boloto = 0
			onvelyk = 1
			gt 'mod_public_WC_rab_Mayster7', 'ride'
		end
		act 'go south':
			coord_y -= 1
			pole = 0
			lis = 0
			rika = 0
			boloto = 0
			onvelyk = 1
			gt 'mod_public_WC_rab_Mayster7', 'ride'
		end
	end

	if onvelyk = 1:
		coord_v_x = coord_x
		coord_v_y = coord_y
		onvelyk = 0
		'<i>The bike is almost stuck, I need to ride out the swamp or to left the bike here.</i>'
		act 'LEFT the bike and go west':
			coord_x -= 1
			pole = 0
			lis = 0
			rika = 0
			boloto = 0
			onvelyk = 0
			gt 'mod_public_WC_rab_Mayster7', 'ride'
		end
		act 'LEFT the bike and go east':
			coord_x += 1
			pole = 0
			lis = 0
			rika = 0
			boloto = 0
			onvelyk = 0
			gt 'mod_public_WC_rab_Mayster7', 'ride'
		end
		act 'LEFT the bike and go north':
			coord_y += 1
			pole = 0
			lis = 0
			rika = 0
			boloto = 0
			onvelyk = 0
			gt 'mod_public_WC_rab_Mayster7', 'ride'
		end
		act 'LEFT the bike and go south':
			coord_y -= 1
			pole = 0
			lis = 0
			rika = 0
			boloto = 0
			onvelyk = 0
			gt 'mod_public_WC_rab_Mayster7', 'ride'
		end
	end


	if coord_x = coord_v_x and coord_y = coord_v_y:
		'This is my byke!'
		if coord_y = 1:
			act 'ride back from the swamp (south)':
				coord_y -= 1
				onvelyk = 1
				killvar 'coord_v_x'
				killvar 'coord_v_y'
				gt 'mod_public_WC_rab_Mayster7', 'ride'
			end
		elseif coord_y >= 2:
			act 'ride back from the swamp (west)':
				coord_x -= 1
				onvelyk = 1
				killvar 'coord_v_x'
				killvar 'coord_v_y'
				gt 'mod_public_WC_rab_Mayster7', 'ride'
			end
		end
	end


	if coord_x >= 11 and coord_y >= 0:
		temp = rand(1,10)
		if temp + coord_y - boloto_temp >= 6:
			boloto_temp = 200
			*clr & cla
			'As I walk through the swamp, I feel myself begin to sink into the mud with each step.'
			if $clothingworntype ! 'nude' and PCloSkirt = 0:
				'<center><img <<$set_imgh>> src="images/locations/gadukino/hunters/goswamp1.jpg"></center>'
			elseif $clothingworntype ! 'nude' and PCloSkirt > 0:
				'<center><img <<$set_imgh>> src="images/locations/gadukino/hunters/goswamp_ski1.jpg"></center>'
			elseif $clothingworntype = 'nude':
				'<center><img <<$set_imgh>> src="images/locations/gadukino/hunters/goswamp_nude0.'+rand(4,5)+'.jpg"></center>'
			end

			act 'Struggle':
				*clr & cla
				swamp_stuck += 1
				minut += 15
				gs 'sweat', 'add', 15
				gs 'stat'
				if swamp_stuck mod 3 = 0:
					swamp_check = pcs_stren + pcs_agil + pcs_bushcraft
					swamprand = rand(0,225)
				elseif swamp_stuck mod 2 = 0:
					swamp_check = pcs_stren + pcs_agil
					swamprand = rand(0,150)
				else
					swamp_check = pcs_stren
					swamprand = rand(0,75)
				end
				if swamp_stuck = 10 and Enable_nogameover = 0:
					over = 10
					gt 'gameover'
				else
					if swamp_check > swamprand:
