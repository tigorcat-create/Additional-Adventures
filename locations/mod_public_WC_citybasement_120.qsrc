# mod_public_WC_citybasement_120
if $ARGS[0] = '120':
	*clr & cla
	CLOSE ALL

	minut += rand(0,3)
	$loc_arg = '120'
	$loc = 'mod_public_WC_citybasement_120'
	zt = 120
	menu_off = 0
	$menu_loc = 'mod_public_WC_citybasement'
	$menu_arg = '120'
	gs 'stat'
	$func('wrap', 'header center b', 'Undercity tunnels')
	'<center><img <<$set_imgh>> src="mod/public_WC/wc/events/90/101gopotamista/pidval/pidzem/p29.jpg"></center>'
	'There is a stairs and I see some light from the next room'

	if vhid1 >= 1: 'to exit in the center go up the stairs'
	act 'go up the stairs':
		*clr & cla
		'<center><img <<$set_imgh>> src="mod/public_WC/wc/events/90/101gopotamista/pidval/vhid/1centr.jpg"></center>'
		if vhid1 > 1 and vhid1 < 10:
			'well, I don''t know where I am. But somewhere in the city center'
			if rand (1,5) = 1: vhid1 += 1
			if vhid1 >= 10: vhid1 = 1
		end
		if vhid1 = 1:
			'Ow, I am somewhere in the city center now'
		elseif vhid1 = 100:
			gt 'mod_public_WC_citybasement_enter', 'vhid1'
		else
			'well, I don''t know where I am. But somewhere in the city center'
			vhid1 = 2
		end
		act 'go back': urape += -30 & ubomj += 35 & ubomj2 =0 & gt 'mod_public_WC_citybasement', '120'
		if vhid1 ! 100:
			'The door is closed'
			act 'I''ll try to break the lock ':
				cla
				if mc_inventory['kirbygrips'] <=0:
					cla
					'I need some clips to do that'
					act 'continue': urape += -30 & ubomj += 35 & ubomj2 =0 & gt 'mod_public_WC_citybasement', '120'

				else
					'I''ll try to do it with my clip'
					hpingrip -= 1
					mc_inventory['kirbygrips']-=1

					minut += rand(1, 30)
					pcs_hndiwrk += rand(0,1)
					gs 'stat'
					wait 800
					if pcs_hndiwrk >= rand(10,100):
						*clr & cla
						vhid1 = 100
						'Yes! I Did it!'
						pcs_mood += rand(10,30)
						gs 'stat'

						act 'go out': gt 'mod_public_WC_citybasement_enter', 'vhid1'
						act 'continue': urape += -30 & ubomj += 35 & ubomj2 =0 & gt 'mod_public_WC_citybasement', '120'
					else
						'I am failed'
						act 'continue': urape += -30 & ubomj += 35 & ubomj2 =0 & gt 'mod_public_WC_citybasement', '120'
					end
				end
			end
		end
	end

	if pr = 119:
		if vhid2 >= 1: 'to exit in the industrial go back'
		if vhid3 >= 1: 'to exit in the red light go back'
		if vhid4 >= 1: 'to resident exit go back'
		if vhid5 >= 1: 'to exit in the park go back'
		act 'go further to the light': pr = 120 & urape += -50 & ubomj += 20 & ubomj2 =250 & gt 'mod_public_WC_citybasement', '121'
		act 'go back': pr = 120 & urape += 15 & ubomj += 20 & ubomj2 =0 & gt 'mod_public_WC_citybasement', '119'
	elseif pr = 121:
		if vhid2 >= 1: 'to exit in the industrial go further'
		if vhid3 >= 1: 'to exit in the red light go further'
		if vhid4 >= 1: 'to resident exit go further'
		if vhid5 >= 1: 'to exit in the park go further'
		act 'go further': pr = 120 & urape += 15 & ubomj += 20 & ubomj2 =0 & gt 'mod_public_WC_citybasement', '119'
		act 'go back to the room': pr = 120 & urape += -50 & ubomj += 20 & ubomj2 =250 & gt 'mod_public_WC_citybasement', '121'
	elseif pr = 1201:
		if vhid2 >= 1: 'to exit in the industrial go left to the tunnel'
		if vhid3 >= 1: 'to exit in the red light go left to the tunnel'
		if vhid4 >= 1: 'to resident exit go left to the tunnel'
		if vhid5 >= 1: 'to exit in the park go left to the tunnel'
		act 'go left to the tunnel': pr = 120 & urape += 35 & ubomj += -20 & ubomj2 =0 & gt 'mod_public_WC_citybasement', '119'
		act 'go right to the light': pr = 120 & urape += -30 & ubomj += 35 & ubomj2 =0 & gt 'mod_public_WC_citybasement', '121'
	end




	if bumevent = 0:
		eventtemp = rand (1,300)
		if hour >= 5 and hour <= 21:
			urape += 10
		end
		if hour >= 5 and hour <= 21:
			ubomj -= 10
		end
		if hour < 5 or hour > 21:
			ubomj2 += 10
		end
		ubomj2 -= bumfriend


		if eventtemp >= 290:
			gs 'mod_public_WC_citybasement_bumsex', 'body'
		elseif eventtemp >= 270:
			gs 'mod_public_WC_citybasement_bumsex', 'bag'
		elseif urape >= eventtemp:
			gs 'mod_public_WC_citybasement_bumsex', 'rape'
		elseif ubomj >= eventtemp:
			gs 'mod_public_WC_citybasement_bumsex', 'bomj'
		elseif bumfriend >= rand(15,30):
			bumevent = 1
			ubomj2 = rand(1,4)
			tabir = rand(1,4)
			'I see familiar bums here'
			'some of them even say "hi" to me'
			act 'ask to drink with them':
				atemp = 0
				tabir = rand(1,4)
				'<center><img <<$set_imgh>> src="mod/public_WC/wc/events/90/101gopotamista/pidval/bomji/tabir (<<tabir>>).jpg"></center>'
				killvar 'atemp'
				gt 'mod_public_WC_citybasement_bumsex', 'bomj2drink'
			end
		elseif ubomj2 >= eventtemp:
			gs 'mod_public_WC_citybasement_bumsex', 'bomj2'
		elseif ( eventtemp - urape) <= 15:
			'I hear footsteps…'
		elseif ( eventtemp - ubomj ) <= 15:
			'I hear footsteps…'
		elseif ( eventtemp - bomj2) <= 15:
			'I hear footsteps…'
		else
			' '
		end
	elseif bumevent = 2:
		bumevent = 0
		*nl
		'There are bums here.'
		act 'drink with the bums':
			bumevent = 1
			gt 'mod_public_WC_citybasement_bumsex', 'bomj2drink'
		end
	end
	if bumevent >= 10:
		bumevent = 0
		gs 'stat'
	elseif 	bumevent = 1:
		bumevent += 10
		gs 'stat'
	end
end

if $ARGS[0] = '121':
	*clr & cla
	CLOSE ALL
	if sound_settings['environment_off'] = 0: PLAY 'mod/public_WC/sound/walk.wav',60
	$loc = 'mod_public_WC_citybasement'
	$loc_arg = '121'
	$loc = 'mod_public_WC_citybasement_120'
	zt = 121
	pr = 121
	menu_off = 0
	minut += rand(0,3)
	$loc_arg = '121'
	$menu_loc = 'mod_public_WC_citybasement'
	$menu_arg = '121'
	gs 'stat'
	$func('wrap', 'header center b', 'Nice room')
	'<center><img <<$set_imgh>> src="mod/public_WC/wc/events/90/101gopotamista/pidval/pidzem/p21.jpg"></center>'
	'I see few beds, some stuf like someone lives here, and even a sink '

	act 'Go to the tunnel':
		if vhid1 >= 1: 'to exit in the center go to the tunnel'
		if vhid2 >= 1: 'to exit in the industrial go to the tunnel'
		if vhid3 >= 1: 'to exit in the red light go to the tunnel'
		if vhid4 >= 1: 'to resident exit go to the tunnel'
		if vhid5 >= 1: 'to exit in the park go to the tunnel'
		urape += -30 & ubomj += 35 & ubomj2 =0 & gt 'mod_public_WC_citybasement', '120'
	end
	act 'Take a nap (1:00)':
		cla
		menu_off = 0
		act 'continue': gt $loc, $loc_arg
		if pcs_sleep >= 20 and pcs_sleep <= 90:
			gs 'sweat', 'add', 10
			pcs_sleep += 15
			pcs_health += 5
			minut += 60
			gs 'stat'
			*nl
			'You sleep about an hour.'
		elseif pcs_sleep < 20:
			*clr & cla
			gs 'sweat', 'add', rand(15,50)
			gs 'stat'
			gt 'pre_sleep', 'prepare_sleep'
		else
			minut += 5
			gs 'stat'
			*nl
			'You are not tired enough to sleep, even for a short nap.'
		end
	end
	act 'drink water from the tap':
		'<center><img <<$set_imgh>> src="mod/public_WC/wc/events/90/101gopotamista/pidval/pidzem/kran.jpg"></center>'
		minut += 3
		pcs_health -= rand (0,70)

		gs 'beverage', 'water_stats'
		gs 'beverage', 'afterdrink'
		gs 'stat'
	end
	dynamic $tampon
	dynamic $quickwash
	dynamic $basin
	dynamic $publicpan



	if bumevent = 0:
		eventtemp = rand (1,300)
		if hour >= 5 and hour <= 21:
			urape += 10
		end
		if hour >= 5 and hour <= 21:
			ubomj -= 10
		end
		if hour < 5 or hour > 21:
			ubomj2 += 10
		end
		ubomj2 -= bumfriend


		if eventtemp >= 290:
			gs 'mod_public_WC_citybasement_bumsex', 'body'
		elseif eventtemp >= 270:
			gs 'mod_public_WC_citybasement_bumsex', 'bag'
		elseif urape >= eventtemp:
			gs 'mod_public_WC_citybasement_bumsex', 'rape'
		elseif ubomj >= eventtemp:
			gs 'mod_public_WC_citybasement_bumsex', 'bomj'
		elseif bumfriend >= rand(15,30):
			bumevent = 1
			ubomj2 = rand(1,4)
			tabir = rand(1,4)
			'I see familiar bums here'
			'some of them even say "hi" to me'
			act 'ask to drink with them':
				atemp = 0
				tabir = rand(1,4)
				'<center><img <<$set_imgh>> src="mod/public_WC/wc/events/90/101gopotamista/pidval/bomji/tabir (<<tabir>>).jpg"></center>'
				killvar 'atemp'
				gt 'mod_public_WC_citybasement_bumsex', 'bomj2drink'
			end
		elseif ubomj2 >= eventtemp:
			gs 'mod_public_WC_citybasement_bumsex', 'bomj2'
		elseif ( eventtemp - urape) <= 15:
			'I hear footsteps…'
		elseif ( eventtemp - ubomj ) <= 15:
			'I hear footsteps…'
		elseif ( eventtemp - bomj2) <= 15:
			'I hear footsteps…'
		else
			' '
		end
	elseif bumevent = 2:
		bumevent = 0
		*nl
		'There are bums here.'
		act 'drink with the bums':
			bumevent = 1
			gt 'mod_public_WC_citybasement_bumsex', 'bomj2drink'
		end
	end
	if bumevent >= 10:
		bumevent = 0
		gs 'stat'
	elseif 	bumevent = 1:
		bumevent += 10
		gs 'stat'
	end
end

