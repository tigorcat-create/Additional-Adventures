if $ARGS[0] = 'karroom':
	*clr & cla
	menu_off = 0
	$loc = 'mod_public_WC_citybasement_120'
	$loc_arg = 'karroom'
	'I entered a room with shine light. I become blind for a moment.'
	'There are bed, some metal pole and a ladder in the room.'
	'<center><img <<$set_imgh>> src="mod/public_WC/wc/events/90/101gopotamista/pidval/pidzem/door.jpg"></center>'

	phtemp = 0
	act 'Take a nap (1:00)':
		cla
		menu_off = 0
		act 'continue': gt $loc, $loc_arg
		if pcs_sleep >= 20 and pcs_sleep <= 90:
			gs 'sweat', 'add', 10
			pcs_sleep += 15
			pcs_health += 5
			minut += 60
			gs 'stat'
			*nl
			'You sleep about an hour.'
			phtemp = 1
		elseif pcs_sleep < 20:
			*clr & cla
			gs 'sweat', 'add', rand(15,50)
			gs 'stat'
			gt 'pre_sleep', 'prepare_sleep'
		else
			minut += 5
			gs 'stat'
			*nl
			'You are not tired enough to sleep, even for a short nap.'
			phtemp = 2
		end
		if rand(phtemp,2) = 2 and phtemp ! 0:
			cla
			'As I wake up few guys in masks (robbers I suppose) stand in front of me'
			killvar 'phrobfail'
			killvar 'phrobbos'
			killvar 'phrobwife'
			killvar 'phsafefindout'
			killvar 'photherevent'
			killvar 'phdtape'
			killvar 'pduck'
			killvar 'pheventstartlive'
			killvar 'phrobtiedwhere'
			killvar 'phwindow'
			killvar 'phapronon'
			killvar 'phrobwatme'
			killvar 'phroberkilled'
			killvar 'phknife'
			killvar 'phrobers'
			colir = 1
			money = 0
			phclienttied = 0
			'Robber: "What a luck. We need a pretty girl and here it is in our bed!"'
			killvar 'phrobday'
			killvar 'phrobh'
			killvar 'phclienttied'
			killvar 'phrobbos'
			killvar 'phrobwife'

			phrobday = daystart + 3
			phrobh = rand(19,22)

			phiamhome = 2
			phrobwife = 0
			'Robber: "We need to show you to the Boss"'
			'He break me and we go by the ladder up'
			phrobbos = 0
			killvar 'phrobbos'
			act 'wait': gt 'mod_public_WC_robed_boss', 'start'
		end
	end
	act 'go up by the ladder':
		'The manhole is closed.'
		'-=wip=- взламати до хата банди + сейф'
	end
	act 'look for a similar button':
		'Yes there is a simillar button here'
		minut +- rand(5,45)
		gs 'stat'
		act 'press the button and enter the door':
			urape += -50 & ubomj += 50 & ubomj2 =0 & gt 'mod_public_WC_citybasement', '126'
		end
	end
end


