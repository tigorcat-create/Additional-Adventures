if $ARGS[0] = '124':
	*clr & cla
	menu_off = 0
	CLOSE ALL
	if sound_settings['environment_off'] = 0: PLAY 'mod/public_WC/sound/walk.wav',60
	minut += rand(0,3)
	$loc_arg = '124'
	$loc = 'mod_public_WC_citybasement_120'
	zt = 124
	$menu_loc = 'mod_public_WC_citybasement'
	$menu_arg = '124'
	gs 'stat'
	$func('wrap', 'header center b', 'Undercity tunnels')
	'<center><img <<$set_imgh>> src="mod/public_WC/wc/events/90/101gopotamista/pidval/pidzem/p5.jpg"></center>'
	temp = rand(1,5)
	if temp = 1:
		'It''s dark here'
	elseif temp = 2:
		'I am scared a little'
	elseif temp = 3:
		'I really don''t know this tunnels so long!'
	elseif temp = 4:
		'There must be many exits from the tunnel'
	elseif temp = 5:
		'Have this tunnels been used during the War?'
	end


	if pr = 123:
		if vhid1 >= 1: 'to exit in the center go back'
		if vhid2 >= 1: 'to exit in the industrial go back'
		if vhid3 >= 1: 'to exit in the red light go further'
		if vhid4 >= 1: 'to resident exit go back'
		if vhid5 >= 1: 'to exit in the park go back'
		act 'go further': pr = 124 & urape += -20 & ubomj += 40 & ubomj2 =0 & gt 'mod_public_WC_citybasement', '125'
		act 'go back': pr = 124 & urape += 35 & ubomj += 45 & ubomj2 =0 & gt 'mod_public_WC_citybasement', '123'
	elseif pr = 125:
		if vhid1 >= 1: 'to exit in the center go further'
		if vhid2 >= 1: 'to exit in the industrial go further'
		if vhid3 >= 1: 'to exit in the red light go back'
		if vhid4 >= 1: 'to resident exit go further'
		if vhid5 >= 1: 'to exit in the park go further'
		act 'go further': pr = 124 & urape += 35 & ubomj += 45 & ubomj2 =0 & gt 'mod_public_WC_citybasement', '123'
		act 'go back': pr = 124 & urape += -20 & ubomj += 40 & ubomj2 =0 & gt 'mod_public_WC_citybasement', '125'
	end



	if bumevent = 0:
		eventtemp = rand (1,300)
		if hour >= 5 and hour <= 21:
			urape += 10
		end
		if hour >= 5 and hour <= 21:
			ubomj -= 10
		end
		if hour < 5 or hour > 21:
			ubomj2 += 10
		end
		ubomj2 -= bumfriend


		if eventtemp >= 290:
