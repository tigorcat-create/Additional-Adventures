	'<center><img <<$set_imgh>> src="mod/public_WC/wc/events/90/101gopotamista/pidval/pidzem/p3.jpg"></center>'
	'I see some boxes. And the door it bloks.'
	if ubutton ! 1:
		ubutton = 0
	end
	if vhid1 >= 1: 'to exit in the center go to the tunnel'
	if vhid2 >= 1: 'to exit in the industrial go to the tunnel'
	if vhid3 >= 1: 'to exit in the red light go to the tunnel'
	if vhid4 >= 1: 'to resident exit go to the tunnel'
	if vhid5 >= 1: 'to exit in the park go to the tunnel'
	act 'go to the tunnel': pr = 126 & urape += 0 & ubomj += 10 & ubomj2 =0 & gt 'mod_public_WC_citybasement', '125'
	act 'rummage in the boxes':
		cla
		observ_exp += 3
		minut += 15
		gs 'sweat', 'add', 10
		gs 'stat'
		temp = rand (1,100) + ( pcs_observ / 2 )
		ztemp = 0
		if temp >= 50 and ztemp ! 1 and ubutton ! 1:
			minut += rand(10,20)
			ztemp = 1
			'I found a button on the wall'
			ubutton = 1
		end
		if temp >= 80 and ztemp ! 1 and maddildo ! 1:
			ztemp = 1
			mood += 3
			maddildo = 1
			'YES! I found a 40cm long dildo'
		end
		if temp >= 110 and gun = 0 and ztemp ! 1:
			ztemp = 1
			'I found an old gun!'
			'<center><video autoplay loop <<$set_imgh>> src="mod/public_WC/lisrab/r_events/11/gun_found.mp4"></video></center>'
			gun = 1
		end
		if temp >= 100 and ztemp ! 1:
			ztemp = 1
			mood += 2
			temp = rand(1,2)
			if temp = 1:
				temp = rand (1,100) + ( pcs_observ / 2 )
				money += temp
				'I found <<temp>> money!'
			else
				ammo += rand(1,3)
				'I found some ammo money!'
			end
		end
		if temp >= 70 and ztemp ! 1:
			minut += rand(10,20)
			ztemp = 1
			'I found some mushrooms,'
			boletus += 2
		end
		if temp >= 80 and ztemp ! 1:
			minut += rand(10,20)
			ztemp = 1
			'I found cigarets,'
			mc_inventory['cigarettes'] += rand(1,5)
		end
		if ztemp ! 1:
			'I have found nothing. Are there anything here?'
		end
		act 'Continue': urape += -50 & ubomj += 50 & ubomj2 =0 & gt 'mod_public_WC_citybasement', '126'
	end
