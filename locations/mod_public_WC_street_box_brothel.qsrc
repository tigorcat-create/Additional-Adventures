	phclient_mood = 0
	otemp = 0
	
	act 'continue': gt 'mod_public_WC_street_box_brothel','start'
end


if $ARGS[0] = 'placetalk':
	otemp = rand(1,5)	
	
	act 'talk about the rules':
		cla
		
		'ME: "We have next rules here:"'
		
		if phcondomonly = 1:
			'Client MUST use condom'		
		else
			'Client can use condom if he want'
		end
		
		if phclient['condom'] = 3 and phcondomonly = 1:
			'CLIENT: "Pfff, no way"'
			gs 'mod_public_WC_street_box_brothel', 'clientaway'
		else
			'CLIENT: "Okey"'			
			
			gs 'mod_public_WC_street_box_brothel', 'moneyfirst'			
		end
	end
end


if $ARGS[0] = 'clienttrigger':
	!! otemp = 1258
	
	if otemp > 1:	
		if ph_brothelfame <= 10:
			if otemp >= rand(3,10):
				otemp = 1258
			end
		elseif ph_brothelfame <= 30:
			if otemp >= rand(3,8):
				otemp = 1258
			end
		elseif ph_brothelfame <= 50:
			if otemp >= rand(3,7):
				otemp = 1258
			end
		elseif ph_brothelfame <= 80:
			if otemp >= rand(2,7):
				otemp = 1258
			end
		elseif ph_brothelfame <= 100:
			if otemp >= rand(2,6):
				otemp = 1258
			end
		elseif ph_brothelfame <= 130:
			if otemp >= rand(2,4):
				otemp = 1258
			end
		elseif ph_brothelfame <= 150:
			if rand(1,2) ! 1:
				otemp = 1258
			end
		elseif ph_brothelfame <= 180:
			if rand(1,3) ! 1:
				otemp = 1258
			end
		else
			if rand(1,4) ! 1:
				otemp = 1258
			end
		end
	end
end








