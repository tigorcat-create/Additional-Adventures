if $ARGS[0] = 'shoot':
	cla
	'<center><img <<$set_imgh>> src="mod/public_WC/newstreet/whore/magicwhore/13 Mermaid/1 shore ('+rand(1,1)+').jpg"></center>'
	if phsex = 0: 
		'He aims at me and start shooting'
		+$OpenInnerThought+'Why my magic voice is not WORKING?!!'+$CloseInnerThought
	else
		'He is shooting at me'
	end
	
	temp = rand(1,10)
	phdamage = 6 - temp - ((pcs_agil/rand(20,30)) - 4)
	if phdamage < 0: phdamage = 0
	if phdamage > 0: 'few bullets hit me!!!'
	if (temp-10)*(-1) - phdamage >= 0: 'some bullets missed me'
	pcs_health -= phdamage * 750
	killvar 'phdamage'
	
	!! if pcs_health <= 0: pcs_health = 10
	gs 'stat'
	phsex += 1
	
	if phsex = 100:
		'VOICE FROM NOWHERE: "You can to stop the distraction."'
	elseif phsex >= rand(4,8):
		'VOICE FROM NOWHERE: "IT IS CRAZY, but it worked!!! You can to stop the distraction"'
		phsex = 100
	elseif phsex > 2 and phsex <= 4:
		'VOICE FROM NOWHERE: "We are on the way, keep doing it!"'
	elseif phsex > 1:
		'VOICE FROM NOWHERE: "Ok, it workes, we are going, keep doing it!"'
	END
	
	act 'dodge the bullets':
		*clr & cla
		minut += rand(3,5)
		gs 'stat'
		gs 'mod_public_WC_street_box_magicwhore_sex_swim', 'shoot'
	end
	
	act 'swim away':		
		if phsex > 1 and phsex <= 4:
			'VOICE FROM NOWHERE: "YOU can''t do that, they will busted us!!!"'
			
			act 'Anyway… swim away':
				phsex = -100
				PH_pay_PHmwrstat = -20
				phiphi = 2
				phtemp = 3
				phpoolswim = 1
				minut += 10
				phquestD -= 100
				gt 'mod_public_WC_street_box_magicwhore_sex_swim', 'swim'
			end
		else
			phiphi = 2
			phtemp = 3
			phpoolswim = 1
			minut += 10
			gt 'mod_public_WC_street_box_magicwhore_sex_swim', 'swim'
		end
	end
	
	if phsex = 100:
		act 'Find the portal to go back':
			cla
			'Task is completed'
			gs 'mod_public_WC_street_box_magicwhore_daily', 'task_end'
		end
	end
	
	if pcs_health <= 30:
		cla
		gs 'stat'
		'I am almost dead! I NEED TO RUN!!!'
		
		act 'swim away':		
			if phsex > 1 and phsex <= 4:
				'VOICE FROM NOWHERE: "YOU can''t do that, they will busted us!!!"'
				
				act 'Anyway… swim away':
					phsex = -100
					PH_pay_PHmwrstat = -20
					phiphi = 2
					phtemp = 3
					phpoolswim = 1
					minut += 10
					phquestD -= 100
					gt 'mod_public_WC_street_box_magicwhore_sex_swim', 'swim'
				end
			else
				phiphi = 2
				phtemp = 3
				phpoolswim = 1
				minut += 10
				gt 'mod_public_WC_street_box_magicwhore_sex_swim', 'swim'
			end
		end
	end
end



