							else
								'I take <<PH_full_pay>> cosmocredits'
								money += PH_full_pay
							end
							minut += 5
							gs 'stat'
							
							act 'Run away':				
								killvar 'zadovolennia2'
								killvar 'zadovolennia3'
								fame['pav_prostitute'] += rand(1,2)
								gt 'mod_public_WC_street_sex_corner_drugs', 'end'
							end
						end
					end
				else
					act 'Search the aliens ' + $func('wrap', 'v_neg', '(<<temp>> Willpower)'): $func('wrap', 'neg', '<br>I don''t have enough willpower to use this action.')
				end
			else
				'The stack of bills appears in the middle of the room'
				money += PH_full_pay
				
				act 'take the money':
					money += PH_full_pay
					gs 'stat'
					killvar 'zadovolennia2'
					killvar 'zadovolennia3'
					fame['pav_prostitute'] += rand(1,2)
					gt 'mod_public_WC_street_sex_corner_drugs', 'end'
				end
			end
		end
	end
end

