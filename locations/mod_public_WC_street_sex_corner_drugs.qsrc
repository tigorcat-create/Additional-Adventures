					killvar 'zadovolennia3'
					fame['pav_prostitute'] += rand(1,2)
					gt 'mod_public_WC_street_sex_corner_drugs', 'end'
				end
				
				gs 'willpower', 'misc', 'self', 'hard'
				temp = will_cost
				
				if will_cost <= 0: will_cost = 0
				if will_cost <= pcs_willpwr:
					
					act 'Search the aliens (<<temp>> Willpower)':
						cla
						gs 'willpower', 'pay', 'self'
						gs 'stat'
						
						'I find some cosmocredits in their inner pockets'
						
						
						act 'Take all the cosmocredits':
							cla						
							temp = rand(5,20) * 100						
							'I take <<temp>> cosmocredits'
							fame['pav_prostitute'] -= rand(2,7)
							crime += 3
							money += temp 
							minut += 5
							gs 'stat'
							
							act 'Run away':				
								killvar 'zadovolennia2'
								killvar 'zadovolennia3'
								fame['pav_prostitute'] += rand(1,2)
								gt 'mod_public_WC_street_sex_corner_drugs', 'end'
							end
						end
						
