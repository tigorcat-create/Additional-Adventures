		phBOX['wc'] = phBOX5['wc']
		phBOX['bed'] = phBOX5['bed']
		
	elseif $curloc = 'pav_residential' and phBOXresidential > 0 and menu_off = 0:		
		!! '<center><img <<$set_imgh>> src="mod/public_WC/newstreet/1 street/box/1 empty.jpg"></center>'
		phBOXid = 6	
		!! phboxspace1 - skiky zaniato miscia	
		phboxspace = phboxspace6
		phBoxnumberhere = phBOXresidential
		if phBoxnumberhere > 1: '<<phBoxnumberhere>> box installed together'
		
		
		
		phBOX['shower'] = phBOX6['shower']
		phBOX['table'] = phBOX6['table']
		phBOX['wc'] = phBOX6['wc']
