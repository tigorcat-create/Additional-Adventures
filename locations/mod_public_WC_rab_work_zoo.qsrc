if $ARGS[0] = 'end':
	*clr & cla
	killvar 'dodatkovi'
	pcs_stam  -= rand(40,90)
	if ztemp = 555: pcs_stam  += rand(60,70)
	if ztemp = 556: pcs_stam  -= rand(0,50)
	ztemp = 0
	if pcs_stam  <= 0:
		pcs_stam = 0
		'I''m very tired, everything floats before my eyes… I plunge into the dark nothing…'


		act 'continue': gt 'mod_public_WC_rab_work_zoo', 'tired'
	else
		pcs_stam += stammax/100
		'go to my cage'
		'<center><video autoplay loop <<$set_imgh>> src="mod/public_WC/zoo/zoo/wait/klitka.mp4"></video></center>'
		act 'wait': gt 'mod_public_WC_rab_work_zoo', 'show'
	end
end


if $ARGS[0] = 'tired':
	*clr & cla
	killvar 'dodatkovi'
	temp = 9 - bhour
	shtraf += rand(0,temp)
	temp = rand(6,30) * 10
	minut += temp
	if temp > 120:
		pcs_sleep += 35
	else
		pcs_sleep += 15
	end
	pcs_stam += temp/2
	'I woke up'
	'"manager" looks angry'
	'You are too weak for this job or you need more practice, I don''t know. But…'
	if groshi > 0:
		'…You earned some money and it solve some problems, now go away'
		groshi = groshi / 500
		shtraf -= groshi
		if shtraf < 0: shtraf = 0
	else
		'…you are in a big trouble!'
	end
	groshi = 0
	gs 'stat'
	act 'continue': gt 'mod_public_WC_rab_work', 'room'
end

