					act 'continue': gt 'mod_public_WC_rab_work_chystota_hotel', 'sex'
				end
			end
			
			act 'sorry, to much work': gt 'mod_public_WC_rab_work_chystota_hotel', 'nomer_full'
			
			act 'Yes, you can': gt 'mod_public_WC_rab_work_chystota_hotel', 'sex'
			if sexcorrupt >= rand(50,70):
				cla
				+$OpenInnerThought+'I can''t resist, I want!'+$CloseInnerThought
				act 'continue': gt 'mod_public_WC_rab_work_chystota_hotel', 'sex'
			end
		else
			'"But you better dressup"'
			hehorny = 0
			act 'Get dressed':
				cla
				minut+=3
				gs 'outfit', 'wear_last_worn'
				'I put my clothes back on.'
				gs 'stat'
				'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/work/serving/serv/dress.jpg"></center>'
				
				'"Thank you, I need to work, and your naked budy will distract me"'
				act 'continue': gt 'mod_public_WC_rab_work_chystota_hotel', 'nomer_full'
			end
		end
	end	
	
	if rand(1,100) >= 95:
		*clr & cla
		'I hear someone closed the door'
		'I go to see who is that'
		phroomfull = 0
		
		'The room is empty.'
		act 'continue': gt 'mod_public_WC_rab_work_chystota_hotel', 'nomer_empty'
	end
end
