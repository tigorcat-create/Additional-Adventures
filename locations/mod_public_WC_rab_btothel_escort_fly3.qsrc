# mod_public_WC_rab_btothel_escort_fly3
if $ARGS[0] = 'kayuta':
	*clr & cla	
	gs 'mod_public_WC_rab_btothel_escort_place', 'phescortfun'
	'<center><img <<$set_imgh>> src="mod/public_WC/escort/2 place/2 yacht/yacht/kayuta/inkayuta.jpg"></center>'	
	
	if phcook = 1:	
		'I have made a good <<$phboatmeal>>'
		killvar 'phcook'
		killvar 'phboatmeal'
	end
	
	!! bring food to the top
	if phboatfood = 2: phboatfood = 3
	
	if phboatfood <= 1 and (hour < 22 or hour > 5):
		act 'bring food up to the deck':
			minut += 30
			if pcs_servng < 100:servng_exp += rand (0,2)
			gs 'stat'
			phfoodhere += 10
			phboatfood = 3				
			gt 'mod_public_WC_rab_btothel_escort_fly', 'yacht'
		end
	end
	
	!! naked_makefood ->	
	act 'Cook smth':
		*clr & cla
		if $clothingworntype ! 'nude':
			'<center><img <<$set_imgh>> src="mod/public_WC/escort/2 place/2 yacht/yacht/kayuta/bikini_makefood.png"></center>'
		else
			'<center><img <<$set_imgh>> src="mod/public_WC/escort/2 place/2 yacht/yacht/kayuta/naked_makefood.jpg"></center>'
		end	
		phcook = 1	
		
		act 'Cook some meat stew (1:00)': 
			cla
			if pcs_servng < 100:servng_exp += rand (0,2)
			minut += 60
			phmyfood += 1
			gs 'stat'
			$phboatmeal = 'meat stew'
			gt 'mod_public_WC_rab_btothel_escort_fly3', 'kayuta'
		end
		
		act 'Cook some mushroom soup (0:30)': 
			cla
			if pcs_servng < 100:servng_exp += rand (0,1)
			minut += 30
			phmyfood += 1
			gs 'stat'
			$phboatmeal = 'mushroom soup'
			gt 'mod_public_WC_rab_btothel_escort_fly3', 'kayuta'
		end	
	
		act 'Cook some mushrooms (0:30)':
			cla
			if pcs_servng < 100:servng_exp += rand (0,1)
			minut += 30
			phmyfood += 1
			gs 'stat'
			$phboatmeal = 'mushrooms'
			gt 'mod_public_WC_rab_btothel_escort_fly3', 'kayuta'
		end
			
			
		act 'Cook some fish(1:00)':
			cla
			if pcs_servng < 100:servng_exp += rand (0,2)
			minut += 60
			phmyfood += 1
			gs 'stat'
			$phboatmeal = 'fish'
			gt 'mod_public_WC_rab_btothel_escort_fly3', 'kayuta'
		end
	end
	
	act 'Read': gt 'mod_public_WC_rab_btothel_escort_fly2', 'stackmagazines'
	
	act 'Go to the WC':		
		gt 'mod_public_WC_rab_btothel_escort_fly2', 'shower1'		
	end
	
	if $clothingworntype ! 'nude':
		act 'undress':
			minut += 3									
			gs 'clothing', 'strip'
			gs 'stat'
		end
	else
		act 'dress up':
			gs 'outfit', 'wear_last_worn'
			'I put my clothes back on.'
			gs 'stat'
		end
	end
	
	if clientsleep = 1:
		if rand (1,5) = 1:
			'<<$phclientname>> wakes up'
			clientsleep = 0
		else
			'<<$phclientname>> is sleeping'
		end
	 
		gs 'mod_public_WC_rab_btothel_escort_fly2', 'kayutahe'
	elseif rand(1,12) = 1:
		'<<$phclientname>> comes here'
		'He is prepearing to sleep'	
		clientsleep = 1	
		
		gs 'mod_public_WC_rab_btothel_escort_fly2', 'kayutahe'
	else
		if pcs_horny >= 50:
			act 'Masturbate':
				*clr & cla
				'<center><video width="<<WCvideoweight>>" autoplay loop src="mod/public_WC/escort/2 place/2 yacht/yacht3/0 he live/masturb.mp4"></video></center>'
				phescortfun += rand(2,6)	
				gs 'arousal', 'masturbate', 15				
				gs 'stat'
				
				act 'stop': gt 'mod_public_WC_rab_btothel_escort_fly3', 'kayuta'
				
				act 'Keep masturbate':
					*clr
					'<center><video width="<<WCvideoweight>>" autoplay loop src="mod/public_WC/escort/2 place/2 yacht/yacht3/0 he live/masturb.mp4"></video></center>'
					phescortfun += rand(2,6)	
					gs 'arousal', 'masturbate', 15
					minut -= 10
					gs 'stat'
				end
			end
		end
	end

	gs 'mod_public_WC_rab_btothel_escort_fly2', 'foodup'	
	
	if hour >= 22 or hour <= 5:
		clientsleep = 1
		
		act 'sleep':
			cla			
			$loc = 'mod_public_WC_rab_btothel_escort_fly3'
			$menu_loc = 'mod_public_WC_rab_btothel_escort_fly3'
			$loc_arg = 'kayuta'
			$menu_arg = 'kayuta'
			$locM = 'mod_public_WC_rab_btothel_escort_fly3'
			$locM_arg = 'kayuta'
			menu_off = 0
			
			act 'continue': gt 'mod_public_WC_rab_btothel_escort_fly3', 'kayuta'
			
			if pcs_sleep >= 50 and pcs_sleep <= 90:			
				pcs_sleep += 50
				pcs_health += 20
				minut += 180
				gs 'stat'
				*nl
				'I slept for few hours.'
				'<center><img <<$set_imgh>> src="mod/public_WC/escort/2 place/2 yacht/yacht/kayuta/naked_sleep-read.jpg"></center>'
			elseif pcs_sleep < 50:
				*clr & cla			
				gs 'stat'
				gt 'pre_sleep', 'prepare_sleep'
				'<center><img <<$set_imgh>> src="mod/public_WC/escort/2 place/2 yacht/yacht/kayuta/naked_sleep-read.jpg"></center>'
			else
				minut += 5
				gs 'stat'
				*nl
				'I am not tired enough to sleep, even for a short nap.'				
			end
		end
		
		'It is cold and dark outside. I don''t want to go there.'
		if phescortfun >= 30:
			*clr & cla
			'<<$phclientname>> enters the cabin. He prepared his bed to sleep'
			'Then he starts groping me and kissing…'
			gs 'arousal', 'kiss', 10
			gs 'stat'
			
			act 'sex':
				$cum1 = rand (80,120)
				gt 'mod_public_WC_rab_btothel_escort_fly2', 'insex'	
			end
		else
			'<<$phclientname>> is sleeping'
		end
	else
		act 'go to the deck':
			*clr & cla
			if $clothingworntype ! 'nude':
				'<center><img <<$set_imgh>> src="mod/public_WC/escort/2 place/2 yacht/yacht/kayuta/bikini_goout ('+rand(1,2)+').jpg"></center>'
			else
				'<center><img <<$set_imgh>> src="mod/public_WC/escort/2 place/2 yacht/yacht/kayuta/naked_goout.jpg"></center>'
			end			
			
			wait 1000
			gt 'mod_public_WC_rab_btothel_escort_fly', 'yacht'
		end
	end	
end


if $ARGS[0] = 'shoot':
	*clr & cla
	!! look the shootgun closer
	minut += 10
	gs 'stat'
	'There is a shootgun and ammo for it'
	'<img <<$set_imgh>> src="mod/public_WC/escort/2 place/2 yacht/yacht/actions/shooting/gun.jpg">' & '<img <<$set_imgh>> src="mod/public_WC/escort/2 place/2 yacht/yacht/actions/shooting/ammo.jpg">'
	
	act 'go away': gt 'mod_public_WC_rab_btothel_escort_fly', 'yacht'
	
	act 'shoot': gt 'mod_public_WC_rab_btothel_escort_fly3', 'shootplates'
	
	if rand(1,4) = 1 or tutammo > 0:
		'Also there are some other ammo'
		if tutammo <= 0: tutammo = rand(1,5)		
		act 'take the "other" ammo':
			ammo += tutammo
			killvar 'tutammo'
			gt 'mod_public_WC_rab_btothel_escort_fly3', 'shoot'
		end
	end
	
	
	if rand(1,10) >= 8 and clientsleep ! 1 and phhedrive = 0:
		!! he comes to shoot together
		*clr & cla
		'<<$phclientname>> saw me with gun'
		'"Girl with a gun - sexy"'
		'He tap the button and start to shoot the plates'
		heshoot = 1
		acil = rand(5,15)
		'<center><img <<$set_imgh>> src="mod/public_WC/escort/2 place/2 yacht/yacht/actions/shooting/he.jpg"></center>'
		wait 1000
		'<center><img <<$set_imgh>> src="mod/public_WC/escort/2 place/2 yacht/yacht/actions/shooting/nice.jpg"></center>'
		'"Let''s shoot together"'
		
		act 'shoot': gt 'mod_public_WC_rab_btothel_escort_fly3', 'shootplates'
	end
end

if $ARGS[0] = 'shootplates':
	*clr & cla
	!! '"Sounds like a good idea, yeah, let''s shoot smth"'
	minut += 5
	gs 'stat'	
	
	if acil <= 0 or acil > 15: acil = rand(5,15)
	
	if heshoot = 1:
		'<img <<$set_imgh>> src="mod/public_WC/escort/2 place/2 yacht/yacht/actions/shooting/he.jpg">'
		
		if rand (1,3) = 1: 
			'<img <<$set_imgh>> src="mod/public_WC/escort/2 place/2 yacht/yacht/actions/shooting/nice.jpg">'
		else
			'He mised'
		end
	end
	
	act 'tap the button':
		*clr & cla
		'<img <<$set_imgh>> src="mod/public_WC/escort/2 place/2 yacht/yacht/actions/shooting/me.jpg">'
		if acil > 1: acil -= 1
		
		tirkoef = pcs_agil + pcs_shoot
		tirmin = tirkoef * 20 / 100
		tirand = rand(tirkoef - tirmin *130 / 100, tirkoef + tirmin)
		
		gs 'exp_gain', 'shoot', 1
		wait 500
		
		if tirand >= 80:						
			pcs_mood += 5
			'I hit this'
			'<img <<$set_imgh>> src="mod/public_WC/escort/2 place/2 yacht/yacht/actions/shooting/nice.jpg">'			
		elseif tirand >= 50:
			if rand(1,10) > 3:
				'I hit this'
				'<img <<$set_imgh>> src="mod/public_WC/escort/2 place/2 yacht/yacht/actions/shooting/nice.jpg">'
			else 
				'I missed'
			end
		elseif tirand >= 30:
			if rand(1,10) > 5:
				'I hit this'
				'<img <<$set_imgh>> src="mod/public_WC/escort/2 place/2 yacht/yacht/actions/shooting/nice.jpg">'
			else
				'I missed'
			end
		elseif tirand >= 15:
			if rand(1,10) > 8:
				'I hit this'
				'<img <<$set_imgh>> src="mod/public_WC/escort/2 place/2 yacht/yacht/actions/shooting/nice.jpg">'
			elseif rand(1,10) > 7:
				'I hit this'
				'<img <<$set_imgh>> src="mod/public_WC/escort/2 place/2 yacht/yacht/actions/shooting/nice.jpg">'
			else				
				'I missed'
			end
		end
		
		act 'continue': gt 'mod_public_WC_rab_btothel_escort_fly3', 'shootplates'
	end
	
	act 'go away':
		if heshoot = 1:			
			if acil <= 1:
				cla
				'"Yup, let''s go"'
				killvar 'heshoot'
				killvar 'acil'
				
				act 'Go': gt 'mod_public_WC_rab_btothel_escort_fly', 'yacht'
			else
				'<<$phclientname>> stoped me. - "Make me a company, shoot <<acil>> more plates."'
				'"Sure" - I respond'
			end
		else
			gt 'mod_public_WC_rab_btothel_escort_fly', 'yacht'
		end
	end
end
