# mod_public_WC_rab_btothel_escort_fly_pirat_RUN
if $ARGS[0] = 'start':
	if bcil = 1:
		*clr & cla
		'<center><img <<$set_imgh>> src="mod/public_WC/escort/2 place/2 yacht/pirat/cayta/tied_wait ('+rand(1,3)+').jpg"></center>'
		$clothingworntype = 'nude'
		'Yacht had stoped…'
		minut += rand(60,120)
		'I am sitting tied and wait.'
		'In some time our yacht just move on.'
		'If I will not be tied, I could escape the yacht next time'
		phboatend = daystart + rand(2,3)
		
		act 'wait': gt 'mod_public_WC_rab_btothel_escort_fly_pirat', 'start'
	else			
		*clr & cla
		'<center><img <<$set_imgh>> src="mod/public_WC/escort/2 place/2 yacht/yacht/kayuta/inkayuta.jpg"></center>'			
		'Yacht had stoped…'
		'I see some haven in the window'
		
		if hour <= 6 or hour >= 22:
			'<center><img <<$set_imgh>> src="mod/public_WC/escort/2 place/2 yacht/yacht3/havon_N.jpg"></center>'	
		else
			'<center><img <<$set_imgh>> src="mod/public_WC/escort/2 place/2 yacht/yacht3/havon_D.jpg"></center>'	
		end
		
		phboatend = daystart + rand(4,6)
		act 'wait':
			minut += 60
			gs 'stat'
			gt 'mod_public_WC_rab_btothel_escort_fly_pirat', 'start'
		end
		
		act 'Try to escape the Yacht':
			*clr & cla				
			'<center><img <<$set_imgh>> src="mod/public_WC/escort/2 place/2 yacht/yacht/kayuta/inkayuta.jpg"></center>'
			
			if $clothingworntype = 'nude':
				act 'Get dressed':
					cla
					minut+=3
					gs 'outfit', 'wear_last_worn'
					'I put your clothes back on.'
					gs 'stat'
					act 'continue': gt 'mod_public_WC_rab_btothel_escort_fly_pirat', 'start'
				end
			end
			
			phslaveship = 0
			killvar 'phslaveship'
			killvar 'phboatend'				
			
			
			act 'exit the cabin':
				*clr & cla
				'There is no pirate outside my cabin… I sneak out to the deck.'
				'Somehow there are noone here too… I think they all goes to the city…'
				
				act 'jump from the yacht':
					*clr & cla
					minut += rand(10,15)
					gs 'stat'
					'<center><video width="<<WCvideoweight>>" autoplay loop src="mod/public_WC/escort/2 place/2 yacht/yacht2/run from the ship/2 jump.mp4"></video></center>'
					
					act 'Swim away':
						*clr & cla
						'<center><img <<$set_imgh>> src="mod/public_WC/escort/2 place/2 yacht/yacht2/run from the ship/4 swim.jpg"></center>'
						'I use all my force to be as far as I could from the ship!'
						
						minut += rand(120,240)
						gs 'stat'
						
						act 'continue':
							*clr & cla
							'When I reach the shore I run till I find local police'
							'I tell them the whole story, they do nothing, except put me on the train to my city'
							'<center><img <<$set_imgh>> src="mod/public_WC/escort/2 place/2 yacht/yacht2/run from the ship/7 cop.jpg"></center>'
							
							act 'arrive to the pavlovsk':
								minut += rand(9,12)*60
								gs 'mod_public_WC_rab_SHIPOWNED', 'noship'
								gs 'stat'								
								gt 'pav_train_hall'									
							end
						end
					end
				end
			end
		end
	end
end
--- mod_public_WC_rab_btothel_escort_fly_pirat_RUN ---------------------------------

