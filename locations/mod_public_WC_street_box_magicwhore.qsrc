	if PHmwrstat >= 60 and PHmwrstat < 70: $PH_mwhore_relationship = '<font color = yellow	> __________███████___ </font> '
	if PHmwrstat >= 50 and PHmwrstat < 60: $PH_mwhore_relationship = '<font color = yellow	> __________██████____ </font> '
	if PHmwrstat >= 40 and PHmwrstat < 50: $PH_mwhore_relationship = '<font color = yellow	> __________█████_____ </font> '
	if PHmwrstat >= 30 and PHmwrstat < 40: $PH_mwhore_relationship = '<font color = yellow	> __________████______ </font> '
	if PHmwrstat >= 20 and PHmwrstat < 30: $PH_mwhore_relationship = '<font color = yellow	> __________███_______ </font> '
	if PHmwrstat >= 10 and PHmwrstat < 20: $PH_mwhore_relationship = '<font color = yellow	> __________██________ </font> '
	if PHmwrstat >= 05 and PHmwrstat < 10: $PH_mwhore_relationship = '<font color = yellow	> __________█________ </font> '
	if PHmwrstat >= -4 and PHmwrstat < 5: $PH_mwhore_relationship = $func('wrap', 'accent', ' ___________________ ') + ' '
	if PHmwrstat > -10 and PHmwrstat <= -5: $PH_mwhore_relationship = '<font color = black	> _________█_________ </font> '
	if PHmwrstat > -20 and PHmwrstat <= -10: $PH_mwhore_relationship = '<font color = black	> ________██_________ </font> '
	if PHmwrstat > -30 and PHmwrstat <= -20: $PH_mwhore_relationship = '<font color = black	> _______███_________ </font> '
	if PHmwrstat > -40 and PHmwrstat <= -30: $PH_mwhore_relationship = '<font color = black	> ______████_________ </font> '
	if PHmwrstat > -50 and PHmwrstat <= -40: $PH_mwhore_relationship = '<font color = black	> _____█████_________ </font> '
	if PHmwrstat > -60 and PHmwrstat <= -50: $PH_mwhore_relationship = '<font color = black	> ____██████_________ </font> '
	if PHmwrstat > -70 and PHmwrstat <= -60: $PH_mwhore_relationship = '<font color = black	> ___███████_________ </font> '
	if PHmwrstat > -80 and PHmwrstat <= -70: $PH_mwhore_relationship = '<font color = black	> __████████_________ </font> '
	if PHmwrstat > -90 and PHmwrstat <= -80: $PH_mwhore_relationship = '<font color = black	> _█████████_________ </font> '
	if PHmwrstat > -101 and PHmwrstat <= -90: $PH_mwhore_relationship = '<font color = black	> ██████████_________ </font> '

	'<<$PH_mwhore_relationship>>'
	if PHmwrstat > 0:
		'Light Forces <<PHmwrstat>>% relationship'
	elseif PHmwrstat < 0:
		phitemp = PHmwrstat * (-1)
		'Dark Forces <<phitemp>>% relationship'
		killvar 'phitemp'
	else
		'Absolute neutral'
	end
end



if $ARGS[0] = 'consanguinity':
	!! gs 'mod_public_WC_street_box_magicwhore', 'consanguinity'
	'Light Forces consanguinity level is <<PH_consanguinity_L>>/4'
	'Dark Forces consanguinity level is <<PH_consanguinity_D>>/4'	
end






























