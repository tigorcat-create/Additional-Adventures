					'<center><img <<$set_imgh>> src="mod/public_WC/escort/3 event/try to rob/3 tied/binding/1 tape/tape ('+rand(2,3)+').jpg"></center>'
				end

				act 'wait': gt 'mod_public_WC_robed', 'start2'
			end
		end
	end
end




