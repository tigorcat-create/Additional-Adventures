# mod_public_WC_rab_Artem
if $ARGS[0] = 'start':	
	if week <= 5 and Artem ! 2:
		Artem = 0 
		if vtecha = 0:
			if hour >= 14 and hour <= 19:
				*nl
				temp = rand(1,5)
				if temp = 1:
					'Artem here.'
					Artem = 1
				else
					temp = rand(25,50)
					if pcs_observ >= temp:
						'I see Artem stalks me…'
						'Intresting, how often do he do that?'
						observ_exp += rand(1,2)
						Artem = 1
					elseif  Tolik ! 1 and Vania ! 1 and pcs_observ >= temp * 3 / 4:
						'I feels like someone is watching me…'
						observ_exp += rand(0,1)
						Artem = 1
						Ahide = 1
					else						
						Artem = 1 
						Ahide = 1
					end
				end
			end
		end

		if $metka = 'spat1':
			if (hour >= 0 and hour <= 5) or (hour >= 23):
				*nl
				'Artem is sleeping'
				Artem = 3
			end
		end
		if $metka = 'dvir':
			if hour = 20:
				*nl
