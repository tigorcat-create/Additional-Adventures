					'Artem reads'
				else
					'Artem washes the dishes'
				end
				Artem = 1
			elseif hour = 12:
				*nl
				'Artem do something for dinner'
				Artem = 1
			end
		end
		if $metka = 'vhid': 
			if hour = 21: 
				*nl
				Artem = 1
			end
		end
	end

	if week = 6 and Artem ! 2:
