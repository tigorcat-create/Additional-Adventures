				gs 'cum_call', 'face', $npclastgenerated, 0
				gs 'cum_call', 'mouth', $npclastgenerated, 0
				gs 'cum_call', 'stomach', $npclastgenerated, 0
				gs 'cum_call', 'breasts', $npclastgenerated, 0
			end
			gs 'arousal', 'end'
			gs 'stat'
			act 'continue': gt $PHloc, $PHloc_arg
		end
	end
end


