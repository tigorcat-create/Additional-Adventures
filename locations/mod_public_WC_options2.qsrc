if $start_type[1] ! 'nomagic':
	' '
else
	if PHmagic = 0:
		'All magic is OFF'
		act 'MAGIC settings':
			cla
			'All magic is OFF'
			
			act 'Enable magic': 
				PHmagic = 1
				pcs_magik += 100
				'All magic is ON'
			end
			
			act '<b>Return</b>': gt 'mod_setting'
		end
	elseif PHmagic = 1:
		'All magic is ON'
		act 'MAGIC settings':
			cla
			'All magic is ON'
			
			act 'Disable magic': 
				PHmagic = 0
				'All magic is OFF'
			end
			
			act '<b>Return</b>': gt 'mod_setting'
		end
	end
end

act 'Change chance to meet a girl in the Glory hole':
	'TYou can met a girl only after 13:00'
	'current chance: <<CHANCE_MEET_HER_GH>>%'
	act 'make it 100%': CHANCE_MEET_HER_GH = 100 & 'current chance: <<CHANCE_MEET_HER_GH>>%'	
	act '+10%': CHANCE_MEET_HER_GH += 10 & 'current chance: <<CHANCE_MEET_HER_GH>>%'
	act '+5%': CHANCE_MEET_HER_GH += 5 & 'current chance: <<CHANCE_MEET_HER_GH>>%'
	act '+1%': CHANCE_MEET_HER_GH += 1 & 'current chance: <<CHANCE_MEET_HER_GH>>%'	
	act '-1%': CHANCE_MEET_HER_GH -= 1 & 'current chance: <<CHANCE_MEET_HER_GH>>%'	
	act '-5%': CHANCE_MEET_HER_GH -= 5 & 'current chance: <<CHANCE_MEET_HER_GH>>%'
	act '-10%': CHANCE_MEET_HER_GH -= 10 & 'current chance: <<CHANCE_MEET_HER_GH>>%'
	act 'make it 0%': CHANCE_MEET_HER_GH = 0 & 'current chance: <<CHANCE_MEET_HER_GH>>%'	
end
act 'Change the glory hole colegue whore skills':
	temp = SHE_SLUT_LEVEL_GH*100 / 90
	if temp = 100: 
		'She is as slutty as a default'
	elseif temp > 100: 
		temp -= 100
		'She is <<temp>>% more slut'
	else
		temptemp = (temp - 100)*(-1)
		'She is <<temptemp>>% less slut'		
	end

	act 'Change to default':
		SHE_SLUT_LEVEL_GH = 90	
		'She is as slutty as a default'	
	end
	act '+10% whore skills':
		SHE_SLUT_LEVEL_GH += 10
		if SHE_SLUT_LEVEL_GH <= 10: 
			'She can''t be less skilled'
			SHE_SLUT_LEVEL_GH = 10
		end
		temp = SHE_SLUT_LEVEL_GH*100 / 90
		if temp = 100: 
			'She is as slutty as a default'
		elseif temp > 100: 
			temp -= 100
			'She is <<temp>>% more slut'
		else
			temptemp = (temp - 100)*(-1)
			'She is <<temptemp>>% less slut'		
		end
	end
	act '-10% whore skills':
		SHE_SLUT_LEVEL_GH -= 10
		if SHE_SLUT_LEVEL_GH <= 10: 
			'She can''t be less skilled'
			SHE_SLUT_LEVEL_GH = 10
		end
		temp = SHE_SLUT_LEVEL_GH*100 / 90
		if temp = 100: 
			'She is as slutty as a default'
		elseif temp > 100: 
			temp -= 100
			'She is <<temp>>% more slut'
		else
			temptemp = (temp - 100)*(-1)
			'She is <<temptemp>>% less slut'		
		end
	end		
end
act 'Glory hole together: Change of angree clients gang bang ':
	temp = 4 - agreesive_GH_publick
	'At least <<temp>> unserved clients needed to trigger a gang bang event'

	act'change to the default':
		agreesive_GH_publick = 1
		temp = 4 - agreesive_GH_publick
		'At least <<temp>> unserved clients needed to trigger a gang bang event'		
	end
	act 'make it 1 unserved client less':
		agreesive_GH_publick += 1
		temp = 4 - agreesive_GH_publick
		'At least <<temp>> unserved clients needed to trigger a gang bang event'	
	end
	act 'make it 1 unserved client more':
		agreesive_GH_publick -= 1
		temp = 4 - agreesive_GH_publick
		'At least <<temp>> unserved clients needed to trigger a gang bang event'	
	end	
end


act '<b>Return</b>': gt 'mod_setting'



