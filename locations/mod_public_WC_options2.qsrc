# mod_public_WC_options2
*clr & cla



'<center><h2>Public WC mod Settings</h2></center>'
'<center><h2>v. 3.48<<$mod_info[1]>></h2></center>'


if WCzoo > 0:
	cla	
	'Beasts interactions ON'
	act 'disable beast interactions':
		WCzoo = 0
		gt 'mod_public_WC_options2'
	end
else
	cla
	'Beasts interactions OFF'
	act 'enable beast interactions':
		WCzoooff = 1
		WCzoo = 1
		gt 'mod_public_WC_options2'
	end
end

if noeventGH = 0:
	'Glory hole events ON'
	act 'disable all Glory hole events':
		noeventGH = 1
		gt 'mod_public_WC_options2'
	end
else
	'Glory hole events OFF'
	act 'enable all Glory hole events':
		noeventGH = 0
		gt 'mod_public_WC_options2'
	end
end



act 'change the video width':
	*clr & cla
	'Current video width is <<WCvideoweight>>'
	act 'Change to 100': WCvideoweight = 100 & 'Now the video width is <<WCvideoweight>>'
	act 'Change to 200': WCvideoweight = 200 & 'Now the video width is <<WCvideoweight>>'
	act 'Change to 300': WCvideoweight = 300 & 'Now the video width is <<WCvideoweight>>'
	act 'Change to 400': WCvideoweight = 400 & 'Now the video width is <<WCvideoweight>>'
	act 'Change to 500': WCvideoweight = 500 & 'Now the video width is <<WCvideoweight>>'
	act 'Change to 600': WCvideoweight = 600 & 'Now the video width is <<WCvideoweight>>'
	act 'Change to 700': WCvideoweight = 700 & 'Now the video width is <<WCvideoweight>>'
	act 'Change to 800': WCvideoweight = 800 & 'Now the video width is <<WCvideoweight>>'
	act 'Change to 900': WCvideoweight = 900 & 'Now the video width is <<WCvideoweight>>'
	act 'Change to 1000': WCvideoweight = 1000 & 'Now the video width is <<WCvideoweight>>'
	
	act '<b>Return</b>': gt 'mod_setting'
end

Act 'SHOW CHEATS':
	act 'add 10 words': slova += 10 & gs 'stat'
	act 'add 1000 words': slova += 1000 & gs 'stat'

	act 'give me a gun':
		gun = 1
		ammo += 10
		gs 'stat'
	end
	
	act 'clear all my crimes': crime = 0 & gs 'stat'
	
	act '+1 symbol in the Pleasure House': ryska += 1 & gs 'stat'
	
	act '+10% to sex corrupt': sexcorrupt += 10 & gs 'stat'
	act '-10% to sex corrupt': 
		sexcorrupt -= 10
		if sexcorrupt < 0: sexcorrupt = 0
		gs 'stat'
	end
	
	
	act '+1 hour to the stag party of the FUN room client':
		stagtime +=1
		'stat'
		'Current stag party extra time is <<stagtime>> hours'
	end
	act '-1 hour to the stag party of the FUN room client':
		stagtime -=1
		if stagtime <= 0: stagtime = 0
		'stat'
		'Current stag party extra time is <<stagtime>> hours'
	end	

	act '+10% submited to Vania': 
		VaniaMayster += 10		
		if VaniaMayster >= 120: VaniaMayster = 120
		gs 'stat'
	end	
	act '-10% submited to Vania': 
		VaniaMayster -= 10		
		if VaniaMayster <= 0: VaniaMayster = 0
		gs 'stat'
	end	
	
	act 'Change the "robber event" chances during escort in the villa':
		act 'chances +10%':
			phroberchances -= 1
			i = phroberchances * (-1) * 15 + 15
			'Now there is a <<i>>% chance of the event triggered'
		end
		act 'chances -10%':
			phroberchances += 1
			i = phroberchances * (-1) * 15 + 15
			'Now there is a <<i>>% chance of the event triggered'
		end
		act 'Change to default':
			phroberchances = 0
			i = phroberchances * (-1) * 15 + 15
			'Now there is a <<i>>% chance of the event triggered'
		end
	end
end

