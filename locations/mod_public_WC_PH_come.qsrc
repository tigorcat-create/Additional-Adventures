	$locM_arg = 'start'
	CLOSE ALL
	gs 'stat'


	$func('wrap', 'header center b', 'The bus stop to the Pleasure house')
	if month >= 11 or month < 4:
		'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/work/BUSSTOP.jpg"></center>'
	else
		'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/work/BUSSTOPl.jpg"></center>'
	end

	if hour >= 23:
		'The marshrutka is here'
		'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/work/BUS.jpg"></center>'
		act 'sit in the marshrutka': gt 'mod_public_WC_PH_come','ride'
