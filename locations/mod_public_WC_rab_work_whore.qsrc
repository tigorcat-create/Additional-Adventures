		if bcil >= 21 and bcil <= 30: '<center><img <<$set_imgh>> src="mod/public_WC/lisrab/work/serving/serv/3.jpg"></center>'
		if bcil >= 31 and bcil <= 37: '<center><img <<$set_imgh>> src="mod/public_WC/lisrab/work/serving/serv/2.jpg"></center>'		
	end

	phtemph = hour + rand(2,3)
	colir = rand(1,2)
	if otemp = 0: otemp = 1
	if phtemph > 24: phtemph -= 24
end












