			act'Go to balcony': minut += 3 & gt 'mod_public_WC_rab_work', 'balcony'
			act'Go to office': minut += 8 & gt 'mod_public_WC_rab_work', 'office'
			act'Go to dancefloor': minut += 8 & gt 'mod_public_WC_rab_work', 'dancefloor'
		end
		act 'Nod "No"':
			cla
			if bcil > 20:
				'Of course, he waited <<bcil>> minuts. No wonder.'
				temp = rand(bcil,100)
				IF temp >= 70: shtraf += 1
			end
			if bcilg > 0:
				'I''m sure you also broke the glasses on the way.'
				if bcilg <= 1:
					temp = rand(1,8)
				elseif bcilg <= 3:
					temp = rand(1,6)
				elseif bcilg <= 5:
					temp = rand(1,2)
				end
				IF temp = 1: shtraf += 1
				bcilg = 0
			end
			if bcil = 0: 'Ok, then let''s deal with it.'
