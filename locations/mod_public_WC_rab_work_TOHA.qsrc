				'I don''t wear such heels confidently'
			end
		end
	end
	if hour >= 9 and hour < 21 and bglass > 0: 'Take the last order and come to me, your shift is over.'
	if bglass = 0:
		'Is the customer satisfied?'
		act 'Nod "yes"':
			cla
			temp = rand(0,3)
			if bcil ! 0: shtraf += temp
