	'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/work/serving/TOHA.jpg"></center>'
	if pcs_heels - 75 < 0:
		temp = rand(pcs_heels,100)
		if temp <= 75:
			if 75 - temp >= 60:
				'I feel like a cow on ice with heels like that,'
			elseif 75 - temp >= 50:
				'I feel like a cow on ice with heels like that,'
			elseif 75 - temp >= 30:
				'I feel like walking on a tightrope on heels like that,'
			elseif 75 - temp >= 15:
				'It''s hard for me to walk, but somehow I keep my balance'
