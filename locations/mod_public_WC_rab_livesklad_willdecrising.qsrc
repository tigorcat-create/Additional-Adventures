							gs 'pain', rand(0,1), 'legL', 'labor'
							gs 'pain', rand(0,1), 'legR', 'labor'
							gs 'pain', rand(0,1), 'shoulders', 'labor'
							gs 'pain', rand(0,1), 'armL', 'labor'
							gs 'pain', rand(0,1), 'armr', 'labor'
							gs 'pain', rand(0,1), 'chest', 'labor'
							ztemp = 1
							gs 'stat'

							act 'wait': gt 'mod_public_WC_rab_livesklad_willdecrising', 'ny2'
						end
					end
				end
			end
		end
	end
end

if $ARGS[0] = 'ny2':
	*clr & cla
	ztemp += 1
	minuts += rand (15,30)
	temp = rand(1,4)
	if temp = 1: 'Because of the awkward posture the body hurts'
	if temp = 2: 'When will it end ?!'
	if temp = 3: 'Aaaaaaa'
	if temp = 4: 'My body hurts…'


	'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/Vania/trener/willdecrising/ny/7NY_tree.jpg"></center>'

	gs 'pain', rand(0,1), 'back', 'labor'
	gs 'pain', rand(0,1), 'hips', 'labor'
	gs 'pain', rand(0,1), 'thighs', 'labor'
	gs 'pain', rand(0,1), 'legL', 'labor'
	gs 'pain', rand(0,1), 'legR', 'labor'
	gs 'pain', rand(0,1), 'shoulders', 'labor'
	gs 'pain', rand(0,1), 'armL', 'labor'
	gs 'pain', rand(0,1), 'armr', 'labor'
	gs 'pain', rand(0,1), 'chest', 'labor'
	gs 'stat'

	act 'wait as a tree…': gt 'mod_public_WC_rab_livesklad_willdecrising', 'ny2'

	if ztemp >= rand(4,6):
		cla
		'Vania comes back'
		'"Hello my new year happiness)))"'

		'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/vania/vania.jpg"></center>'

		act 'be silent':
			cla
			'I will make you a tree other time, now you can rest XD'

			gs 'stat'
			act 'Vania bring me back to the bed': gt 'mod_public_WC_rab_livesklad', 'start'
		end

		act 'please untie me':
			cla
			'"Yes, Betsi. I am not a monster, I am your Master and I want you to hear my message. And it looks like you heared it."'
			'he unties me from the garland'

			willpowermax -= rand(1,3)

			zgoda += 5
			gs 'stat'
			act 'Vania bring me back to the bed': gt 'mod_public_WC_rab_livesklad', 'start'
		end
	end
end

