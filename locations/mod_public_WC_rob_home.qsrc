# mod_public_WC_rob_home
if $ARGS[0] = 'start':
	*clr & cla	
	!! 'I hear a doorbell'
	!! 'The client is in the shower and hear nothing'
	!! act 'go open the door'
	
	minut += 5
	gs 'stat'
	phroberkilled = 0
	
	temp = rand(1,5)
	if temp = 1:
		$maskyvannia = 'A pizza guy'
		
	elseif temp = 2:
		$maskyvannia = 'A mailman'
	elseif temp = 3:
		$maskyvannia = 'A policeman'
	elseif temp = 4:
		$maskyvannia = 'A pizza guy'
	else
		$maskyvannia = 'A policeman'
	end
	
	'I stand in front of the door'
	
	'"Who is there" - I have ask'
	'"<<$maskyvannia>>" - the voice outside said'
	
	act 'open the door': gt 'mod_public_WC_rob_home', 'openthedoor'
	
	act 'look in the door viewer':
		cla
		if rand(1,3) = 1:
			'I see a <<$maskyvannia>>'			
		else
			'I see just a guy'
		end
		
		act 'open the door': gt 'mod_public_WC_rob_home', 'openthedoor'
		
		act 'we did not call any, goodbuy':
			*clr & cla
			killvar 'maskyvannia'
			phrober += rand(0,2)
			gt 'mod_public_WC_rab_btothel_escort_villa', 'nomer_full'
		end
	end
	
	act 'we did not call any, goodbuy':
		*clr & cla
		killvar 'maskyvannia'
		phrober += rand(0,2)
		gt 'mod_public_WC_rab_btothel_escort_villa', 'nomer_full'
	end
end

if $ARGS[0] = 'openthedoor':
	*clr & cla
	minut += 5
	gs 'stat'
	phrobfail = 0
	
	if rand(1,3) = 1:
		!! kidnap
		phrober = -20
		
		'I opened the door and with <<$maskyvannia>> the few in the masks run in'
		'They quikly grab me, I can''t move at all'
		'<center><img <<$set_imgh>> src="mod/public_WC/escort/3 event/try to rob/0 start/2+/opendoor.jpg"></center>'
		
		act 'screem':
			*clr & cla
			'As I tried to screem, the guy hit me in the stomach, and I loose all my air'
			'Also he closed my mouth'
			'<center><img <<$set_imgh>> src="mod/public_WC/escort/3 event/try to rob/0 start/2+/grab (1).jpg"></center>'
			gs 'pain', rand(2,4), 'tummy', 'hit'
			gs 'stat'
			
			phrobfail += 1
			
			act 'wait': gt 'mod_public_WC_rob_home', 'startin'
		end
		
		act 'wait': gt 'mod_public_WC_rob_home', 'startin'
	else
		if $maskyvannia = 'A pizza guy':			
			'The guy gives me a pizza. He said, everything paid'			
		elseif $maskyvannia = 'A mailman':
			'The guy ask me to sign and take the parcel. I did it'
		elseif $maskyvannia = 'A policeman':
			'He asked me some general questions, like "what this adress is" write smth in his note and shortly go away.'
		end
		
		act 'Go back to the client': gt 'mod_public_WC_rab_btothel_escort_villa', 'nomer_full'
	end	
	killvar 'maskyvannia'
end

if $ARGS[0] = 'startin':
	*clr & cla	
	phrober -= 1000
	
	if phrobfail = 0:
		!! scare me
		'<center><video width="<<WCvideoweight>>" autoplay loop src="mod/public_WC/escort/3 event/try to rob/0 start/scare_v.mp4"></video></center>'
	else
		!! loose
		'they put me on the floor'
		'<center><img <<$set_imgh>> src="mod/public_WC/escort/3 event/try to rob/0 start/2+/lose.jpg"></center>'
	end
	
	'"If you help us everything will be ok"'
	'"We need him, not you"'
	'"Don''t speak, just nod"'
	'"Will you help us?"'
	
	act 'nod yes':
		*clr & cla
		'<center><img <<$set_imgh>> src="mod/public_WC/escort/3 event/try to rob/0 start/2+/opendoor.jpg"></center>'
		'"Good girl" - he said with smile'
		'"Now, you will answer me, but slovly and very quiet…"'
		'"Where is he?"'
		
		act 'He is in the bathroom':
			phhimbathroom = 1
			gt 'mod_public_WC_rob_home', 'searchhim'
		end
		
		+$OpenInnerThought+'If I say he is in the sauna, they will spend time to circled it and the client will have time to save me or smth…'+$CloseInnerThought
		act 'He is in the sauna (lie)':
			phhimbathroom = 2
			gt 'mod_public_WC_rob_home', 'searchhim'
		end
	end
	
	act 'nod no':
		cla
		'I see anger in his eyes'
		'"You will regret this" - he said'
		phrobtied = 1
		phrobfail += 1
		'They tied me and gaged me'
		'<center><img <<$set_imgh>> src="mod/public_WC/escort/3 event/try to rob/0 start/2+/tide.jpg"></center>'
		
		act 'continue':
			*clr & cla	
			'<center><img <<$set_imgh>> src="mod/public_WC/escort/3 event/try to rob/0 start/2+/tide.jpg"></center>'
			'They left me in this room and go inside the house'
			
			act 'wait': gt 'mod_public_WC_rob_home', 'hefight'
		end
	end
	
	if phrobfail = 0:
		act 'screem':
			*clr & cla
			'As I tried to screem, the guy hit me in the stomach, and I loose all my air'
			'Also he closed my mouth'
			'<center><img <<$set_imgh>> src="mod/public_WC/escort/3 event/try to rob/0 start/2+/grab (1).jpg"></center>'
			gs 'pain', rand(2,4), 'tummy', 'hit'
			gs 'stat'
			
			phrobfail += 1
			
			act 'nod no':
				cla
				'I see anger in his eyes'
				'"You will regret this" - he said'
				phrobtied = 1
				phrobfail += 1
				'They tied me and gaged me'
				'<center><img <<$set_imgh>> src="mod/public_WC/escort/3 event/try to rob/0 start/2+/tide.jpg"></center>'
				
				act 'continue':
					*clr & cla	
					'<center><img <<$set_imgh>> src="mod/public_WC/escort/3 event/try to rob/0 start/2+/tide.jpg"></center>'
					'They left me in this room and go inside the house'
					
					act 'wait': gt 'mod_public_WC_rob_home', 'hefight'
				end
			end
			
			act 'nod yes':
				*clr & cla
				'<center><img <<$set_imgh>> src="mod/public_WC/escort/3 event/try to rob/0 start/2+/opendoor.jpg"></center>'
				'"Good girl" - he said with smile'
				'"Now, you will answer me, but slovly and very quiet…"'
				'"Where is he?"'
				
				act 'He is in the bathroom':
					phhimbathroom = 1
					gt 'mod_public_WC_rob_home', 'searchhim'
				end
				
				+$OpenInnerThought+'If I say he is in the sauna, they will spend time to circled it and the client will have time to save me or smth…'+$CloseInnerThought
				act 'He is in the sauna (lie)':
					phhimbathroom = 2
					gt 'mod_public_WC_rob_home', 'searchhim'
				end
			end
		end
	end
end

if $ARGS[0] = 'hefight':
	*clr & cla
	!! 'They left me in this room and go inside the house'
	!! e shans, sh4o yogo NE zalamayut
	
	minut += 20
	gs 'stat'
	'I hear swearing and shooting'
	'It continues for some time'	
	
	wait 1500
	
	if rand (1,4) = 1:
		phrober -= 80
		'the client enters the room'
		'"Ow, you alive" - now, things are better.'
		'</center><br><table width="100%" cellspacing="0" cellpadding="5"><td width="200" valign="top"><img Height = 200 src="mod/public_WC/lisrab/work/PH/SEX_ALL/he/b (<<phclientava>>).jpg"></td><td valign="top"><br>'
		
		act 'wait':
			cla
			'He made a call, smth about "cleaning"…'
			'After the call he turned his attention to me "This situation will not spoil the day, lets go clear our minds"'
			
			$phescortzara = 'street'
			$phescortude = ' '
			killvar 'heinvanna'
			killvar 'phdog'
			killvar 'phtemp'
			killvar 'hehorny'
			killvar 'PHMYROOM'
			
			act 'Go with him': gt 'mod_public_WC_rab_btothel_escort_place', 'street'
			
			act 'ask to go home':
				*clr & cla
				killvar 'zzphday'	
				'</center><br><table width="100%" cellspacing="0" cellpadding="5"><td width="200" valign="top"><img Height = 200 src="mod/public_WC/lisrab/work/PH/SEX_ALL/he/b (<<phclientava>>).jpg"></td><td valign="top"><br>'
				killvar 'phendescort'
				phescortfunNEED = 0
				phescortfunSexDONE -= 1
				if phescortfunSexDONE < 0: phescortfunSexDONE = 0
				phmoneypaid = ( phescortfunNEED * rand(500,1000) + rand(300,500) * phescortfunSexDONE ) * 50 /10000
				temp = phmoneypaid * 100
				phmoneypaid = temp
				phmoneypaidH = rand(11,17)
				phmoneypaidD = daystart + rand(1,2)
				phescortfun = 0
				killvar 'phclientava'
				killvar 'phdog'
				phescorttask = 0
				killvar 'phescortD'	
				killvar 'phescortH'
				'"Okey, girl, I understand it. I also have some… something to do"'
				'I kissed him as goodbuy and go'			
				+$OpenInnerThought+'I hope noone will search me…'+$CloseInnerThought			
				act 'Go away': gt 'city_redlight', 'start'
			end			
			
			gs 'mod_public_WC_rab_btothel_escort_place', 'phendescort'
		end
		
		act 'ask to go home':
			*clr & cla
			killvar 'zzphday'	
			'</center><br><table width="100%" cellspacing="0" cellpadding="5"><td width="200" valign="top"><img Height = 200 src="mod/public_WC/lisrab/work/PH/SEX_ALL/he/b (<<phclientava>>).jpg"></td><td valign="top"><br>'
			killvar 'phendescort'
			phmoneypaid = ( phescortfunNEED * rand(500,1000) + rand(300,500) * phescortfunSexDONE ) * 50 /10000
			temp = phmoneypaid * 100
			phmoneypaid = temp
			phmoneypaidH = rand(11,17)
			phmoneypaidD = daystart + rand(1,2)
			phescortfun = 0
			killvar 'phclientava'
			killvar 'phdog'
			phescorttask = 0
			killvar 'phescortD'	
			killvar 'phescortH'
			'"Okey, girl, I understand it. I also have some… something to do"'
			'I kissed him as goodbuy and go'			
			+$OpenInnerThought+'I hope noone will search me…'+$CloseInnerThought			
			act 'Go away': gt 'city_redlight', 'start'
		end
		
		act 'life-affirming sex?':
			cla			
			'</center><br><table width="100%" cellspacing="0" cellpadding="5"><td width="200" valign="top"><img Height = 200 src="mod/public_WC/lisrab/work/PH/SEX_ALL/he/b (<<phclientava>>).jpg"></td><td valign="top"><br>'
			'"What? I mean - Yes,… Yes, please!"'
			$cum1 = rand (100,120)
			act 'continue': gt 'mod_public_WC_rab_btothel_escort_villa', 'roomsexcycl'
		end
	else
		'One of the robers enters the room'
		'He grabs me and put in the main room, where the client is already tied sitting.'
		
		'<center><img <<$set_imgh>> src="mod/public_WC/escort/3 event/try to rob/0 start/hetied.png"></center>'
		*nl
		'<center><img <<$set_imgh>> src="mod/public_WC/escort/3 event/try to rob/3 tied/wait/2 room/tape/tape ('+rand(1,2)+').jpg"></center>'
		
		act 'wait': gt 'mod_public_WC_robed', 'start'
	end
end

if $ARGS[0] = 'searchhim':
	*clr & cla	
	'"Show us the way" - he bend my hand behind my back and start walking while holding the hand. I need to start walking too'
	
	if phhimbathroom = 1:
		!! 'He is in the bathroom'
		'I show them the bathroom door.'
		phrobfail = 0
		phrobfail -= 1
		'They are circle the bathroom door and wait'
		wait 1500
		'the door opens, as he steped out the bathroom, they pushed him to the floor and tied him'
		'the guy, who holds me push me to sit near the client'
		'<center><img <<$set_imgh>> src="mod/public_WC/escort/3 event/try to rob/0 start/hetied.png"></center>'
		
		act 'wait': gt 'mod_public_WC_robed', 'start'
		
	elseif phhimbathroom = 2:
		!! 'He is in the sauna (lie)'
		'As we pass the bathroom door, I see the light is off. Where is he?'
		wait 1500
		!! win probye vriatuvaty abo vtik
		'We turned to the corridor and…' 
		wait 1500
		if rand(1,3) ! 1:
			'…the shoot appears - "Vladimir down!"'
			'"Shit" - guy who holds me - pushes me away - "Stay here, bitch!"'
			'He runs to the previous room, where shots are fired'
			
			
			act 'wait':
				gt 'mod_public_WC_rob_home', 'hefight'
			end
			
			if gun = 1 and ammo > 0:
				'<center><img <<$set_imgh>> src="mod/public_WC/escort/3 event/try to rob/1 meshoot/hided gun.jpg"></center>'
				gs 'willpower', 'crime', 'self'
				if will_cost <= pcs_willpwr and ammo > 0:	
					act 'Shoot at the rober' + $func('willpower', 'get_willcost_string'):
						*clr & cla
						ammo -= 1
						'<center><img <<$set_imgh>> src="mod/public_WC/escort/3 event/try to rob/1 meshoot/shoot.jpg"></center>'
						gs 'willpower', 'pay', 'self'
						gs 'stat'
						
						tirkoef = pcs_agil + pcs_shoot
						tirmin = tirkoef * 20 / 100
						tirand = rand(tirkoef - tirmin*2, tirkoef + tirmin)

						if tirand >= 80:						
							pcs_mood += 5
							'I killed one!.'
							killed +=1	& phroberkilled  += 1				
							willpowermax += 5
							pcs_mood -= 40
							pcs_mood += killed
							itemp -= rand(1,3)
						elseif tirand >= 50:
							if rand(1,10) > 3:
								'I killed one!.'
								killed +=1	& phroberkilled  += 1				
								willpowermax += 5
								pcs_mood -= 40
								pcs_mood += killed
								itemp -= rand(1,3)
							else
								'I missed'
							end
						elseif tirand >= 30:
							if rand(1,10) > 5:
								'I killed one!.'
								killed +=1	& phroberkilled  += 1				
								willpowermax += 5
								pcs_mood -= 40
								pcs_mood += killed
								itemp -= rand(1,3)
							else
								'I missed'
							end
						elseif tirand >= 15:
							if rand(1,10) > 8:
								'I killed one!.'
								killed +=1	& phroberkilled  += 1				
								willpowermax += 5
								pcs_mood -= 40
								pcs_mood += killed
								itemp -= rand(1,3)
							else
								'I missed'
							end
						end
						
						gs 'exp_gain', 'shoot', 1
						
						phrobshoot = rand(1,3)
						phhefight = 0
						
						act 'continue': gt 'mod_public_WC_rob_home', 'shoot'			
					end
				elseif will_cost > pcs_willpwr:
					act 'Shoot at the rober ' + $func('wrap', 'v_neg', '(<<temp>> Willpower)'): $func('wrap', 'neg', '<br>I don''t have enough willpower to use this action.')
				end			
				if ammo < 1: 'I have NO ammo!!!'
			end
		else
			'…they search all the house. The client is not in here'
			'"Well, he ran away… shit… At least we have you"'
			'they tied me and bring somewhere'
			
			act 'wait': gt 'mod_public_WC_rob_car', 'car'
		end
	end
	killvar 'phhimbathroom'
end

