				act 'nod no':
					cla
					'I see anger in his eyes'
					'"You will regret this" - he said'
					phrobtied = 1
					phrobfail += 1
					'They tied me and gaged me'
					'<center><img <<$set_imgh>> src="mod/public_WC/escort/3 event/try to rob/0 start/2+/tide.jpg"></center>'
					
					act 'continue':
						*clr & cla	
						'<center><img <<$set_imgh>> src="mod/public_WC/escort/3 event/try to rob/0 start/2+/tide.jpg"></center>'
						'They left me in this room and go inside the house'
						
						act 'wait': gt 'mod_public_WC_rob_home', 'hefight'
