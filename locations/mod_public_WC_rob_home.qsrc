					gs 'exp_gain', 'shoot', 1					
					
					if phrobkill < 2:
						tirkoef = pcs_agil + pcs_shoot
						tirmin = tirkoef * 20 / 100
						tirand = rand(tirkoef - tirmin*2, tirkoef + tirmin)

						if tirand >= 80:						
							pcs_mood += 5
							'I killed one!.'
							phrobkill +=1
							killed +=1	& phroberkilled  += 1				
							willpowermax += 5
							pcs_mood -= 40
							pcs_mood += killed
							itemp -= rand(1,3)
						elseif tirand >= 50:
							if rand(1,10) > 3:
								'I killed one!.'
								phrobkill +=1
								killed +=1	& phroberkilled  += 1				
								willpowermax += 5
								pcs_mood -= 40
								pcs_mood += killed
								itemp -= rand(1,3)
							else
								'I missed'
							end
						elseif tirand >= 30:
							if rand(1,10) > 5:
								'I killed one!.'
								phrobkill +=1
								killed +=1	& phroberkilled  += 1				
								willpowermax += 5
								pcs_mood -= 40
								pcs_mood += killed
								itemp -= rand(1,3)
							else
								'I missed'
							end
						elseif tirand >= 15:
							if rand(1,10) > 8:
								'I killed one!.'
								phrobkill +=1
								killed +=1	& phroberkilled  += 1				
								willpowermax += 5
								pcs_mood -= 40
								pcs_mood += killed
								itemp -= rand(1,3)
							else
								'I missed'
							end
						end
						
						gs 'exp_gain', 'shoot', 1
					end
					
					if phrobkill >= 2:
						'All robers are dead on the floor'
						'Noone shooting'
						'The client comes to me, take a gun and put it on the floor, then he hugs me'
						
						act 'wait':
							cla
							'He made a call, smth about "cleaning"…'
							'After the call he turned his attention to me "This situation will not spoil the day, lets go clear our minds"'
							
							$phescortzara = 'street'
							$phescortude = ' '
							killvar 'heinvanna'
							killvar 'phdog'
							killvar 'phtemp'
							killvar 'hehorny'
							killvar 'PHMYROOM'
							
							act 'Go with him': gt 'mod_public_WC_rab_btothel_escort_place', 'street'
							
							act 'ask to go home':
								*clr & cla
								killvar 'zzphday'	
								'</center><br><table width="100%" cellspacing="0" cellpadding="5"><td width="200" valign="top"><img Height = 200 src="mod/public_WC/lisrab/work/PH/SEX_ALL/he/b (<<phclientava>>).jpg"></td><td valign="top"><br>'
								killvar 'phendescort'
								phescortfunNEED = 0
								phescortfunSexDONE -= 1
								if phescortfunSexDONE < 0: phescortfunSexDONE = 0
								phmoneypaid = ( phescortfunNEED * rand(500,1000) + rand(300,500) * phescortfunSexDONE ) * 50 /10000
								temp = phmoneypaid * 100
								phmoneypaid = temp
								phmoneypaidH = rand(11,17)
								phmoneypaidD = daystart + rand(1,2)
								phescortfun = 0
								killvar 'phclientava'
								killvar 'phdog'
								phescorttask = 0
								killvar 'phescortD'	
								killvar 'phescortH'
								'"Okey, girl, I understand it. I also have some… something to do"'
								'I kissed him as goodbuy and go'			
								+$OpenInnerThought+'I hope noone will search me…'+$CloseInnerThought			
								act 'Go away': gt 'city_redlight', 'start'
							end			
							
							gs 'mod_public_WC_rab_btothel_escort_place', 'phendescort'
						end
						
						act 'ask to go home':
							*clr & cla
							killvar 'zzphday'	
							'</center><br><table width="100%" cellspacing="0" cellpadding="5"><td width="200" valign="top"><img Height = 200 src="mod/public_WC/lisrab/work/PH/SEX_ALL/he/b (<<phclientava>>).jpg"></td><td valign="top"><br>'
							killvar 'phendescort'
							phmoneypaid = ( phescortfunNEED * rand(500,1000) + rand(300,500) * phescortfunSexDONE ) * 50 /10000
							temp = phmoneypaid * 100
							phmoneypaid = temp
							phmoneypaidH = rand(11,17)
							phmoneypaidD = daystart + rand(1,2)
							phescortfun = 0
							killvar 'phclientava'
							killvar 'phdog'
							phescorttask = 0
							killvar 'phescortD'	
							killvar 'phescortH'
							'"Okey, girl, I understand it. I also have some… something to do"'
							'I kissed him as goodbuy and go'			
							+$OpenInnerThought+'I hope noone will search me…'+$CloseInnerThought			
							act 'Go away': gt 'city_redlight', 'start'
						end	
					else
						'The rober run to me and knocked the gun out of my hands'
						gun = 0
						'he hit me hard and I fallon the floor'
						'He tied me'						
						'He grabs me and put in the main room, where the client is already tied sitting.'
						
						'<center><img <<$set_imgh>> src="mod/public_WC/escort/3 event/try to rob/0 start/hetied.png"></center>'
						*nl
						'<center><img <<$set_imgh>> src="mod/public_WC/escort/3 event/try to rob/3 tied/wait/2 room/tape/tape ('+rand(1,2)+').jpg"></center>'
						phrobtied = 1
						phrobfail += 100 * phrobkill
						
						act 'wait': gt 'mod_public_WC_robed', 'start'
					end
					killvar 'phrobkill'
				end
			end
		end		
	end	
end



if $ARGS[0] = 'invade':
	*clr & cla	
	!! heinvanna, no door bell
	phrober -= 1000
	phroberkilled = 0
	
	$func('wrap', 'header center b', '"Main room"')
	'<center><img <<$set_imgh>> src="mod/public_WC/escort/2 place/hotel_or_hisvilla/villa/1/0 room.jpg"></center>'	
	
	'Next to the door, I can find a <a href="exec:gt ''mirror'',''start''">mirror</a>. The door to the bathroom is to the right, but it locked.'
	
	if phsleep > 0 and gun = 0:
		'I saw the gun in his near bed cabinet'
		act 'take his gun':
			gun = 1
			ammo += 12
			
			'<center><img <<$set_imgh>> src="mod/public_WC/escort/3 event/try to rob/1 meshoot/hisgun.jpg"></center>'
			
			'<center><img <<$set_imgh>> src="mod/public_WC/escort/3 event/try to rob/1 meshoot/hided gun.jpg"></center>'
		end
	end
	
	'I HEAR THE LOUD NOICE'
	
	act 'ignore':
		*clr & cla		
		if rand(1,3) = 1:
			!! they INVADE
			'Sudenly the man in mask and a gun enters the room - I am so scared I can''t screem, just open my mouth'
			'he approaches me and put his gun in my mouth'
			'<center><img <<$set_imgh>> src="mod/public_WC/escort/3 event/try to rob/0 start/gun_mouth ('+rand(1,2)+').jpg"></center>'
