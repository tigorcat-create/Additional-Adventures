	if VaniaMayster >= 120:
		'<i>Vania is my master and I very miss him!</i>'
		pcs_mood -= rand(50,70)
		gs 'stat'
		VaniaMayster -= rand(5,15)
	elseif VaniaMayster >= 100 and VaniaMayster < 120:
		'<i>Vania is my master and I very miss him!</i>'
		pcs_mood -= rand(50,70)
		gs 'stat'
		VaniaMayster -= rand(3,5)
	elseif VaniaMayster >= 80 and VaniaMayster < 100:
		'<i>I feel lonely without Vania</i>'
		pcs_mood -= rand(30,50)
		gs 'stat'
		VaniaMayster -= rand(1,3)
	elseif VaniaMayster >= 60 and VaniaMayster < 80:
		'<i>I feel lonely without Vania</i>'
		pcs_mood -= rand(30,50)
		gs 'stat'
		VaniaMayster -= rand(1,3)
	elseif VaniaMayster >= 40 and VaniaMayster < 60:
		'<i>I feel lonely without Vania</i>'
		pcs_mood -= rand(30,50)
		gs 'stat'
		VaniaMayster -= rand(1,3)
	elseif VaniaMayster >= 20 and VaniaMayster < 40:
		'<i>I almost forgot Vanina''s torture</i>'
		VaniaMayster -= rand(0,1)
	elseif VaniaMayster < 20:
		'<i>I almost forgot Vanina''s torture</i>'
		VaniaMayster -= rand(0,1)
	end
	if VaniaMayster <= 1: VaniaMayster = 1
end

