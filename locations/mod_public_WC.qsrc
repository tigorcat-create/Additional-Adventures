if $curloc = 'komp' and menu_off = 0:
	if phescort = 1 and phescorttask = 0:
		act 'Go to PleasureHouse.com':
			cla
			if phmoneypaid > 0: 'The <<phmoneypaid>> money will be transferd to your banc account soon'

			if PHsetup = 1:
				gs 'mod_public_WC_rab_work_PHescort_PC', 'test'
			else
				'I see an empty profile'
				'I need to fill all the "MUST" fields'
				'All the general lines: age, weight, breast size etc I have filled… Now I need to choose 3 or more interests'
				act 'continue':
					gs 'mod_public_WC_rab_work_PHescort_PC', 'test'
				end
			end
		end
	elseif phescort = 1 and phescorttask = 1:
		act 'Go to PleasureHouse.com':
			if phmoneypaid > 0: 'The <<phmoneypaid>> money will be transferd to your banc account soon'
			'My rank is <<phecrortrank1>>.<<phecrortrank2>>'

			'<font color=red size=6>You need to focus on your current client!</font>'

			'As I logged in, the red letters is my only option on the screen'
		end
	end
end



