					gs 'arousal_funcs', 'stretch', 'vaginal', 1
					if vgape <3:vgape += 1
					pcs_horny -= RAND(10,20)
					gs 'stat'

					act 'continue': gt $loc, $loc_arg
					exit
				elseif pcs_vag >= 15 and pcs_vag < 25:
					gs 'arousal_funcs', 'stretch', 'vaginal', 1
					gs 'boyStat', 'A220'
					gs 'cum_call', 'vagina', 'A220', 0, '', '', rand(20,50)
					gs 'stat'

					gs 'arousal', 'vaginal', 10, 'sub', 'beast'
					gs 'arousal', 'end'
					gs 'stat'
					act 'continue': gt $loc, $loc_arg
					exit
				elseif pcs_vag >= 25 and pcs_vag < 35:
					gs 'boyStat', 'A800'
					gs 'cum_call', 'vagina', 'A800', 0, '', '', rand(20,300)
					gs 'stat'

					gs 'arousal', 'vaginal', 20, 'rough', 'beast'
					gs 'arousal', 'end'
					gs 'stat'
					act 'continue': gt $loc, $loc_arg
					exit
				elseif pcs_vag >= 35:
					gs 'boyStat', 'A220'
					gs 'cum_call', 'vagina', 'A220', 0, '', '', rand(20,300)
					gs 'stat'

					gs 'arousal', 'vaginal', 20, 'rough', 'beast'
					gs 'arousal', 'end'
					gs 'stat'
					act 'continue': gt $loc, $loc_arg
					exit
				end
			end
		end
	end
end




if $ARGS[0] = 'beast':
	menu_off = 0
	$location_type = 'secluded'
	*clr & cla
	if onvelyk = 1:
		'Something… some Beast grabs the bike and I jump out of it in the last moment!!!'
		'I start to run from it!!!'
	else
		'I saw Something… some Beast! I start to run from it!!!'
	end
	coord_v_x = coord_x
	coord_v_y = coord_y

	minut += rand (5,15)
	gs 'stat'
	'<center><video autoplay loop <<$set_imgh>> src="mod/public_WC/lisrab/tryrun/RUNRUN3.mp4"></video></center>'
	'Beast runs after me! I am not shure if I can run from it!'

	act 'climb a tree':
		cla
		'<center><video autoplay loop <<$set_imgh>> src="mod/public_WC/lisrab/kara/7/beast/derevo.mp4"></video></center>'
		'I tried to climb a tree, but it appears to hard for me… And I hanging on a branch…'
		act 'Try to find something with my feet to push myself':
			*clr & cla
			'I feel something hard with my feet and try to use it as a support for climbing…'
			wait 1500
			'<center><video autoplay loop <<$set_imgh>> src="mod/public_WC/lisrab/kara/7/beast/derevo_fin.mp4"></video></center>'
			'I Hear beast''s moaning. Look down… The beast lie on the ground'
			gs 'arousal', 'footjob', 5, 'beast', 'feet', 'unknown'
			stat['footjob'] += 1

			gs 'npcgeneratec', 0, 'le beast', 113
			gs 'boyStat', $npclastgenerated

			gs 'cum_call', 'legs', $npclastgenerated, 0
			gs 'stat'
			gs 'arousal', 'end'
			gs 'stat'
			if coord_x <= 0:
				act 'Jump and run!': b_big = 3 & gt 'mod_public_WC_rab_Mayster7', 'run'
			else
				coord_x -= rand(1,3)
				coord_y -= rand(0,2)
				act 'Jump and run!': gt $loc, $loc_arg
			end
		end
	end

	act 'continue running':
		if pcs_agil >= 90 or pcs_run >= 70:
			*clr & cla
			'I have run away'
			minut += 15
			gs 'sweat', 'add', 15
			gs 'stat'
			'I ran away!'
			act 'take a breath':
				coord_x -= rand(1,3)
				coord_y -= rand(0,2)
				gt $loc, $loc_arg
			end
		else
			*clr & cla
			'Beast caught me and knocked me down! It growls and rub his dick over my tits… It''s beter to help him'
			'<center><video autoplay loop <<$set_imgh>> src="mod/public_WC/lisrab/kara/7/beast/titjob.mp4"></video></center>'
			gs 'arousal', 'titjob', 20, 'beast', 'rape', 'rough'

			gs 'npcgeneratec', 0, 'le beast', 113
			gs 'boyStat', $npclastgenerated

			gs 'cum_call', 'hands', $npclastgenerated, 0

			gs 'cum_call', 'stomach', $npclastgenerated, 0

			gs 'cum_call', 'breasts', $npclastgenerated, 0
			gs 'arousal', 'end'
			gs 'stat'
			'The beast cums all over my body, and lie down with pleasure on muzzle.'
			if pcs_sleep <= 20:
				act 'go to sleep with beast':
					*clr & cla
					wait 500
					temp = rand(45,120)
					minut += temp
					if temp > 60:
						pcs_sleep += 20
					else
						pcs_sleep += 8
					end
					'I wake up, beast is still sleeping.'
					act 'run away':
						if coord_x <= 0:
							b_big = 3 & gt 'mod_public_WC_rab_Mayster7', 'run'
						else
							coord_x -= rand(1,3)
							coord_y -= rand(0,2)
							gt $loc, $loc_arg
						end
					end

					act 'go to sleep with beast':
						*clr & cla
						*nl
						'…Zzz…'
						wait 500
						temp = rand(45,120)
						minut += temp
						if temp > 60:
							pcs_sleep += 20
						else
							pcs_sleep += 8
						end
						if hour >= endhour:
							*clr & cla
							temp = rand(1,3)
							'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/kara/7/go/trip<<temp>>.jpg"></center>'
							'I woke up because Rednecks tide me up, there is no beast around…'
							*nl
							'They put bag on my had and we starts to go somewhere (home, I suppose).'
							act 'continue': b_big = 4 & gt 'mod_public_WC_rab_Mayster7', 'run'
						else
							*clr & cla
							'I wake up, because some maniak catchs and  carries me somewhere.'
							'<center><video autoplay loop <<$set_imgh>> src="mod/public_WC/lisrab/kara/7/maniakd/unis.mp4"></video></center>'
							if hour <= 5 or hour >= 22:
								act 'continue': b_big = 5 & gt 'mod_public_WC_rab_Mayster7', 'run'
							else
								act 'continue': b_big = 6 & gt 'mod_public_WC_rab_Mayster7', 'run'
							end
						end
					end
				end
			end
			act 'run away':
				if coord_x <= 0:
					b_big = 3 & gt 'mod_public_WC_rab_Mayster7', 'run'
				else
					coord_x -= rand(1,3)
					coord_y -= rand(0,2)
					gt $loc, $loc_arg
				end
			end
		end
	end
end
