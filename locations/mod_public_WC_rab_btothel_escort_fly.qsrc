						end
					end

					gs 'exp_gain', 'shoot', 1

					act 'continue': gt 'mod_public_WC_rab_btothel_escort_fly', 'sterngun2'
				end
			elseif will_cost > pcs_willpwr:
				act 'Shoot at the pirate ' + $func('wrap', 'v_neg', '(<<temp>> Willpower)'): $func('wrap', 'neg', '<br>I don''t have enough willpower to use this action.')
