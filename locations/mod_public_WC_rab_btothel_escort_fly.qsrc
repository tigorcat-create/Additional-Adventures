if $ARGS[0] = 'defend':
	'He gives me a key - "Listen to me. Listen very carefully. This key unlocks box with a gun. The box is under the sink in the cabin."'
	'"Take the gun. Lock the door. If I will not handle this. You better kill all of them."'

	'"They are too close, we have no chances to escape."'

	clientwinchance = rand(80,100)
	clientlooschance = rand(5,20)


	act 'go to the cabin for the gun':
		*clr & cla
		minut += 10
		observ_exp += 3
		gs 'stat'
		'<center><img <<$set_imgh>> src="mod/public_WC/escort/2 place/2 yacht/yacht/kayuta/inkayuta.jpg"></center>'

		temp = rand(0,100)
		if temp <= clientlooschance:
			!! clientloose
			'I hear nothing, there are silens and the sea noice… It is bad'
			'the hatch opens "Girl! - we know you are here. Come up and you will be live!" - Guy with a very strong accent commands'
			clientlooschance = 1000
			killvar 'clientwinchance'

			if gun = 1 and ammo > 0:
				act 'fight with them': gt 'mod_public_WC_rab_btothel_escort_fly', 'piratfisght'
			else
				act 'surrender': gt 'mod_public_WC_rab_btothel_escort_fly', 'surrender'
			end
		elseif temp >= clientwinchance:
			!! clientwin
			'The <<$phclientname>> enter the cabin… he is very tired… "Woow, the end. I have killed all of them"'
			'"You are my hero" - I kissed him well'
			'"I need to rest a bit"'

			clientsleep = 1
			phboatmove = 0

			act 'Okey, I take on the responsibilities':
				cla
				'I said it with the most serious voice'
				'We look on each other for a moment, then laught'
				act 'continue': gt 'mod_public_WC_rab_btothel_escort_fly', 'yacht'
			end
		else
			temp = rand (1,100) + ( pcs_observ / 2 )

			if temp >= 80 and gun ! 1:
				'YES! I have found a GUN!'
				gun = 1
			elseif temp >= 80 and gun = 1:
				'YES! I have found the ammo!'
				ammo += rand(6,20)
			else
				'I have found nothing'
			end

			act 'keep searching': gt 'mod_public_WC_rab_btothel_escort_fly', 'search'
		end
	end

	if gun = 1:
		act 'Prepare my gun':
			*clr & cla
			'"Wow! Can you shoot?"'
			act 'No':
				*clr & cla
				'Well, than just shoot in everyone EXCEPt… E-X-C-E-P-T me.'
				act 'let''s fight together': gt 'mod_public_WC_rab_btothel_escort_fly', 'piratfisght'
			end

			act 'Yes':
				*clr & cla
				'"Very good. let''s fight together!"'
				phescortfunNEED += 2
				act 'let''s fight together': gt 'mod_public_WC_rab_btothel_escort_fly', 'piratfisght'
			end
		end
	end
end

