if $ARGS[0] = 'vhid1':
	*clr & cla
	urape = 0
	ubomj = 0
	ubomj2 = 0
	$loc = 'vhid1'
	$loc = 'mod_public_WC_citybasement'
	$loc_arg = $ARGS[0]
	bumevent = 0
	trahobomj = 0
	minut += rand(5,7)
	$location_type = 'secluded'
	gs 'stat'
	$func('wrap', 'header center b', 'City center basement entrence')
	'<center><img <<$set_imgh>> src="mod/public_WC/wc/events/90/101gopotamista/pidval/vhid/1centr.jpg"></center>'
	if vhid1 ! 100:
		pr = 1201
		'The door is closed'
		act 'go away': gt 'city_center'
		act 'I''ll try to break the lock ':
			cla
			if mc_inventory['kirbygrips'] <=0:
				cla
				'I need some clips to do that'
				act 'continue': gt 'mod_public_WC_citybasement_enter', 'vhid1'
				act 'go away': gt 'city_center'
			else
				'I''ll try to do it with my clip'
				hpingrip -= 1
				mc_inventory['kirbygrips']-=1
			
				minut += rand(1, 30)
				pcs_hndiwrk += rand(0,1)
				gs 'stat'
				wait 800
				if pcs_hndiwrk >= rand(10,100):
					*clr & cla
					vhid1 = 100
					'Yes! I Did it!'
					pcs_mood += rand(10,30)
					gs 'stat'
					'<center><img <<$set_imgh>> src="mod/public_WC/wc/events/90/101gopotamista/pidval/vhid/shody (1).jpg"></center>'
					act 'enter the basement': urape += -50 & ubomj += 15 & ubomj2 =120 & gt 'mod_public_WC_citybasement', '120'
					act 'go away': gt 'city_center'
				else
					'I am failed'
					act 'continue': gt 'mod_public_WC_citybasement_enter', 'vhid1'
					act 'go away': gt 'city_center'
				end
			end
		end		
	elseif vhid1 = 100:
		pr = 1201
		act 'go away': gt 'city_center'
		act 'open the door': 
			*clr & cla
			'<center><img <<$set_imgh>> src="mod/public_WC/wc/events/90/101gopotamista/pidval/vhid/shody (1).jpg"></center>'			
			act 'enter the basement': urape += -50 & ubomj += 15 & ubomj2 =120 & gt 'mod_public_WC_citybasement', '120'
			act 'go away': gt 'city_center'
		end		
	end
end

if npc_loyality >=  70  and npc_loyality < 1000:  gt 'mod_public_WC_PH_blackcat_daily_4'

