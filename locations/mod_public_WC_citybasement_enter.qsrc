if $ARGS[0] = 'vhid0':
	*clr & cla	
	$loc = 'vhid0'
	$loc_arg = $ARGS[0]
	bumevent = 0
	urape = 0
	ubomj = 0
	ubomj2 = 0
	atemp = 1
	trahobomj = 0	
	if ztemp = 1:
		$location_type = 'secluded'
		$func('wrap', 'header center b', 'City center basement entrence')
		'<center><img <<$set_imgh>> src="mod/public_WC/wc/events/90/101gopotamista/pidval/vhid/1centr.jpg"></center>'
		if vhid1 = 1 or vhid1 = 100:
			''
		elseif vhid1 = 0:
			vhid1 = 2
			'A basement?'
		elseif vhid1 >= 2 and vhid1 < 10:
			vhid1 += 1
			if vhid1 = 10: vhid1 = 1
			'I know where I am'
		end
		act 'go in basement with bums':
			ubomj2 = 2
