				$loc_arg = '121'
				
			elseif temp = 4:
				pr = 133
				$loc = 'mod_public_WC_citybasement'
				$loc_arg = '133'
				
			end	
			ztemp = 1
			gt 'mod_public_WC_citybasement_bumsex', 'bomj2drink'
