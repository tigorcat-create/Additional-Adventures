	pr = 109
	gs 'stat'
	$location_type = 'secluded'
	$func('wrap', 'header center b', 'Undercity tunnels entrence')
	'<center><img <<$set_imgh>> src="mod/public_WC/wc/events/90/101gopotamista/pidval/vhid/5park.jpg"></center>'

	act 'go away': gt 'city_park', 'start'
	act 'enter the tunnel': 
		minut += 5
		gs 'sweat', 'add', rand(0,30)
		gs 'stat'
		urape += 33 & ubomj += -20 & ubomj2 =0 & gt 'mod_public_WC_citybasement', '109'
	end
end



