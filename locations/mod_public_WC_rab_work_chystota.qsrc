				'account balance is 250000'
				bglass = 250000
			elseif temp <=15:
				'account balance is 10000'
				bglass = 10000
			elseif temp <=40:
				'account balance is 5000'
				bglass = 5000
			else
				'There is debt on the bank account'
			end
			if temp <= 40 and bankAccount = 1:
				act 'Transfer money to your card':
					*clr & cla
					temp = rand(1,10)
					if temp = 1:
						'The money was transferred.'
						money += bglass
						mood += bglass/1000
						act 'get away from the computer': gs 'stat' & gt 'mod_public_WC_rab_work_chystota', 'office'
					elseif temp <=5:
						'The program blocks transfers to unfamiliar cards.'
						act 'Hack':
							*clr & cla
