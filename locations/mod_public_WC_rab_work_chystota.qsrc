			gt 'mod_public_WC_rab_work_chystota', 'RP'
		end
	end
	if ( pcs_intel >= rand(50,70) or pcs_compskl >= rand(40,60) or pcs_comphckng >= rand(20,35) ) and rand(1,10) = 1:
		*nl
		'I see an open bank website with a logged-in account'
		act 'Pretend I''m cleaning up at the computer and take a closer look':
			*clr & cla
			minut += 3
			temp = rand(1,100)
