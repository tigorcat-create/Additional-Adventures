	gs 'stat'
	*clr & cla
	$func('wrap', 'header center b', '"Tables"')
	'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/work/serving/tables.jpg"></center>'


	act 'go to other room':
		cla
		if bcil > 0: act 'Go to the hotel': minut += 4 & gt 'mod_public_WC_rab_work_chystota', 'hotel'
		act'Go to the Toha': minut += 1 & gt 'mod_public_WC_rab_work_chystota', 'Toha'
