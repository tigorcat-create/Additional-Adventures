# mod_public_WC_rab_work_chystota
if $ARGS[0] = 'start':
	$loc_arg = $ARGS[0]
	$location_type = 'indoors'
	$loc = 'mod_public_WC_rab_work_chystota'
	$metka = 'start'
	$menu_loc = 'mod_public_WC_rab_work_chystota'
	$menu_arg = 'start'
	gs 'stat'
	*clr & cla
	'"Yana looked at me, "Fine, now you''re ready.'

	'<center><img <<$set_imgh>> src="images/locations/pavlovsk/hotel/maid.cloth'+rand(0,5)+'.jpg"></center>'

	'Go to the bar, Toha will explain everything to you.'

	act 'Go to the bar':
		*clr & cla
		'I went to the bar, a handsome young boy immediately began to command'
		'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/work/serving/TOHA.jpg"></center>'
		if vladajob13 = 1 and vladajob11 = 1:
			'Hi, Yana said you''re new to Betsy. Your task is to walk around the club and clean where it is dirty. At least once every two hours, come here to the counter and check if I have any special instructions. At 9 o''clock your shift ends, you will come to me. '
			vladajob13 = 0
		elseif vladajob11 = 0 and vladajob13 = 1:
			'Hello, Betsy. Your task is to walk around the club and clean where it is dirty. At least once every two hours, come here to the counter and check if I have any special instructions. At 9 o''clock your shift ends, you will come to me. '
			vladajob13 = 0
		else
			'Hi Betsy, let''s get to work soon. At 9 o''clock your shift ends. '
		end

		bcilg = 0
		bhour = hour + 2
		bminut = minut
		if bhour >= 24: bhour -= 24
		bcil = 0

		act'Continue talk with Toha': minut += 3 & gt 'mod_public_WC_rab_work_chystota', 'Toha'
		act'Go to the tables': minut += 1 & gt 'mod_public_WC_rab_work_chystota', 'tables'
		act'Go to billiard': minut += 5 & gt 'mod_public_WC_rab_work_chystota', 'billiard'
		act'Go to balcony': minut += 3 & gt 'mod_public_WC_rab_work_chystota', 'balcony'
		act'Go to office': minut += 8 & gt 'mod_public_WC_rab_work_chystota', 'office'
		act'Go to dancefloor': minut += 8 & gt 'mod_public_WC_rab_work_chystota', 'dancefloor'
	end
end




if $ARGS[0] = 'Toha':
	gt 'mod_public_WC_rab_work_TOHA', 'tohachystota'
end






if $ARGS[0] = 'tables':
	$loc_arg = $ARGS[0]
	$location_type = 'indoors'
	$loc = 'mod_public_WC_rab_work_chystota'
	$metka = 'tables'
	$menu_loc = 'mod_public_WC_rab_work_chystota'
