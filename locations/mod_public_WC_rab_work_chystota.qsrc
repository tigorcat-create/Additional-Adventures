								money += bglass
								mood += bglass/1000
								act 'get away from the computer': gs 'stat' & gt 'mod_public_WC_rab_work_chystota', 'office'
							else
								'I can''t Hack that'
								mood -= 10
								act 'get away from the computer': gs 'stat' & gt 'mod_public_WC_rab_work_chystota', 'office'
							end
						end
					elseif temp <=8:
						*clr & cla
						'The program requires double authentication. I can''t break this without preparation '
						mood -= 10
						if pcs_comphckng >= rand(70,90):
							'Ha, in the last hope, I did succeed!'
							'The money was transferred.'
							money += bglass
							mood += bglass/1000
						end
						act 'get away from the computer': gs 'stat' & gt 'mod_public_WC_rab_work_chystota', 'office'
					elseif temp >=9:
						*clr & cla
						if bglass = 250000:
							'I felt a blow and lost consciousness'
							over = 1
							gt 'gameover'
						else
							'I felt a blow and the man behind my ear pulled me away from the computer "What the hell!"'
							'In a weeping voice, I assure him that I just cleaned up'
							'Get out of here!'
							gs 'pain', 9, 'ears', 'pull'
							gs 'pain', 9, 'head', 'spank'
							shtraf += 10
							gs 'stat'
							act 'get away from the computer': gs 'stat' & gt 'mod_public_WC_rab_work_chystota', 'office'
						end
					end
				end
			end
			act 'get away from the computer': gs 'stat' & gt 'mod_public_WC_rab_work_chystota', 'office'
		end
	end

