if $ARGS[0] = 'wstart':
	$loc_arg = $ARGS[0]
	$location_type = 'indoors'
	$loc = 'mod_public_WC_rab_work'
	$metka = 'wstart'
	gs 'stat'
	*clr & cla
	vladajob11 = 1
	vladajob12 = 1
	vladajob13 = 1
	vladajob14 = 1
	vladajob2 = 1
	vladajob3 = 1
	vladajob4 = 1
	'I sit in the car and we go somewhere'
	'During the road Tolik explaine me something in general'
	*nl
	'My friend owns a place to meet very serious people and he needs girls who are able to take care of important guests.'
	'I bring him girls and get thanks for it… Finally you have confidence, and I think you can help us all. So now I''m taking you… Behave with dignity, do not engage in nonsense, do not dare to refuse guests.'
	'I''ll pick you up in the morning, and God forbid, they''ll complain about you.'

	PHpin = 0

	act 'continue':
		cla
		'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/Yana.jpg"></center>'
		'Very soon we arrived at the back entrance of the house somewhere in the cottage town, Tolik took me to a room where different girls were painting, dressing…'
		'- Yana, let''s meet, it''s Betsy!'
		'A 30-year-old woman of stern appearance approached us.'
		'- New, as if nothing, well Tolich, I''ll do it. Betsy let''s go…'
		if Yana ! 2: Yana = 1



		act 'Go with her': gt 'mod_public_WC_rab_work', 'start'
		act 'Tolik, I don''t want to do this':
			cla
			brak += 3
			'Tolik, changed in the face.'
			'All right, Betsy, let''s go home'
			act 'continue': gt 'mod_public_WC_rab_work', 'niroboti'
		end


		gs 'willpower', 'misc', 'self', 'easy'
		if will_cost <= pcs_willpwr:
			act 'I am not Betsi.' + $func('willpower', 'get_willcost_string'):
				cla
				gs 'willpower', 'pay', 'self'
				gs 'stat'
				brak += 1
				'Tolik''s eyes filled with anger'
				'- Tolik, goodbye, I''ll figure it out.'

				act 'Go with her': gt 'mod_public_WC_rab_work', 'start'
				act 'Tolik, I don''t want to do this':
					cla
					brak += 3
					'Tolik, changed in the face.'
					'All right, Betsy, let''s go home'
					act 'continue': gt 'mod_public_WC_rab_work', 'niroboti'
				end
			end
		else
			act 'I am not Betsi' + $func('willpower', 'get_willcost_string'): $noWillpower
		end
	end
end


