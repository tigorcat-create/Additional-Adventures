	if vlada >= 30 and ryska >= 10:
		act 'Go to the guests': shloha = 1 & gt 'mod_public_WC_rab_work', 'room'
	end
	if WCzoo > 0: act 'Zootheatre': zt = 1 & gt 'mod_public_WC_rab_work', 'room'
