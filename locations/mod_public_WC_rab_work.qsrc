				temp = rand(1,2)
				'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/work/serving/napoi/bglass<<temp>>.jpg"></center>'
				elseif bglass = 1:
					'The last glass shook for a long time, but still stayed on the tray'
				else
					'I think even if the tray was full, I wouldn''t drop anything'
				end
			end
		elseif 75 - ytemp >= 0:
			'I walk on such heels uncertainly'
			'I tripped over something, but I persevered'
			if bglass > 1:
				'The glasses rattled menacingly, but nothing happened'
			elseif bglass = 1:
				'The last glass traveled a bit on the tray, but it all worked out'
			else
				'I think even if the tray was full, I wouldn''t drop anything'
			end
		else
			'I walk good on this heels'
		end
	else
		'I walk good on this heels'
	end
end












if $ARGS[0] = 'chystota':
	gt 'mod_public_WC_rab_work_chystota', 'start'


end

