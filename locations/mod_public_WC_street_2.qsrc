if $ARGS[0] = 'kuhnia':
	*clr & cla
	!! Snoh street
	$loc = 'mod_public_WC_street'
	$menu_loc = 'mod_public_WC_street_2'
	$loc_arg = 'kuhnia'
	$menu_arg = 'kuhnia'
	$loc = 'mod_public_WC_street_2'
	menu_off = 0
	$location_type = 'indoors'
	CLOSE ALL
	
	
	'<center><h2>Snokhachestvo street, 3a, kitchen</h2></center>'

	'<center><img <<$set_imgh>> src="mod/public_WC/newstreet/1 street/building/kuhnia.jpg"></center>'
	
	act '<b>Go to the public corridor</b>':
		gt 'mod_public_WC_street_2', 'korydor'
	end
	
	if PHBarack >= 1:
		act '<b>Go to my room #7</b>':
			minut += 2
			gs 'stat'
			gt 'mod_public_WC_street_2', 'myroom'
		end	
	end
	
	
	food_loc = 0
	minut += 1
	gs 'kit_din'
	gs 'stat'	
	
	if mc_inventory['food_basic'] > 0:
		if edahot = 0:
			$edagot = '<a href="exec:dynamic $edagotd">Cook a meal</a>'
		else
			$edagot = ''
		end
		'Your shelf in the refrigerator holds enough food for <b><<mc_inventory[''food_basic'']>></b> ' + iif(mc_inventory['food_basic'] = 1, 'serving', 'servings') + '. <<$edagot>>'
	else
		$func('wrap', 'v_neg b', 'Your shelf in the refrigerator is bare. There is nothing left for you to eat.')
	end

	if edahot > 0:'<a href="exec:dynamic $edahotd">There''s a warm meal on the table.</a>'

	dynamic $edasnack
	dynamic $sandwich
	dynamic $driwater
	dynamic $dritea
	dynamic $fill_bottle
	dynamic $edaD
	dynamic $pranik
	dynamic $fatdel
	dynamic $lekarstvo
	dynamic $vitamin
end


if $ARGS[0] = 'boxbuy':
	!! buy
	cla	
	money -= 25000
	
	minut += 3
	gs 'stat'
	
	'I paid 25000 to Grisha, signed some document… now I am the proud owner ow the box?'
	'GRISHA: "Where you want to install it?"'
	
	act 'Five Eight Estate':
		cla
		phBOX += 1
		phBOXFiveEightEstate += 1
		!! pav_complex
		'GRISHA: "Nice to make bussiness with you, lets go"'
		
		$phtemp = 'pav_complex'
		
		act 'Go with him':
			gt 'mod_public_WC_street_2', 'boxinstall'
		end
	end
	
	act 'The Pavlovsk residential area':
		cla
		phBOX += 1
		phBOXresidential += 1
		!! pav_residental
		
		$phtemp = 'pav_residental'
		
		act 'Go with him':
			gt 'mod_public_WC_street_2', 'boxinstall'
		end		
	end
	
	act 'Commercial hub of Pavlovsk':
		cla
		phBOX += 1
		phBOXCommercial += 1
		!! pav_commercial		
		
		$phtemp = 'pav_commercial'
		
		act 'Go with him':
			gt 'mod_public_WC_street_2', 'boxinstall'
		end		
	end		
	act 'Pavlovsk park':
		cla
		phBOX += 1
		phBOXpark += 1
		!! pav_park
		
		$phtemp = 'pav_park'
		
		act 'Go with him':
			gt 'mod_public_WC_street_2', 'boxinstall'
		end		
	end	
	act 'Pavlovsk Industrial District':
		cla
		phBOX += 1
		phBOXIndustrial += 1
		!! pav_industrial		
		
		$phtemp = 'pav_industrial'
		
		act 'Go with him':
			gt 'mod_public_WC_street_2', 'boxinstall'
		end		
	end	
	act 'Snokhachestvo street':
		cla
		phBOX += 1
		phBOXsnoh += 1
		!! mod_public_WC_street			
		
		$phtemp = 'mod_public_WC_street'
		
		act 'Go with him':
			gt 'mod_public_WC_street_2', 'boxinstall'
		end		
	end		
end


if $ARGS[0] = 'boxinstall':
	*clr & cla
	'Grisha called someone and soon we are on the place, watching my box is installing'
	'<center><img <<$set_imgh>> src="mod/public_WC/newstreet/1 street/box/00 MONTAJ.jpg"></center>'
	'Grisha give me few other documents: "See you" - and go away'
	
	if $phtemp = 'pav_complex':
		$loc = 'pav_complex'
		act 'continue': gt $loc
	elseif $phtemp = 'pav_residental':
		$loc = 'pav_residential'
		act 'continue': gt $loc
	elseif $phtemp = 'pav_commercial':
		$loc = 'pav_commercial'
		act 'continue': gt $loc
	elseif $phtemp = 'pav_park':
		$loc = 'pav_park'
		act 'continue': gt $loc
	elseif $phtemp = 'pav_industrial'
		$loc = 'pav_industrial'
		act 'continue': gt $loc
	elseif $phtemp = 'mod_public_WC_street'
		act 'continue': gt 'mod_public_WC_street', 'start'
	end
	
	killvar 'phtemp'
end























--- mod_public_WC_street_2 ---------------------------------

