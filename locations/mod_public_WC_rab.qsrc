if $ARGS[0] = 'campfire':
	CLOSE ALL
	$loc = 'mod_public_WC_rab'
	$metka = 'campfire'
	$menu_loc = 'mod_public_WC_rab'
	$menu_arg = 'campfire'
	$loc_arg = $ARGS[0]
	*clr & cla
	gs 'stat'
	menu_off = 0
	act 'Move away': gt 'mod_public_WC_rab', 'dvir'

	gs 'mod_public_WC_rab_Vania', 'start'
	if Vania = 1:
		act 'Talk with Vania': gt 'mod_public_WC_rab_talk', 'Vania'
	end

	gs 'mod_public_WC_rab_Artem', 'start'
	if Artem = 1:
		act 'Talk with Artem': gt 'mod_public_WC_rab_talk', 'Artem'
	end

	gs 'mod_public_WC_rab_Tolik', 'start'
	if Tolik = 1:
		act 'Talk with Tolik': gt 'mod_public_WC_rab_talk', 'Tolik'
	end

	if campfire = 1:
		if hour >= 8 and hour < 20:
			'<center><img <<$set_imgh>> src="images/locations/gadukino/hunters/campfire_day.jpg"></center>'
		else
			'<center><img <<$set_imgh>> src="images/locations/gadukino/hunters/campfire_night.jpg"></center>'
		end
		*nl
		'A nice, warm campfire you can sit and relax by. You can use it to cook something or heat up some water to bathe.'
		'You can also put it out with the bucket if there is enough water in it'
	else
		if hour >= 8 and hour < 20:
			'<center><img <<$set_imgh>> src="images/locations/gadukino/hunters/campfire_out_day.jpg"></center>'
		else
			'<center><img <<$set_imgh>> src="images/locations/gadukino/hunters/campfire_out_night.jpg"></center>'
		end
		*nl
		'You can use this firepit to light a fire, if you have some firewood available.'
	end
	if campfire = 1:
		if bucket >= 3:
			act 'Put out the fire':
				cla & *clr
				'<center><img <<$set_imgh>> src="images/locations/gadukino/hunters/campfire_put_out.jpg"></center>'
				*nl
				'You pour some water to extinguish the campfire'

				campfire = 0
				minut += 5
				bucket -= 3

				act 'Further': gt 'mod_public_WC_rab', 'campfire'

			end
		end

		if bucket > 0 and boletus > 0 and mushroom_soup = 0:
			act 'Cook some mushroom soup (0:30)':
				if pcs_servng < 100:servng_exp += rand (0,1)
				if task3 = 1: task3 = 2
				gs 'hunter_favors', 'mushroom_soup'
			end
		end

		if bucket > 0 and raw_meat > 0 and meat_stew = 0:
			act 'Cook some meat stew (1:00)':
				if pcs_servng < 100:servng_exp += rand (0,1)
				if task3 = 1: task3 = 2
				gs 'hunter_favors', 'meat_stew'
			end
		end

		if bucket >= 5 and hotwater = 0:
			act 'Heat up water (0:30)':
				cla
				*clr
				minut += 30
				bucket -= 5
				hotwater = 1

				water_heated += 1
				gs 'stat'

				'<center><img <<$set_imgh>> src="images/locations/gadukino/hunters/hotwater.jpg"></center>'
				*nl

				if water_heated > 5 and inhibition < 85:
					'"It is too tedious to keep heatiing up water", you think to yourself.'
				else
					'With the now heated water, you can bathe yourself in a tub. <i>I hear from the guys something about the tub on the second floor bathroom.</i>'
				end

				act 'Continue': gt 'mod_public_WC_rab', 'campfire'
			end
		end

		act 'Eat a meal':
			cla
			act 'Return': gt 'mod_public_WC_rab', 'campfire'
			act 'Eat jerky and trail mix':gt 'food', 'jerky'
			if meat_stew > 0:
				act 'Eat meat stew':
					gs 'food', 'meat_stew'
					meat_stew -= 1
					*nl
					if meat_stew > 0:
						'There''s <<meat_stew>> '+iif(meat_stew > 1, 'servings','serving')+' of stew left in the pot'
					else
						'You have finished the last of the stew, the pot is empty.'
					end
				end
			end
			if mushroom_soup > 0:
				act 'Eat mushroom soup':
					gs 'food', 'mush_soup'
					mushroom_soup -= 1
					if mushroom_soup > 0:
						'There''s <<mushroom_soup>> '+iif(mushroom_soup > 1, 'servings','serving')+' of soup left in the pot'
					else
						'You have finished the last of the soup, the pot is empty.'
					end
					gs 'stat'
				end
			end
			if bilberry > 0:
				act 'Eat berries':gt 'food','bilberry'
			end
		end

	else
		if firewood >= 10 and campfire = 0:
			act 'Light fire':
				cla & *clr

				if $clothingworntype ! 'nude':
					'<center><img <<$set_imgh>> src="images/locations/gadukino/hunters/campfire_light.jpg"></center>'
				else
					'<center><img <<$set_imgh>> src="images/locations/gadukino/hunters/campfire_light_nude.jpg"></center>'
				end

				'You use some chopped wood, dry branches and twigs to light a campfire in the firepit'

				firewood -= 10
				campfire = 1
				minut += 15

				act 'Further': gt 'mod_public_WC_rab', 'campfire'
			end
		elseif firewood < 10 and campfire = 0:
			*nl
			'There is some wood and twigs by the pit but not enough to light a new fire. You will probably need to collect some branches, chop some or ask guys.'
		end
	end
end

if $ARGS[0] = 'lisnyk':
	CLOSE ALL
	$loc = 'mod_public_WC_rab'
	$metka = 'lisnyk'
	$menu_loc = 'mod_public_WC_rab'
	$menu_arg = 'lisnyk'
	$location_type = 'secluded'
	$loc_arg = $ARGS[0]
	*clr & cla
	menu_off = 0


	gs 'mod_public_WC_rab_Vania', 'start'
	if Vania = 1:
		act 'Talk with Vania': gt 'mod_public_WC_rab_talk', 'Vania'
	end

	gs 'mod_public_WC_rab_Artem', 'start'
	if Artem = 1:
		act 'Talk with Artem': gt 'mod_public_WC_rab_talk', 'Artem'
	end

	gs 'mod_public_WC_rab_Tolik', 'start'
	if Tolik = 1:
		act 'Talk with Tolik': gt 'mod_public_WC_rab_talk', 'Tolik'
	end

	if $clothingworntype = 'nude':
		If Tolik = 1:
			gt 'mod_public_WC_rab_zashmorg', 'gola'
		elseif Vania = 1:
			gt 'mod_public_WC_rab_zashmorg', 'gola'
		elseif Artem = 1:
			if Alove >= 20:
				*nl
				'Nice, Betsi. I like what I see'
				temp = rand (1, 10)
				if temp = 1: Alove += 1
			else
				gt 'mod_public_WC_rab_zashmorg', 'gola'
			end
		end
	end

	gs 'stat'
	$func('wrap', 'header center b', 'A lodge like a forester')
	'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/HATA/lisnuk.jpg"></center>'
	if cumgame = 0: lisnykstakan = 0

	if cumgame = 1:
		if lisnykstakan = 1: 'Here I already took the glass'
		if lisnykstakan = 0:
			if cumstakan > 0:
				lisnykstakan = 2
				cumstakan -= 1
			else
				'There is no cum glass here'
			end
		end
	end
	if lisnykstakan = 2:
		'<b>Somewhere here must be a cum glass.</b>'
		if pcs_intel >= rand(50,80) + brak or pcs_prcptn >= rand(40,70) + brak or pcs_observ >= rand(30,60) + brak or rand(1,100) <= 15:
			'I see a glass full with cum!'
			lisnykstakan = 3
			act 'Drink it and take empty glass':
				*clr & cla
				lisnykstakan = 1
				emptyglass += 1
				findglass += 1
				temp = rand(1,3)
				'<center><video autoplay loop <<$set_imgh>> src="mod/public_WC/lisrab/kara/1/drink<<temp>>.mp4"></video></center>'
				gs 'cum_call', 'mouth', 'redneck'
				gs 'stat'
				gs 'arousal', 'end'
				gs 'stat'
				temp = cumwin - findglass
				'I have yet to find <<temp>> glasses'
				act 'Continue': gt $loc, $loc_arg, $metka
			end
			act 'Don''t Drink it': gt $loc, $loc_arg
		end
		act 'Play cumgame':
			minut += rand(10,20)
			if pcs_intel >= rand(50,80) + brak or pcs_prcptn >= rand(40,70) + brak or pcs_observ >= rand(30,60) + brak or rand(1,100) <= 15:
				'I see a glass full with cum!'
				lisnykstakan = 3
				act 'Drink it and take empty glass':
					*clr & cla
					lisnykstakan = 1
					emptyglass += 1
					findglass += 1
					temp = rand(1,3)
					'<center><video autoplay loop <<$set_imgh>> src="mod/public_WC/lisrab/kara/1/drink<<temp>>.mp4"></video></center>'
					gs 'cum_call', 'mouth', 'redneck'
					gs 'stat'
					gs 'arousal', 'end'
					gs 'stat'
					temp = cumwin - findglass
					'I have yet to find <<temp>> glasses'
					act 'Continue': gt $loc, $loc_arg
				end
				act 'Don''t Drink it': gt $loc, $loc_arg
			else
				'I think the glass should be here somewhere!'
				gs 'stat'
			end
		end
	end
	if lisnykstakan = 3:
		act 'Drink it and take empty glass':
			*clr & cla
			lisnykstakan = 1
			emptyglass += 1
			findglass += 1
			temp = rand(1,3)
			'<center><video autoplay loop <<$set_imgh>> src="mod/public_WC/lisrab/kara/1/drink<<temp>>.mp4"></video></center>'
			gs 'cum_call', 'mouth', 'redneck'
			gs 'stat'
			gs 'arousal', 'end'
			gs 'stat'
			temp = cumwin - findglass
			'I have yet to find <<temp>> glasses'
			act 'Continue': gt $loc, $loc_arg
		end
	end

	act '<b>Enter the lodge</b>':
		minut += 1
		gt 'mod_public_WC_rab', 'lisnyk_dim'
	end
	act '<b>Come closer to the house</b>':
		minut += 1
		gt 'mod_public_WC_rab', 'dvir'
	end

	act 'Come to the fire':
		minut += 1
		gt 'mod_public_WC_rab', 'campfire'
	end
	if Artem ! 2 and Tolik ! 2 and Vania ! 2:
		act 'Try to escape!': gt 'mod_public_WC_rab_tryrun', 'start'
	end
	act 'Get water from the well':
		minut += 5
		*clr & cla
		gs 'sweat', 'add', 10
		minut += 3
		bucket += 1
		temp = rand(1,5)
		if temp = 1: pcs_stren += 1
		gs 'stat'
		'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/HATA/voda.jpg"></center>'
		act 'Continue': gt 'mod_public_WC_rab', 'lisnyk'
	end

	act 'Go to the WC':
		 minut += 1
		gt 'mod_public_WC_rab', 'wc'
	end

	if drabyna = 0:
		act 'Look around':
			if pcs_observ >= rand(20,80) and drabyna = 0:
				*clr & cla
				'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/hata/drabyna.jpg"></center>'
				minut += 20
