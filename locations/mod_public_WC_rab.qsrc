# mod_public_WC_rab
if $ARGS[0] = 'lis_start':
	CLOSE ALL
	$loc = 'mod_public_WC_rab'
	$metka = 'start'
	$menu_loc = 'mod_public_WC_rab'
	$location_type = 'secluded'
	$loc_arg = $ARGS[0]
	*clr & cla
	crime = 0
	kuhniabrud = 8
	pvshow = daystart
	WCzoo = 1
	if WCzoooff = 1: WCzoo = 0
	if newodiag ! 1: newodiag = 0
	zvit_Weekout = 0
	posud = 0
	willdec = 0
	zayzav = 0
	beast = 1
	killed = 0
	vbrak = 0
	ryba_cooked = 0
	ryba = 0
	zucchini = 0
	apple = 0
	ogirok = 0
	turok = 0
	vbike = 100
	stime = 0
	firstclean = 0
	nkolo = 0
	gun = 0
	bdsmurok = 0
	Avirgin = 1
	dvirbrud = 16
	vtecha = 0
	askTolik = 0
	zvit = week + 1
	if zvit = 8: zvit = 1
	Alove = 0
	Tlove = 0
	Vlove = 0
	bigun = 0
	nightsexvania = 0
	VaniaMayster = 0
	Vurok = 0
	brak = 0
	slova = 1
	campfire = 1
	mushroom_soup = 0
	hotwater = 0
	firewood = 12
	stovefire = 0
	drabyna = 0
	odiag = 0
	zashmorg = 0
	ammo = 0
	dc = 0
	if temp = 123456: gt 'mod_public_WC_rab', 'sama2'
	temp = money
	money -= temp
	ztemp = 0
	Aday = daystart
	task70 = 0
	Ahide = 0
	vday = 0
	gs 'boyStat', 'A441'
	gs 'stat'
	gs 'boyStat', 'A442'
	gs 'stat'
	gs 'boyStat', 'A443'
	gs 'stat'
	'They put me on my feet. And I finally looked at where I was .. somewhere deep in the woods, and the old house stood in front of me.'
	'Two young healthy guys, dirty and clearly devoid of deep intelligence, smile eagerly, looking at me.'
	'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/HATA/dim.jpg"></center>'
	act 'ask "Where am I? Who are you? What do you want from me?"':
		'We ask questions here, Betsy, and you must listen to us and our rules!'
		slova -= 1
		brak += 1
		if slova < 0: gt 'mod_public_WC_kara', '0sliv'
	end
	act 'wait':
		*clr & cla
		'<center><img <<$set_imgh>> src="mod/public_WC/lisrab/tolik/tolik.jpg"></center>'
		'Betsy. Now that''s your name. I saved you from your terrible previous life worthless whore. From today your past is forgotten forever. Now you will live with us. You will not know hunger and sorrow, but you will have to obey our laws.'
		*nl
		'You have no right to speak. You are stupid and we are not interested in your words, they will just take our time. But we know that you cannot survive without them, so we will reward you with them. You now have <<slova>> words.'
		'You have no right to refuse us anything.'
		'You have no right to move away from your home further than to a well in one direction, shiter into the other and bushes.'
		'Everyday at 21:00 you must come to Me to report your day work. I''ll wait you on the first floor of main house. Artem will be with us to learn. If you would be a good girl during day, you will have some words as a reward, otherwise you will be punished.'
		'<b>Our first meet are going to be tomorrow.</b>'
		*nl
		'Each evening I will give you a task for next day… or you can ask for task during day.'
		'I want you be sure, you must not be afraid. We need women hands here. If you manage all stuff we need, no one will hurt you, and everyone will be happy.'
		*nl
		'<b>Just for you to know: I hate lie.</b>'
		*nl
		'First, to untied you, we need to make sure you understand everything. Did you understand everything?'

		act 'They will look for me and you will regret!':
			'I understand that you do not yet know our laws, so you act like that, but this is the last warning now'
			slova -= 1
			brak += 1
			if slova < 0: gt 'mod_public_WC_kara', '0sliv'
		end
		act 'Where am I? Who are you? What do you want from me?':
			'We ask questions here, and you have to listen to us and our rules'
			slova -= 1
			brak += 1
			if slova < 0:
				gt 'mod_public_WC_kara', '0sliv'
			end
		end
		act 'Turn around and run into the woods.':
			if pcs_agil >= rand(80,100) and pcs_sprt >= rand(20,50):
				cla
				'After a while the chase noise stops and I am left alone in the unknown.'
				lostrand = 30
				act 'look around': gt 'gad_forest_lost', 'forest_center'
			else
				cla
				'As I run, I stumble upon a tree and fall to the ground. Very soon, I am being caught by rednecks.'
				'How rash, you will regret it!'
				gs 'pain', 3, 'legL', 'hit'
				gs 'stat'
				act 'Continue': gt 'mod_public_WC_kara', 'kara3'
			end
		end
		act 'Yes':
			willpowermax -= rand(0,1)
			slova -= 1
			brak += 1
			if slova < 0: gt 'mod_public_WC_kara', '0sliv'
			'I hope you understand this rule. Now let''s check another rule… after a short pause, he continued: bend over.'
			act 'Bend over':
				gt 'mod_public_WC_rab', 'first_rakom'
			end
		end
		if pcs_intel >= 60:
			act 'Nod "yes"':
				cla
				'Well done, you understand that rule. I give you one word. Now let''s check another rule… after a short pause, he continued: bend over.'
				willpowermax -= rand(0,1)
				slova += 1
				vlada += 1
				act 'Bend over':
					gt 'mod_public_WC_rab', 'first_rakom'
				end
			end
		end
	end
end




